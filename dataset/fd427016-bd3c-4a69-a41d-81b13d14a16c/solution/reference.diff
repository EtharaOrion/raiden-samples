+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+
+def get_endpoint():
+    ep = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ.get("AWS_ENDPOINT_URL")
+    if not ep:
+        ep = os.environ["AWS_ENDPOINT_URL"]
+    return ep
+
+
+def call(op, payload):
+    endpoint = get_endpoint()
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20200101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=host;x-amz-date;x-amz-target, Signature=dummy")
+    req.add_header("X-Amz-Date", "20200101T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        if body.strip():
+            return json.loads(body), None
+        return {}, None
+    except urllib.error.HTTPError as e:
+        body = e.read().decode("utf-8")
+        try:
+            parsed = json.loads(body)
+        except Exception:
+            parsed = {"__type": "UnknownError", "message": body}
+        return None, parsed
+    except Exception as e:
+        return None, {"__type": "ConnectionError", "message": str(e)}
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: " + msg + "\n")
+    sys.exit(252)
+
+
+def service_error(err):
+    typ = err.get("__type", "UnknownError")
+    code = typ.split("#")[-1]
+    msg = err.get("message") or err.get("Message") or ""
+    sys.stderr.write("An error occurred (" + code + "): " + msg + "\n")
+    sys.exit(254)
+
+
+# flag -> (field_name, kind) kind: str, json, bool, int
+FLAG_SPECS = {
+    "delete-item": {
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--key": ("Key", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "get-item": {
+        "--attributes-to-get": ("AttributesToGet", "json"),
+        "--consistent-read": ("ConsistentRead", "bool"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--key": ("Key", "json"),
+        "--projection-expression": ("ProjectionExpression", "str"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "list-tables": {
+        "--exclusive-start-table-name": ("ExclusiveStartTableName", "str"),
+        "--limit": ("Limit", "int"),
+    },
+    "put-item": {
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--item": ("Item", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "query": {
+        "--attributes-to-get": ("AttributesToGet", "json"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--consistent-read": ("ConsistentRead", "bool"),
+        "--exclusive-start-key": ("ExclusiveStartKey", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--filter-expression": ("FilterExpression", "str"),
+        "--index-name": ("IndexName", "str"),
+        "--key-condition-expression": ("KeyConditionExpression", "str"),
+        "--key-conditions": ("KeyConditions", "json"),
+        "--limit": ("Limit", "int"),
+        "--projection-expression": ("ProjectionExpression", "str"),
+        "--query-filter": ("QueryFilter", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--scan-index-forward": ("ScanIndexForward", "bool"),
+        "--select": ("Select", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+}
+
+OP_MAP = {
+    "delete-item": "DeleteItem",
+    "get-item": "GetItem",
+    "list-tables": "ListTables",
+    "put-item": "PutItem",
+    "query": "Query",
+}
+
+
+def parse_args(subcmd, args):
+    specs = FLAG_SPECS[subcmd]
+    payload = {}
+    seen = set()
+    i = 0
+    n = len(args)
+    while i < n:
+        tok = args[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: " + tok)
+        # handle --flag=value
+        if "=" in tok:
+            flag, val = tok.split("=", 1)
+            has_inline = True
+        else:
+            flag = tok
+            val = None
+            has_inline = False
+        if flag not in specs:
+            usage_error("unknown flag: " + flag)
+        if flag in seen:
+            usage_error("duplicate flag: " + flag)
+        seen.add(flag)
+        field, kind = specs[flag]
+        if kind == "bool":
+            # boolean flag; may have explicit value
+            if has_inline:
+                payload[field] = val.lower() in ("true", "1", "yes")
+            else:
+                # peek next: aws store_true takes no value
+                payload[field] = True
+            i += 1
+            continue
+        # needs a value
+        if has_inline:
+            value = val
+        else:
+            if i + 1 >= n:
+                usage_error("flag " + flag + " requires a value")
+            value = args[i + 1]
+            i += 1
+        if value == "":
+            usage_error("flag " + flag + " requires a non-empty value")
+        if kind == "str":
+            payload[field] = value
+        elif kind == "int":
+            try:
+                payload[field] = int(value)
+            except ValueError:
+                usage_error("flag " + flag + " requires an integer")
+        elif kind == "json":
+            try:
+                payload[field] = json.loads(value)
+            except Exception:
+                usage_error("flag " + flag + " requires valid JSON")
+        i += 1
+    return payload
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("missing command")
+    subcmd = argv[2]
+    if subcmd not in FLAG_SPECS:
+        usage_error("unknown command: " + subcmd)
+
+    payload = parse_args(subcmd, argv[3:])
+
+    # required-flag checks
+    if subcmd in ("delete-item", "get-item"):
+        if "TableName" not in payload:
+            usage_error("--table-name is required")
+        if "Key" not in payload:
+            usage_error("--key is required")
+    elif subcmd == "put-item":
+        if "TableName" not in payload:
+            usage_error("--table-name is required")
+        if "Item" not in payload:
+            usage_error("--item is required")
+    elif subcmd == "query":
+        if "TableName" not in payload:
+            usage_error("--table-name is required")
+
+    op = OP_MAP[subcmd]
+    result, err = call(op, payload)
+    if err is not None:
+        service_error(err)
+    sys.stdout.write(json.dumps(result, indent=4) + "\n")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
