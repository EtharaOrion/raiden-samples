+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+USAGE_EXIT = 252
+SERVICE_EXIT = 254
+
+SPECS = {
+    "delete-item": {
+        "op": "DeleteItem",
+        "flags": {
+            "condition-expression": ("ConditionExpression", "str"),
+            "conditional-operator": ("ConditionalOperator", "str"),
+            "expected": ("Expected", "json"),
+            "expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "key": ("Key", "json"),
+            "return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+            "return-values": ("ReturnValues", "str"),
+            "return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+            "table-name": ("TableName", "str"),
+        },
+    },
+    "get-item": {
+        "op": "GetItem",
+        "flags": {
+            "attributes-to-get": ("AttributesToGet", "json"),
+            "consistent-read": ("ConsistentRead", "bool"),
+            "expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "key": ("Key", "json"),
+            "projection-expression": ("ProjectionExpression", "str"),
+            "return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "table-name": ("TableName", "str"),
+        },
+    },
+    "list-tables": {
+        "op": "ListTables",
+        "flags": {
+            "exclusive-start-table-name": ("ExclusiveStartTableName", "str"),
+            "limit": ("Limit", "int"),
+        },
+    },
+    "put-item": {
+        "op": "PutItem",
+        "flags": {
+            "condition-expression": ("ConditionExpression", "str"),
+            "conditional-operator": ("ConditionalOperator", "str"),
+            "expected": ("Expected", "json"),
+            "expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "item": ("Item", "json"),
+            "return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+            "return-values": ("ReturnValues", "str"),
+            "return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+            "table-name": ("TableName", "str"),
+        },
+    },
+    "query": {
+        "op": "Query",
+        "flags": {
+            "attributes-to-get": ("AttributesToGet", "json"),
+            "conditional-operator": ("ConditionalOperator", "str"),
+            "consistent-read": ("ConsistentRead", "bool"),
+            "exclusive-start-key": ("ExclusiveStartKey", "json"),
+            "expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "filter-expression": ("FilterExpression", "str"),
+            "index-name": ("IndexName", "str"),
+            "key-condition-expression": ("KeyConditionExpression", "str"),
+            "key-conditions": ("KeyConditions", "json"),
+            "limit": ("Limit", "int"),
+            "projection-expression": ("ProjectionExpression", "str"),
+            "query-filter": ("QueryFilter", "json"),
+            "return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "scan-index-forward": ("ScanIndexForward", "bool"),
+            "select": ("Select", "str"),
+            "table-name": ("TableName", "str"),
+        },
+    },
+    "update-item": {
+        "op": "UpdateItem",
+        "flags": {
+            "attribute-updates": ("AttributeUpdates", "json"),
+            "condition-expression": ("ConditionExpression", "str"),
+            "conditional-operator": ("ConditionalOperator", "str"),
+            "expected": ("Expected", "json"),
+            "expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "key": ("Key", "json"),
+            "return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+            "return-values": ("ReturnValues", "str"),
+            "return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+            "table-name": ("TableName", "str"),
+            "update-expression": ("UpdateExpression", "str"),
+        },
+    },
+}
+
+BOOL_FLAGS = {"consistent-read"}
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: " + msg + "\n")
+    sys.exit(USAGE_EXIT)
+
+
+def parse_args(spec, args):
+    flags = spec["flags"]
+    result = {}
+    seen = set()
+    i = 0
+    n = len(args)
+    while i < n:
+        tok = args[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: " + tok)
+        name = tok[2:]
+        # allow --flag=value
+        eqval = None
+        if "=" in name:
+            name, eqval = name.split("=", 1)
+        if name not in flags:
+            usage_error("unknown option: --" + name)
+        field, kind = flags[name]
+        if name in seen:
+            usage_error("duplicate option: --" + name)
+        seen.add(name)
+        if kind == "bool" and name in BOOL_FLAGS:
+            # scan-index-forward is not a store_true really; but consistent-read is store_true style
+            if eqval is not None:
+                val = eqval.lower() in ("true", "1")
+            else:
+                val = True
+            result[field] = val
+            i += 1
+            continue
+        # value expected
+        if eqval is not None:
+            raw = eqval
+            i += 1
+        else:
+            if i + 1 >= n:
+                usage_error("--" + name + " requires a value")
+            raw = args[i + 1]
+            i += 2
+        if raw == "" and name == "table-name":
+            usage_error("--table-name value must not be empty")
+        if kind == "json":
+            try:
+                result[field] = json.loads(raw)
+            except Exception:
+                usage_error("invalid JSON for --" + name)
+        elif kind == "int":
+            try:
+                result[field] = int(raw)
+            except Exception:
+                usage_error("invalid integer for --" + name)
+        elif kind == "bool":
+            result[field] = raw.lower() in ("true", "1")
+        else:
+            result[field] = raw
+    return result
+
+
+def call(op, body):
+    endpoint = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ["AWS_ENDPOINT_URL"]
+    data = json.dumps(body).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20200101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=host;x-amz-date;x-amz-target, Signature=dummy")
+    req.add_header("X-Amz-Date", "20200101T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        raw = resp.read()
+        if raw:
+            return json.loads(raw.decode("utf-8"))
+        return {}
+    except urllib.error.HTTPError as e:
+        raw = e.read().decode("utf-8", "replace")
+        code = "UnknownError"
+        msg = raw
+        try:
+            parsed = json.loads(raw)
+            t = parsed.get("__type", "")
+            if t:
+                code = t.split("#")[-1]
+            msg = parsed.get("message", parsed.get("Message", ""))
+        except Exception:
+            pass
+        sys.stderr.write("An error occurred (" + code + "): " + str(msg) + "\n")
+        sys.exit(SERVICE_EXIT)
+    except urllib.error.URLError as e:
+        sys.stderr.write("Could not connect to the endpoint URL: " + str(e) + "\n")
+        sys.exit(SERVICE_EXIT)
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("missing subcommand")
+    subcmd = argv[2]
+    if subcmd not in SPECS:
+        usage_error("unknown subcommand: " + subcmd)
+    spec = SPECS[subcmd]
+    body = parse_args(spec, argv[3:])
+    result = call(spec["op"], body)
+    sys.stdout.write(json.dumps(result, indent=4))
+    sys.stdout.write("\n")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
