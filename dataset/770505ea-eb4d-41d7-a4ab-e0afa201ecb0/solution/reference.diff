+#!/usr/bin/env python3
+import sys
+import os
+import hashlib
+import hmac
+import datetime
+import http.client
+import urllib.parse
+import xml.etree.ElementTree as ET
+
+S3_NS = 'http://s3.amazonaws.com/doc/2006-03-01/'
+EMPTY_SHA256 = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
+
+
+class ClientError(Exception):
+    def __init__(self, code, message, status=400):
+        self.code = code
+        self.message = message
+        self.status = status
+        super().__init__(self.__str__())
+
+    def __str__(self):
+        return "An error occurred (%s) when calling the operation: %s" % (
+            self.code, self.message)
+
+
+def get_config():
+    ak = os.environ.get('AWS_ACCESS_KEY_ID', 'testing')
+    sk = os.environ.get('AWS_SECRET_ACCESS_KEY', 'testing')
+    token = os.environ.get('AWS_SESSION_TOKEN')
+    region = os.environ.get('AWS_REGION') or os.environ.get(
+        'AWS_DEFAULT_REGION') or 'us-east-1'
+    endpoint = os.environ.get('AWS_ENDPOINT_URL_S3') or os.environ.get(
+        'AWS_ENDPOINT_URL')
+    if not endpoint:
+        endpoint = 'https://s3.%s.amazonaws.com' % region
+    return ak, sk, token, region, endpoint
+
+
+def uri_encode(s, encode_slash=True):
+    safe = '-._~'
+    out = []
+    for ch in s.encode('utf-8'):
+        c = chr(ch)
+        if c.isalnum() or c in safe:
+            out.append(c)
+        elif c == '/' and not encode_slash:
+            out.append('/')
+        else:
+            out.append('%%%02X' % ch)
+    return ''.join(out)
+
+
+def sign_request(method, endpoint, bucket, key, query, body, region, ak, sk,
+                 token, extra_headers=None):
+    parsed = urllib.parse.urlparse(endpoint)
+    host = parsed.netloc
+    scheme = parsed.scheme
+    base_path = parsed.path.rstrip('/')
+
+    path = base_path + '/' + bucket
+    if key:
+        path += '/' + key
+    canonical_uri = uri_encode(path, encode_slash=False)
+    if not canonical_uri.startswith('/'):
+        canonical_uri = '/' + canonical_uri
+
+    query = query or {}
+    qitems = sorted(query.items())
+    canonical_qs = '&'.join(
+        '%s=%s' % (uri_encode(k), uri_encode(str(v))) for k, v in qitems)
+
+    if body is None:
+        body = b''
+    payload_hash = EMPTY_SHA256 if not body else hashlib.sha256(
+        body).hexdigest()
+
+    now = datetime.datetime.utcnow()
+    amz_date = now.strftime('%Y%m%dT%H%M%SZ')
+    date_stamp = now.strftime('%Y%m%d')
+
+    headers = {
+        'host': host,
+        'x-amz-content-sha256': payload_hash,
+        'x-amz-date': amz_date,
+    }
+    if token:
+        headers['x-amz-security-token'] = token
+    if extra_headers:
+        for k, v in extra_headers.items():
+            headers[k.lower()] = v
+
+    signed_headers = ';'.join(sorted(headers.keys()))
+    canonical_headers = ''.join(
+        '%s:%s\n' % (k, str(headers[k]).strip())
+        for k in sorted(headers.keys()))
+
+    canonical_request = '\n'.join([
+        method, canonical_uri, canonical_qs, canonical_headers,
+        signed_headers, payload_hash])
+
+    scope = '%s/%s/s3/aws4_request' % (date_stamp, region)
+    string_to_sign = '\n'.join([
+        'AWS4-HMAC-SHA256', amz_date, scope,
+        hashlib.sha256(canonical_request.encode('utf-8')).hexdigest()])
+
+    def hs(key, msg):
+        return hmac.new(key, msg.encode('utf-8'), hashlib.sha256).digest()
+
+    kdate = hs(('AWS4' + sk).encode('utf-8'), date_stamp)
+    kregion = hs(kdate, region)
+    kservice = hs(kregion, 's3')
+    ksigning = hs(kservice, 'aws4_request')
+    signature = hmac.new(ksigning, string_to_sign.encode('utf-8'),
+                         hashlib.sha256).hexdigest()
+
+    auth = ('AWS4-HMAC-SHA256 Credential=%s/%s, SignedHeaders=%s, '
+            'Signature=%s' % (ak, scope, signed_headers, signature))
+    headers['Authorization'] = auth
+
+    full_path = canonical_uri
+    if canonical_qs:
+        full_path += '?' + canonical_qs
+    return scheme, host, full_path, headers
+
+
+def do_request(method, bucket, key='', query=None, body=None,
+               extra_headers=None):
+    ak, sk, token, region, endpoint = get_config()
+    scheme, host, full_path, headers = sign_request(
+        method, endpoint, bucket, key, query, body, region, ak, sk, token,
+        extra_headers)
+    if scheme == 'https':
+        conn = http.client.HTTPSConnection(host, timeout=60)
+    else:
+        conn = http.client.HTTPConnection(host, timeout=60)
+    try:
+        conn.request(method, full_path, body=body if body else b'',
+                     headers=headers)
+        resp = conn.getresponse()
+        data = resp.read()
+        status = resp.status
+        resp_headers = dict(resp.getheaders())
+    except Exception as e:
+        conn.close()
+        raise ClientError('EndpointConnectionError', str(e), 0)
+    conn.close()
+
+    if status < 200 or status >= 300:
+        code = 'Unknown'
+        msg = 'Unknown error'
+        if data:
+            try:
+                root = ET.fromstring(data)
+                c = root.find('.//Code')
+                m = root.find('.//Message')
+                if c is not None and c.text:
+                    code = c.text
+                if m is not None and m.text:
+                    msg = m.text
+            except Exception:
+                pass
+        if code == 'Unknown':
+            if status == 404:
+                code = 'NoSuchKey'
+                msg = 'The specified key does not exist.'
+            elif status == 403:
+                code = 'AccessDenied'
+                msg = 'Access Denied'
+        raise ClientError(code, msg, status)
+    return status, data, resp_headers
+
+
+def strip_ns(tag):
+    if '}' in tag:
+        return tag.split('}', 1)[1]
+    return tag
+
+
+def find_bucket_key(path):
+    if path.startswith('s3://'):
+        path = path[5:]
+    parts = path.split('/', 1)
+    bucket = parts[0]
+    key = parts[1] if len(parts) > 1 else ''
+    return bucket, key
+
+
+def split_s3_bucket_key(path):
+    if not path.startswith('s3://'):
+        raise ClientError('ValidationError', 'Invalid S3 path', 0)
+    return find_bucket_key(path)
+
+
+def is_s3express_bucket(bucket):
+    return bucket.endswith('--x-s3')
+
+
+def uni_print(s, stream=None):
+    if stream is None:
+        stream = sys.stdout
+    stream.write(s)
+    stream.flush()
+
+
+# API operations
+
+def create_bucket(bucket, region):
+    body = None
+    if region != 'us-east-1':
+        body = ('<CreateBucketConfiguration xmlns="%s">'
+                '<LocationConstraint>%s</LocationConstraint>'
+                '</CreateBucketConfiguration>' % (S3_NS, region)).encode(
+                    'utf-8')
+    do_request('PUT', bucket, '', None, body)
+
+
+def delete_bucket(bucket):
+    do_request('DELETE', bucket)
+
+
+def put_object(bucket, key, body, extra_headers=None):
+    do_request('PUT', bucket, key, None, body, extra_headers=extra_headers)
+
+
+def get_object(bucket, key):
+    status, data, headers = do_request('GET', bucket, key)
+    return data
+
+
+def delete_object(bucket, key):
+    do_request('DELETE', bucket, key)
+
+
+def head_object(bucket, key):
+    status, data, headers = do_request('HEAD', bucket, key)
+    return headers
+
+
+def copy_object(dest_bucket, dest_key, src_bucket, src_key, extra_headers=None):
+    src = '/' + src_bucket + '/' + uri_encode(src_key, encode_slash=False)
+    hdrs = {'x-amz-copy-source': src}
+    if extra_headers:
+        hdrs.update(extra_headers)
+    do_request('PUT', dest_bucket, dest_key, None, None,
+               extra_headers=hdrs)
+
+
+def list_objects_v2(bucket, prefix, delimiter=None):
+    contents = []
+    prefixes = []
+    token = None
+    while True:
+        query = {'list-type': '2', 'prefix': prefix}
+        if delimiter:
+            query['delimiter'] = delimiter
+        if token:
+            query['continuation-token'] = token
+        status, data, headers = do_request('GET', bucket, '', query)
+        root = ET.fromstring(data)
+        truncated = False
+        next_token = None
+        for child in root:
+            tag = strip_ns(child.tag)
+            if tag == 'Contents':
+                item = {}
+                for c in child:
+                    ct = strip_ns(c.tag)
+                    item[ct] = c.text
+                contents.append(item)
+            elif tag == 'CommonPrefixes':
+                for c in child:
+                    if strip_ns(c.tag) == 'Prefix':
+                        prefixes.append(c.text)
+            elif tag == 'IsTruncated':
+                truncated = (child.text == 'true')
+            elif tag == 'NextContinuationToken':
+                next_token = child.text
+        if truncated and next_token:
+            token = next_token
+        else:
+            break
+    return contents, prefixes
+
+
+def list_buckets():
+    status, data, headers = do_request('GET', '')
+    root = ET.fromstring(data)
+    buckets = []
+    for b in root.iter():
+        if strip_ns(b.tag) == 'Bucket':
+            name = None
+            cdate = None
+            for c in b:
+                ct = strip_ns(c.tag)
+                if ct == 'Name':
+                    name = c.text
+                elif ct == 'CreationDate':
+                    cdate = c.text
+            buckets.append((name, cdate))
+    return buckets
+
+
+def format_date(iso):
+    if not iso:
+        return '1970-01-01 00:00:00'
+    try:
+        s = iso.replace('Z', '')
+        if '.' in s:
+            s = s.split('.')[0]
+        dt = datetime.datetime.strptime(s, '%Y-%m-%dT%H:%M:%S')
+        return dt.strftime('%Y-%m-%d %H:%M:%S')
+    except Exception:
+        return '1970-01-01 00:00:00'
+
+
+# Commands
+
+USAGE = ('usage: aws s3 <command> [<args>]')
+
+
+def err_252(msg):
+    uni_print(msg + '\n', sys.stderr)
+    return 252
+
+
+def unknown_opt(flag):
+    uni_print('\nUnknown options: %s\n' % flag, sys.stderr)
+    return 252
+
+
+def build_put_headers(opts):
+    h = {}
+    sse = opts.get('sse')
+    if sse is not None:
+        h['x-amz-server-side-encryption'] = sse or 'AES256'
+    if opts.get('sse_kms_key_id'):
+        h['x-amz-server-side-encryption-aws-kms-key-id'] = opts['sse_kms_key_id']
+    if opts.get('website_redirect') is not None:
+        h['x-amz-website-redirect-location'] = opts['website_redirect']
+    if opts.get('storage_class'):
+        h['x-amz-storage-class'] = opts['storage_class']
+    if opts.get('content_type'):
+        h['Content-Type'] = opts['content_type']
+    if opts.get('request_payer'):
+        h['x-amz-request-payer'] = opts['request_payer']
+    return h
+
+
+def cmd_mb(args):
+    path = None
+    region_override = None
+    i = 0
+    while i < len(args):
+        a = args[i]
+        if a == '--region':
+            i += 1
+            if i < len(args):
+                region_override = args[i]
+        elif a.startswith('--region='):
+            region_override = a.split('=', 1)[1]
+        elif a.startswith('-') and a != '-':
+            return unknown_opt(a)
+        else:
+            path = a
+        i += 1
+
+    if path is None:
+        return err_252('usage: aws s3 mb <S3Uri>\nError: Invalid argument type')
+    if not path.startswith('s3://'):
+        return err_252('usage: aws s3 mb <S3Uri>\nError: Invalid argument type')
+
+    bucket, _ = split_s3_bucket_key(path)
+    if is_s3express_bucket(bucket):
+        return err_252('Cannot use mb command with a directory bucket.')
+
+    if region_override:
+        os.environ['AWS_REGION'] = region_override
+    ak, sk, token, region, endpoint = get_config()
+
+    try:
+        create_bucket(bucket, region)
+        uni_print("make_bucket: %s\n" % bucket)
+        return 0
+    except Exception as e:
+        uni_print("make_bucket failed: %s %s\n" % (path, e), sys.stderr)
+        return 1
+
+
+def cmd_ls(args):
+    path = ''
+    recursive = False
+    human = False
+    summarize = False
+    i = 0
+    while i < len(args):
+        a = args[i]
+        if a == '--recursive':
+            recursive = True
+        elif a == '--human-readable':
+            human = True
+        elif a == '--summarize':
+            summarize = True
+        elif a == '--page-size':
+            i += 1
+        elif a == '--region':
+            i += 1
+            if i < len(args):
+                os.environ['AWS_REGION'] = args[i]
+        elif a.startswith('--region='):
+            os.environ['AWS_REGION'] = a.split('=', 1)[1]
+        elif a.startswith('-') and a != '-':
+            uni_print(
+                "\nUnknown options: %s\n" % a, sys.stderr)
+            return 252
+        else:
+            path = a
+        i += 1
+
+    p = path
+    if p.startswith('s3://'):
+        p = p[5:]
+    bucket, key = find_bucket_key(p)
+
+    try:
+        if not bucket:
+            buckets = list_buckets()
+            for name, cdate in buckets:
+                uni_print(format_date(cdate) + ' ' + name + '\n')
+            return 0
+        elif recursive:
+            contents, prefixes = list_objects_v2(bucket, key, None)
+            total = 0
+            for item in contents:
+                size = int(item.get('Size', '0'))
+                total += size
+                lm = format_date(item.get('LastModified'))
+                k = item.get('Key', '')
+                uni_print('%s %10d %s\n' % (lm, size, k))
+            if summarize:
+                uni_print('\nTotal Objects: %d\n' % len(contents))
+                uni_print('   Total Size: %d\n' % total)
+            if key:
+                if not contents:
+                    return 1
+            return 0
+        else:
+            contents, prefixes = list_objects_v2(bucket, key, '/')
+            for pre in prefixes:
+                base = pre
+                if key and base.startswith(key):
+                    disp = base[len(key.rsplit('/', 1)[0]) + 1:] if '/' in key else base
+                else:
+                    disp = base
+                uni_print('%s %s\n' % (' ' * 27 + 'PRE', base if not key else pre[
+                    (key.rfind('/') + 1):]))
+            for item in contents:
+                k = item.get('Key', '')
+                if k == key:
+                    disp = k.rsplit('/', 1)[-1]
+                elif key and '/' in key:
+                    disp = k[key.rfind('/') + 1:]
+                elif key:
+                    disp = k
+                else:
+                    disp = k
+                size = int(item.get('Size', '0'))
+                lm = format_date(item.get('LastModified'))
+                uni_print('%s %10d %s\n' % (lm, size, disp))
+            if key:
+                if not contents and not prefixes:
+                    return 1
+            return 0
+    except ClientError as e:
+        uni_print('\n' + str(e) + '\n', sys.stderr)
+        return 1
+
+
+def is_stream(arg):
+    return arg == '-'
+
+
+def cmd_cp(args):
+    return _transfer(args, 'cp')
+
+
+def cmd_mv(args):
+    return _transfer(args, 'mv')
+
+
+def _transfer(args, op):
+    positional = []
+    dryrun = False
+    recursive = False
+    opts = {}
+    # value-taking flags -> opts key
+    valflags = {
+        '--sse-kms-key-id': 'sse_kms_key_id',
+        '--website-redirect': 'website_redirect',
+        '--storage-class': 'storage_class',
+        '--content-type': 'content_type',
+        '--metadata-directive': 'metadata_directive',
+    }
+    i = 0
+    while i < len(args):
+        a = args[i]
+        if a == '--dryrun':
+            dryrun = True
+        elif a == '--recursive':
+            recursive = True
+        elif a == '--region':
+            i += 1
+            if i < len(args):
+                os.environ['AWS_REGION'] = args[i]
+        elif a.startswith('--region='):
+            os.environ['AWS_REGION'] = a.split('=', 1)[1]
+        elif a == '--quiet' or a == '--no-progress':
+            pass
+        elif a == '--sse':
+            # nargs='?' const=AES256
+            if i + 1 < len(args) and not args[i + 1].startswith('-'):
+                i += 1
+                opts['sse'] = args[i]
+            else:
+                opts['sse'] = 'AES256'
+        elif a.startswith('--sse='):
+            opts['sse'] = a.split('=', 1)[1]
+        elif a == '--request-payer':
+            if i + 1 < len(args) and not args[i + 1].startswith('-'):
+                i += 1
+                opts['request_payer'] = args[i]
+            else:
+                opts['request_payer'] = 'requester'
+        elif a.startswith('--request-payer='):
+            opts['request_payer'] = a.split('=', 1)[1]
+        elif a in valflags:
+            i += 1
+            if i < len(args):
+                opts[valflags[a]] = args[i]
+        elif '=' in a and a.split('=', 1)[0] in valflags:
+            k, v = a.split('=', 1)
+            opts[valflags[k]] = v
+        elif a == '-':
+            positional.append(a)
+        elif a.startswith('-') and a != '-':
+            return unknown_opt(a)
+        else:
+            positional.append(a)
+        i += 1
+
+    if len(positional) < 2:
+        uni_print('usage: aws s3 %s <LocalPath> <S3Uri> or <S3Uri> <LocalPath> '
+                  'or <S3Uri> <S3Uri>\nError: Invalid argument type\n' % op,
+                  sys.stderr)
+        return 252
+
+    src = positional[0]
+    dst = positional[1]
+
+    src_s3 = src.startswith('s3://')
+    dst_s3 = dst.startswith('s3://')
+
+    # mv same-source checks (exit 252)
+    if op == 'mv' and src_s3 and dst_s3:
+        sb, sk = find_bucket_key(src)
+        db, dk = find_bucket_key(dst)
+        if sb == db and (sk == dk or (dst.endswith('/') and
+                                       sk.rsplit('/', 1)[-1] == '' or
+                                       (dk == '' ))):
+            if sk == dk:
+                return err_252('Cannot mv a file onto itself.')
+            if dst.endswith('/'):
+                # moving into same bucket root/prefix where it already resides
+                base = sk.rsplit('/', 1)[-1]
+                prefix = sk[:len(sk) - len(base)]
+                if prefix == dk:
+                    return err_252('Cannot mv a file onto itself.')
+
+    # streaming source
+    if is_stream(src):
+        if not dst_s3:
+            uni_print('upload failed: %s to %s Invalid destination\n' % (
+                src, dst), sys.stderr)
+            return 1
+        b, k = find_bucket_key(dst)
+        data = sys.stdin.buffer.read()
+        if dryrun:
+            uni_print('(dryrun) upload: %s to s3://%s/%s\n' % (src, b, k))
+            return 0
+        try:
+            put_object(b, k, data, build_put_headers(opts))
+            return 0
+        except ClientError as e:
+            uni_print('upload failed: %s to s3://%s/%s %s\n' % (
+                src, b, k, e), sys.stderr)
+            return 1
+
+    # streaming dest
+    if is_stream(dst):
+        if not src_s3:
+            uni_print('download failed: %s Invalid source\n' % src, sys.stderr)
+            return 1
+        b, k = find_bucket_key(src)
+        if dryrun:
+            uni_print('(dryrun) download: s3://%s/%s to %s\n' % (b, k, dst))
+            return 0
+        try:
+            data = get_object(b, k)
+            sys.stdout.buffer.write(data)
+            sys.stdout.buffer.flush()
+            return 0
+        except ClientError as e:
+            uni_print('download failed: s3://%s/%s to %s %s\n' % (
+                b, k, dst, e), sys.stderr)
+            return 1
+
+    # local -> s3 (upload)
+    if not src_s3 and dst_s3:
+        b, k = find_bucket_key(dst)
+        if k == '' or dst.endswith('/'):
+            k = (k + os.path.basename(src)) if k else os.path.basename(src)
+        if dryrun:
+            uni_print('(dryrun) upload: %s to s3://%s/%s\n' % (src, b, k))
+            return 0
+        try:
+            with open(src, 'rb') as f:
+                data = f.read()
+        except OSError:
+            uni_print('upload failed: %s The user-provided path %s does not '
+                      'exist.\n' % (src, src), sys.stderr)
+            return 1
+        try:
+            put_object(b, k, data, build_put_headers(opts))
+            uni_print('upload: %s to s3://%s/%s\n' % (src, b, k))
+            return 0
+        except ClientError as e:
+            uni_print('upload failed: %s to s3://%s/%s %s\n' % (
+                src, b, k, e), sys.stderr)
+            return 1
+
+    # s3 -> local (download)
+    if src_s3 and not dst_s3:
+        b, k = find_bucket_key(src)
+        outpath = dst
+        if os.path.isdir(dst) or dst.endswith('/') or dst.endswith(os.sep):
+            outpath = os.path.join(dst, os.path.basename(k))
+        if dryrun:
+            uni_print('(dryrun) download: s3://%s/%s to %s\n' % (b, k, outpath))
+            return 0
+        try:
+            data = get_object(b, k)
+        except ClientError as e:
+            uni_print('download failed: s3://%s/%s to %s %s\n' % (
+                b, k, outpath, e), sys.stderr)
+            return 1
+        try:
+            with open(outpath, 'wb') as f:
+                f.write(data)
+        except OSError as e:
+            uni_print('download failed: s3://%s/%s to %s %s\n' % (
+                b, k, outpath, e), sys.stderr)
+            return 1
+        uni_print('download: s3://%s/%s to %s\n' % (b, k, outpath))
+        if op == 'mv':
+            try:
+                delete_object(b, k)
+            except ClientError:
+                pass
+        return 0
+
+    # s3 -> s3 (copy)
+    if src_s3 and dst_s3:
+        sb, sk = find_bucket_key(src)
+        db, dk = find_bucket_key(dst)
+        if dk == '' or dst.endswith('/'):
+            dk = (dk + sk.rsplit('/', 1)[-1]) if dk else sk.rsplit('/', 1)[-1]
+        if dryrun:
+            label = 'copy' if op == 'cp' else 'move'
+            uni_print('(dryrun) %s: s3://%s/%s to s3://%s/%s\n' % (
+                label, sb, sk, db, dk))
+            return 0
+        try:
+            chdrs = build_put_headers(opts)
+            if opts.get('metadata_directive'):
+                chdrs['x-amz-metadata-directive'] = opts['metadata_directive']
+            copy_object(db, dk, sb, sk, chdrs)
+        except ClientError as e:
+            label = 'copy' if op == 'cp' else 'move'
+            uni_print('%s failed: s3://%s/%s to s3://%s/%s %s\n' % (
+                label, sb, sk, db, dk, e), sys.stderr)
+            return 1
+        label = 'copy' if op == 'cp' else 'move'
+        uni_print('%s: s3://%s/%s to s3://%s/%s\n' % (label, sb, sk, db, dk))
+        if op == 'mv':
+            try:
+                delete_object(sb, sk)
+            except ClientError:
+                pass
+        return 0
+
+    uni_print('%s: invalid arguments\n' % op, sys.stderr)
+    return 1
+
+
+def cmd_rm(args):
+    positional = []
+    dryrun = False
+    recursive = False
+    i = 0
+    while i < len(args):
+        a = args[i]
+        if a == '--dryrun':
+            dryrun = True
+        elif a == '--recursive':
+            recursive = True
+        elif a == '--region':
+            i += 1
+            if i < len(args):
+                os.environ['AWS_REGION'] = args[i]
+        elif a.startswith('--region='):
+            os.environ['AWS_REGION'] = a.split('=', 1)[1]
+        elif a == '--quiet':
+            pass
+        elif a == '--request-payer':
+            if i + 1 < len(args) and not args[i + 1].startswith('-'):
+                i += 1
+        elif a.startswith('--request-payer='):
+            pass
+        elif a.startswith('-') and a != '-':
+            return unknown_opt(a)
+        else:
+            positional.append(a)
+        i += 1
+
+    if not positional:
+        uni_print('usage: aws s3 rm <S3Uri>\nError: Invalid argument type\n',
+                  sys.stderr)
+        return 252
+
+    path = positional[0]
+    if not path.startswith('s3://'):
+        return err_252('usage: aws s3 rm <S3Uri>\nError: Invalid argument type')
+
+    b, k = find_bucket_key(path)
+
+    if recursive:
+        try:
+            contents, _ = list_objects_v2(b, k, None)
+        except ClientError as e:
+            uni_print(str(e) + '\n', sys.stderr)
+            return 1
+        rc = 0
+        for item in contents:
+            ik = item.get('Key', '')
+            if dryrun:
+                uni_print('(dryrun) delete: s3://%s/%s\n' % (b, ik))
+                continue
+            try:
+                delete_object(b, ik)
+                uni_print('delete: s3://%s/%s\n' % (b, ik))
+            except ClientError as e:
+                uni_print('delete failed: s3://%s/%s %s\n' % (b, ik, e),
+                          sys.stderr)
+                rc = 1
+        return rc
+
+    if dryrun:
+        uni_print('(dryrun) delete: s3://%s/%s\n' % (b, k))
+        return 0
+    try:
+        delete_object(b, k)
+        uni_print('delete: s3://%s/%s\n' % (b, k))
+        return 0
+    except ClientError as e:
+        uni_print('delete failed: s3://%s/%s %s\n' % (b, k, e), sys.stderr)
+        return 1
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 2:
+        uni_print(USAGE + '\n', sys.stderr)
+        return 2
+    if argv[1] != 's3':
+        uni_print("aws: error: argument command: Invalid choice: '%s'\n" % (
+            argv[1]), sys.stderr)
+        return 2
+    if len(argv) < 3:
+        uni_print(USAGE + '\n', sys.stderr)
+        return 2
+
+    sub = argv[2]
+    args = argv[3:]
+
+    dispatch = {
+        'cp': cmd_cp,
+        'mv': cmd_mv,
+        'ls': cmd_ls,
+        'mb': cmd_mb,
+        'rm': cmd_rm,
+    }
+
+    if sub not in dispatch:
+        uni_print("aws: error: argument operation: Invalid choice: '%s'\n" % (
+            sub), sys.stderr)
+        return 2
+
+    try:
+        return dispatch[sub](args)
+    except ClientError as e:
+        uni_print(str(e) + '\n', sys.stderr)
+        return 1
+    except BrokenPipeError:
+        return 0
+    except Exception as e:
+        uni_print('%s\n' % e, sys.stderr)
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
