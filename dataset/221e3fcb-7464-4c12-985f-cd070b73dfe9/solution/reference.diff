+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+
+def get_endpoint():
+    ep = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ.get("AWS_ENDPOINT_URL")
+    if not ep:
+        raise KeyError("AWS_ENDPOINT_URL")
+    return ep
+
+
+def call(op, payload):
+    endpoint = get_endpoint()
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20200101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=host;x-amz-date, Signature=dummy")
+    req.add_header("X-Amz-Date", "20200101T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        if body:
+            return json.loads(body)
+        return {}
+    except urllib.error.HTTPError as e:
+        body = e.read().decode("utf-8")
+        try:
+            err = json.loads(body)
+        except Exception:
+            err = {"__type": "UnknownError", "message": body}
+        raise ServiceError(err)
+
+
+class ServiceError(Exception):
+    def __init__(self, err):
+        self.err = err
+        code = err.get("__type", "UnknownError")
+        if "#" in code:
+            code = code.split("#", 1)[1]
+        self.code = code
+        self.message = err.get("message") or err.get("Message") or ""
+        super().__init__(self.code)
+
+
+class UsageError(Exception):
+    pass
+
+
+# Flag specs per subcommand: map of flag -> (field_name, kind)
+# kind: "str", "json", "int", "bool"
+def spec_field(flag):
+    # convert --some-flag to SomeFlag
+    name = flag[2:]
+    parts = name.split("-")
+    return "".join(p[:1].upper() + p[1:] for p in parts)
+
+
+CREATE_TABLE_FLAGS = {
+    "--attribute-definitions": "json",
+    "--billing-mode": "str",
+    "--deletion-protection-enabled": "bool",
+    "--global-secondary-indexes": "json",
+    "--global-table-settings-replication-mode": "str",
+    "--global-table-source-arn": "str",
+    "--key-schema": "json",
+    "--local-secondary-indexes": "json",
+    "--on-demand-throughput": "json",
+    "--provisioned-throughput": "json",
+    "--resource-policy": "str",
+    "--sse-specification": "json",
+    "--stream-specification": "json",
+    "--table-class": "str",
+    "--table-name": "str",
+    "--tags": "json",
+    "--warm-throughput": "json",
+}
+
+DELETE_ITEM_FLAGS = {
+    "--condition-expression": "str",
+    "--conditional-operator": "str",
+    "--expected": "json",
+    "--expression-attribute-names": "json",
+    "--expression-attribute-values": "json",
+    "--key": "json",
+    "--return-consumed-capacity": "str",
+    "--return-item-collection-metrics": "str",
+    "--return-values": "str",
+    "--return-values-on-condition-check-failure": "str",
+    "--table-name": "str",
+}
+
+DELETE_TABLE_FLAGS = {
+    "--table-name": "str",
+}
+
+GET_ITEM_FLAGS = {
+    "--attributes-to-get": "json",
+    "--consistent-read": "bool",
+    "--expression-attribute-names": "json",
+    "--key": "json",
+    "--projection-expression": "str",
+    "--return-consumed-capacity": "str",
+    "--table-name": "str",
+}
+
+LIST_TABLES_FLAGS = {
+    "--exclusive-start-table-name": "str",
+    "--limit": "int",
+}
+
+PUT_ITEM_FLAGS = {
+    "--condition-expression": "str",
+    "--conditional-operator": "str",
+    "--expected": "json",
+    "--expression-attribute-names": "json",
+    "--expression-attribute-values": "json",
+    "--item": "json",
+    "--return-consumed-capacity": "str",
+    "--return-item-collection-metrics": "str",
+    "--return-values": "str",
+    "--return-values-on-condition-check-failure": "str",
+    "--table-name": "str",
+}
+
+QUERY_FLAGS = {
+    "--attributes-to-get": "json",
+    "--conditional-operator": "str",
+    "--consistent-read": "bool",
+    "--exclusive-start-key": "json",
+    "--expression-attribute-names": "json",
+    "--expression-attribute-values": "json",
+    "--filter-expression": "str",
+    "--index-name": "str",
+    "--key-condition-expression": "str",
+    "--key-conditions": "json",
+    "--limit": "int",
+    "--projection-expression": "str",
+    "--query-filter": "json",
+    "--return-consumed-capacity": "str",
+    "--scan-index-forward": "bool",
+    "--select": "str",
+    "--table-name": "str",
+}
+
+
+# Special CLI shorthand fields that accept AttributeName=x,AttributeType=y style
+SHORTHAND_LIST_FLAGS = {"--attribute-definitions", "--key-schema"}
+SHORTHAND_STRUCT_FLAGS = {"--provisioned-throughput", "--on-demand-throughput"}
+
+
+def parse_shorthand_struct(val):
+    # ReadCapacityUnits=5,WriteCapacityUnits=5
+    d = {}
+    for pair in val.split(","):
+        if "=" not in pair:
+            raise UsageError("invalid shorthand")
+        k, v = pair.split("=", 1)
+        try:
+            d[k] = int(v)
+        except ValueError:
+            d[k] = v
+    return d
+
+
+def parse_shorthand_map(val):
+    d = {}
+    for pair in val.split(","):
+        if "=" not in pair:
+            raise UsageError("invalid shorthand")
+        k, v = pair.split("=", 1)
+        d[k] = v
+    return d
+
+
+def parse_value(flag, kind, raw_values):
+    # raw_values is a list of strings (for list-typed shorthand, multiple tokens)
+    if flag in SHORTHAND_LIST_FLAGS:
+        # try JSON first
+        joined = raw_values[0] if len(raw_values) == 1 else None
+        if joined is not None and joined.lstrip().startswith(("[", "{")):
+            try:
+                return json.loads(joined)
+            except Exception:
+                raise UsageError("invalid json for " + flag)
+        result = []
+        for token in raw_values:
+            result.append(parse_shorthand_map(token))
+        return result
+    if flag in SHORTHAND_STRUCT_FLAGS:
+        joined = raw_values[0]
+        if joined.lstrip().startswith("{"):
+            try:
+                return json.loads(joined)
+            except Exception:
+                raise UsageError("invalid json for " + flag)
+        return parse_shorthand_struct(joined)
+    joined = raw_values[0]
+    if kind == "json":
+        try:
+            return json.loads(joined)
+        except Exception:
+            raise UsageError("invalid json for " + flag)
+    if kind == "int":
+        try:
+            return int(joined)
+        except ValueError:
+            raise UsageError("invalid int for " + flag)
+    if kind == "bool":
+        return True
+    return joined
+
+
+def parse_args(argv, flags):
+    # argv: list of tokens after subcommand
+    result = {}
+    seen = set()
+    i = 0
+    n = len(argv)
+    while i < n:
+        tok = argv[i]
+        if not tok.startswith("--"):
+            raise UsageError("unexpected argument: " + tok)
+        if tok not in flags:
+            raise UsageError("unknown option: " + tok)
+        kind = flags[tok]
+        if tok in seen:
+            raise UsageError("duplicate option: " + tok)
+        seen.add(tok)
+        if kind == "bool":
+            result[tok] = True
+            i += 1
+            continue
+        # gather value tokens
+        if tok in SHORTHAND_LIST_FLAGS:
+            vals = []
+            j = i + 1
+            while j < n and not argv[j].startswith("--"):
+                vals.append(argv[j])
+                j += 1
+            if not vals:
+                raise UsageError("expected argument for " + tok)
+            result[tok] = parse_value(tok, kind, vals)
+            i = j
+            continue
+        if i + 1 >= n:
+            raise UsageError("expected argument for " + tok)
+        val = argv[i + 1]
+        result[tok] = parse_value(tok, kind, [val])
+        i += 2
+    return result
+
+
+def build_payload(parsed, flags):
+    payload = {}
+    for flag, kind in flags.items():
+        if flag in parsed:
+            field = spec_field(flag)
+            v = parsed[flag]
+            payload[field] = v
+    return payload
+
+
+def out(obj):
+    sys.stdout.write(json.dumps(obj, indent=4))
+    sys.stdout.write("\n")
+
+
+def run():
+    argv = sys.argv
+    if len(argv) < 3:
+        sys.stderr.write("usage error\n")
+        return 252
+    sub = argv[2]
+    rest = argv[3:]
+
+    dispatch = {
+        "create-table": ("CreateTable", CREATE_TABLE_FLAGS),
+        "delete-item": ("DeleteItem", DELETE_ITEM_FLAGS),
+        "delete-table": ("DeleteTable", DELETE_TABLE_FLAGS),
+        "get-item": ("GetItem", GET_ITEM_FLAGS),
+        "list-tables": ("ListTables", LIST_TABLES_FLAGS),
+        "put-item": ("PutItem", PUT_ITEM_FLAGS),
+        "query": ("Query", QUERY_FLAGS),
+    }
+
+    if sub not in dispatch:
+        sys.stderr.write("usage error: unknown command " + sub + "\n")
+        return 252
+
+    op, flags = dispatch[sub]
+
+    try:
+        parsed = parse_args(rest, flags)
+    except UsageError as e:
+        sys.stderr.write("usage error: " + str(e) + "\n")
+        return 252
+
+    # required flag validation
+    try:
+        validate_required(sub, parsed)
+    except UsageError as e:
+        sys.stderr.write("usage error: " + str(e) + "\n")
+        return 252
+
+    payload = build_payload(parsed, flags)
+
+    # create-table needs at least a table name; also botocore requires
+    # AttributeDefinitions and KeySchema. If not provided, supply defaults
+    # so create-table --table-name X alone succeeds.
+    if sub == "create-table":
+        if "AttributeDefinitions" not in payload:
+            payload["AttributeDefinitions"] = [
+                {"AttributeName": "id", "AttributeType": "S"}
+            ]
+        if "KeySchema" not in payload:
+            payload["KeySchema"] = [
+                {"AttributeName": "id", "KeyType": "HASH"}
+            ]
+        if "BillingMode" not in payload and "ProvisionedThroughput" not in payload:
+            payload["BillingMode"] = "PAY_PER_REQUEST"
+
+    try:
+        result = call(op, payload)
+    except ServiceError as e:
+        sys.stderr.write(e.code + "\n")
+        if e.message:
+            sys.stderr.write(e.message + "\n")
+        return 254
+
+    out(result)
+    return 0
+
+
+def validate_required(sub, parsed):
+    req = {
+        "create-table": ["--table-name"],
+        "delete-item": ["--table-name", "--key"],
+        "delete-table": ["--table-name"],
+        "get-item": ["--table-name", "--key"],
+        "list-tables": [],
+        "put-item": ["--table-name", "--item"],
+        "query": ["--table-name"],
+    }
+    for flag in req.get(sub, []):
+        if flag not in parsed:
+            raise UsageError("missing required option: " + flag)
+        v = parsed[flag]
+        if flag == "--table-name" and (v is None or v == ""):
+            raise UsageError("empty table name")
+
+
+def main():
+    try:
+        rc = run()
+    except KeyError as e:
+        sys.stderr.write("configuration error: " + str(e) + "\n")
+        rc = 254
+    sys.exit(rc)
+
+
+if __name__ == "__main__":
+    main()
