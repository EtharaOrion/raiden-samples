+TEMPLATE_STRING_RE = re.compile(r"\{[a-zA-Z#]+\}")
+GET_ATTR_RE = re.compile(r"(\w*)\[(\d+)\]")
+VALID_HOST_LABEL_RE = re.compile(
+    r"^(?!-)[a-zA-Z\d-]{1,63}(?<!-)$",
+)
