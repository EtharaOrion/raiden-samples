+            elif error_type == 'USER_CREDENTIALS_CHANGED':
+                raise LoginRefreshPasswordChanged()
+            elif error_type == 'INSUFFICIENT_PERMISSIONS':
+                raise LoginInsufficientPermissions()
+            raise LoginError from e
