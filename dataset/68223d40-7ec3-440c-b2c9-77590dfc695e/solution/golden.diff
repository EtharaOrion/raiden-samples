+"""GENERATED stub for slice: docstrings are only realized in help rendering.
+
+botocore.client / botocore.waiter / botocore.docs.paginator import these classes
+to assign as __doc__ on dynamically generated client methods. The originals are
+str subclasses that lazily render RST-formatted help text; the stubs preserve
+the str-subclass contract (so ``__doc__ = X()`` works) but render an empty
+string in the sliced runtime where help is never surfaced.
+"""
+
+from __future__ import annotations
+
+
+class LazyLoadedDocstring(str):
+    def __new__(cls, *args, **kwargs):
+        return str.__new__(cls, "")
+
+    def __init__(self, *args, **kwargs):
+        pass
+
+
+class ClientMethodDocstring(LazyLoadedDocstring):
+    pass
+
+
+class WaiterDocstring(LazyLoadedDocstring):
+    pass
+
+
+class PaginatorDocstring(LazyLoadedDocstring):
+    pass
