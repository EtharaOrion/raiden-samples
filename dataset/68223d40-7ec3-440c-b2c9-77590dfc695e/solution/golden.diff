+    """
+    opener = os.open
+    if access_permissions is not None:
+        opener = partial(os.open, mode=access_permissions)
+    if 'b' not in mode:
+        encoding = getpreferredencoding()
+    return open(filename, mode, encoding=encoding, opener=opener)
