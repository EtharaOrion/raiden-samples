+"""GENERATED stub for slice: docs.utils classes are registered as `docs.*` handlers.
+
+botocore.handlers registers instances of AutoPopulatedParam / AppendParamDocumentation
+/ HideParamFromOperations against ``docs.*`` events. Those events fire only during
+help rendering, which the sliced runtime never triggers. The stubs preserve the
+constructor signature and method surface (via ``_NoOp``) so import-time handler
+registration succeeds; the callbacks are never invoked in subprocess mode.
+"""
+
+from __future__ import annotations
+
+
+class _NoOp:
+    def __init__(self, *args, **kwargs):
+        pass
+
+    def __call__(self, *args, **kwargs):
+        return None
+
+    def __getattr__(self, name):
+        return _NoOp()
+
+
+class AutoPopulatedParam(_NoOp):
+    def __init__(self, name=None, *args, **kwargs):
+        self.name = name
+
+
+class AppendParamDocumentation(_NoOp):
+    pass
+
+
+class HideParamFromOperations(_NoOp):
+    pass
