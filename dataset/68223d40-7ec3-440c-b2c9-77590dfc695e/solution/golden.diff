+    def _construct_basic_auth(self, username, password):
+        auth_str = f'{username}:{password}'
+        encoded_str = b64encode(auth_str.encode('ascii')).strip().decode()
+        return f'Basic {encoded_str}'
+
+    def _get_auth_from_url(self, url):
