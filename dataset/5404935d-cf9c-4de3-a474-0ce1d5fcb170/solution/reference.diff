+def do_mb(args):
+    path = None
+    region = None
+    i = 0
+    while i < len(args):
+        a = args[i]
+        if a == '--region':
+            region = args[i + 1]
+            i += 2
+        elif a.startswith('--region='):
+            region = a.split('=', 1)[1]
+            i += 1
+        else:
+            path = a
+            i += 1
+    if path is None:
+        uni_print("aws: error: the following arguments are required: path\n", sys.stderr)
+        return 252
+    if not path.startswith('s3://'):
+        uni_print("Error: Invalid argument type\n", sys.stderr)
+        return 252
+    bucket, _ = split_s3_bucket_key(path)
+    if is_s3express_bucket(bucket):
+        uni_print("Cannot use mb command with a directory bucket.\n", sys.stderr)
+        return 252
+    if region:
+        os.environ['AWS_REGION'] = region
+    client = S3Client()
+    try:
+        client.create_bucket(bucket)
+        uni_print("make_bucket: %s\n" % bucket)
+        return 0
+    except ClientError as e:
+        uni_print("make_bucket failed: %s %s\n" % (path, e), sys.stderr)
+        return 1
+
