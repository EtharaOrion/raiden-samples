+def is_s3(p):
+    return p.startswith('s3://')
+
+
+# Options that take a value (subset of real aws-cli s3 transfer params).
+TRANSFER_VALUE_OPTS = {
+    '--sse', '--sse-kms-key-id', '--sse-c', '--sse-c-key',
+    '--sse-c-copy-source', '--sse-c-copy-source-key', '--website-redirect',
+    '--storage-class', '--content-type', '--cache-control',
+    '--content-disposition', '--content-encoding', '--content-language',
+    '--expires', '--metadata', '--metadata-directive', '--acl', '--grants',
+    '--expected-size', '--region', '--endpoint-url', '--profile',
+    '--source-region', '--request-payer', '--page-size',
+    '--exclude', '--include',
+}
+# Boolean (store_true) options.
+TRANSFER_BOOL_OPTS = {
+    '--recursive', '--dryrun', '--quiet', '--no-progress',
+    '--follow-symlinks', '--no-follow-symlinks', '--no-guess-mime-type',
+    '--only-show-errors', '--ignore-glacier-warnings',
+    '--force-glacier-transfer', '--delete', '--size-only', '--exact-timestamps',
+}
+
+
+def parse_transfer_opts(args):
+    """Parse aws-cli s3 transfer args into (positional, opts, unknown)."""
+    positional = []
+    opts = {}
+    unknown = []
+    i = 0
+    n = len(args)
+    while i < n:
+        a = args[i]
+        if a.startswith('--') and '=' in a:
+            k, v = a.split('=', 1)
+            if k in TRANSFER_VALUE_OPTS:
+                opts[k] = v
+            elif k not in TRANSFER_BOOL_OPTS:
+                unknown.append(k)
+            i += 1
+        elif a in TRANSFER_BOOL_OPTS:
+            opts[a] = True
+            i += 1
+        elif a == '--sse':
+            if i + 1 < n and args[i + 1] in ('AES256', 'aws:kms'):
+                opts[a] = args[i + 1]
+                i += 2
+            else:
+                opts[a] = 'AES256'
+                i += 1
+        elif a == '--request-payer':
+            if i + 1 < n and not args[i + 1].startswith('-') and not is_s3(args[i + 1]):
+                opts[a] = args[i + 1]
+                i += 2
+            else:
+                opts[a] = 'requester'
+                i += 1
+        elif a in TRANSFER_VALUE_OPTS:
+            if i + 1 < n:
+                opts[a] = args[i + 1]
+                i += 2
+            else:
+                unknown.append(a)
+                i += 1
+        elif a.startswith('-') and a != '-':
+            unknown.append(a)
+            i += 1
+        else:
+            positional.append(a)
+            i += 1
+    return positional, opts, unknown
+
+
+def build_transfer_headers(opts):
+    h = {}
+    if opts.get('--sse'):
+        h['x-amz-server-side-encryption'] = opts['--sse']
+    if opts.get('--sse-kms-key-id'):
+        h['x-amz-server-side-encryption-aws-kms-key-id'] = opts['--sse-kms-key-id']
+    if opts.get('--website-redirect'):
+        h['x-amz-website-redirect-location'] = opts['--website-redirect']
+    if opts.get('--storage-class'):
+        h['x-amz-storage-class'] = opts['--storage-class']
+    if opts.get('--content-type'):
+        h['content-type'] = opts['--content-type']
+    if opts.get('--cache-control'):
+        h['cache-control'] = opts['--cache-control']
+    if opts.get('--content-encoding'):
+        h['content-encoding'] = opts['--content-encoding']
+    if opts.get('--content-disposition'):
+        h['content-disposition'] = opts['--content-disposition']
+    if opts.get('--content-language'):
+        h['content-language'] = opts['--content-language']
+    if opts.get('--expires'):
+        h['expires'] = opts['--expires']
+    if opts.get('--acl'):
+        h['x-amz-acl'] = opts['--acl']
+    if opts.get('--request-payer'):
+        h['x-amz-request-payer'] = opts['--request-payer']
+    if opts.get('--metadata-directive'):
+        h['x-amz-metadata-directive'] = opts['--metadata-directive']
+    return h
+
+
+def do_cp(args):
+    positional, opts, unknown = parse_transfer_opts(args)
+    if unknown:
+        uni_print("\nUnknown options: %s\n" % ','.join(unknown), sys.stderr)
+        return 252
+    recursive = bool(opts.get('--recursive'))
+    dryrun = bool(opts.get('--dryrun'))
+    extra_headers = build_transfer_headers(opts)
+
+    if len(positional) < 2:
+        uni_print("usage: aws s3 cp <LocalPath> <S3Uri> or <S3Uri> <LocalPath> or <S3Uri> <S3Uri>\n", sys.stderr)
+        uni_print("Error: Invalid number of arguments\n", sys.stderr)
+        return 252
+
+    src, dest = positional[0], positional[1]
+    client = S3Client()
+
+    src_s3 = is_s3(src)
+    dest_s3 = is_s3(dest)
+
+    # streaming
+    if src == '-' and dest_s3:
+        bucket, key = split_s3_bucket_key(dest)
+        data = sys.stdin.buffer.read()
+        if dryrun:
+            uni_print("(dryrun) upload: - to s3://%s/%s\n" % (bucket, key))
+            return 0
+        try:
+            client.put_object(bucket, key, data, extra_headers=extra_headers)
+            return 0
+        except ClientError as e:
+            uni_print("upload failed: - to s3://%s/%s %s\n" % (bucket, key, e), sys.stderr)
+            return 1
+
+    if src_s3 and dest == '-':
+        bucket, key = split_s3_bucket_key(src)
+        try:
+            data = client.get_object(bucket, key)
+            sys.stdout.buffer.write(data)
+            sys.stdout.buffer.flush()
+            return 0
+        except ClientError as e:
+            uni_print("download failed: s3://%s/%s to - %s\n" % (bucket, key, e), sys.stderr)
+            return 1
+
+    if recursive:
+        return _cp_recursive(client, src, dest, src_s3, dest_s3, dryrun, extra_headers)
+
+    # upload
+    if not src_s3 and dest_s3:
+        bucket, key = split_s3_bucket_key(dest)
+        if not key or dest.endswith('/'):
+            key = (key + os.path.basename(src)) if key else os.path.basename(src)
+        if not os.path.isfile(src):
+            uni_print("upload failed: %s to s3://%s/%s The user-provided path %s does not exist.\n" % (src, bucket, key, src), sys.stderr)
+            return 1
+        dest_uri = 's3://%s/%s' % (bucket, key)
+        if dryrun:
+            uni_print("(dryrun) upload: %s to %s\n" % (src, dest_uri))
+            return 0
+        try:
+            with open(src, 'rb') as f:
+                data = f.read()
+            client.put_object(bucket, key, data, extra_headers=extra_headers)
+            uni_print("upload: %s to %s\n" % (src, dest_uri))
+            return 0
+        except ClientError as e:
+            uni_print("upload failed: %s to %s %s\n" % (src, dest_uri, e), sys.stderr)
+            return 1
+
+    # download
+    if src_s3 and not dest_s3:
+        bucket, key = split_s3_bucket_key(src)
+        outpath = dest
+        if os.path.isdir(dest) or dest.endswith('/'):
+            outpath = os.path.join(dest, os.path.basename(key))
+        src_uri = 's3://%s/%s' % (bucket, key)
+        if dryrun:
+            uni_print("(dryrun) download: %s to %s\n" % (src_uri, outpath))
+            return 0
+        try:
+            data = client.get_object(bucket, key)
+            with open(outpath, 'wb') as f:
+                f.write(data)
+            uni_print("download: %s to %s\n" % (src_uri, outpath))
+            return 0
+        except ClientError as e:
+            uni_print("download failed: %s to %s %s\n" % (src_uri, outpath, e), sys.stderr)
+            return 1
+
+    # copy
+    if src_s3 and dest_s3:
+        sb, sk = split_s3_bucket_key(src)
+        db, dk = split_s3_bucket_key(dest)
+        if not dk or dest.endswith('/'):
+            dk = (dk + os.path.basename(sk)) if dk else os.path.basename(sk)
+        src_uri = 's3://%s/%s' % (sb, sk)
+        dest_uri = 's3://%s/%s' % (db, dk)
+        if dryrun:
+            uni_print("(dryrun) copy: %s to %s\n" % (src_uri, dest_uri))
+            return 0
+        try:
+            client.copy_object(db, dk, sb, sk, extra_headers=extra_headers)
+            uni_print("copy: %s to %s\n" % (src_uri, dest_uri))
+            return 0
+        except ClientError as e:
+            uni_print("copy failed: %s to %s %s\n" % (src_uri, dest_uri, e), sys.stderr)
+            return 1
+
+    uni_print("Error: Invalid argument type\n", sys.stderr)
+    return 1
+
+
+def _cp_recursive(client, src, dest, src_s3, dest_s3, dryrun, extra_headers=None):
+    rc = 0
+    if not src_s3 and dest_s3:
+        bucket, prefix = split_s3_bucket_key(dest)
+        if prefix and not prefix.endswith('/'):
+            prefix += '/'
+        for root, dirs, files in os.walk(src):
+            for fn in files:
+                fp = os.path.join(root, fn)
+                rel = os.path.relpath(fp, src)
+                key = prefix + rel.replace(os.sep, '/')
+                dest_uri = 's3://%s/%s' % (bucket, key)
+                if dryrun:
+                    uni_print("(dryrun) upload: %s to %s\n" % (fp, dest_uri))
+                    continue
+                try:
+                    with open(fp, 'rb') as f:
+                        data = f.read()
+                    client.put_object(bucket, key, data, extra_headers=extra_headers)
+                    uni_print("upload: %s to %s\n" % (fp, dest_uri))
+                except ClientError as e:
+                    uni_print("upload failed: %s to %s %s\n" % (fp, dest_uri, e), sys.stderr)
+                    rc = 1
+        return rc
+    if src_s3 and not dest_s3:
+        bucket, prefix = split_s3_bucket_key(src)
+        try:
+            objs, _ = client.list_objects_v2(bucket, prefix=prefix)
+        except ClientError as e:
+            uni_print("download failed: %s\n" % e, sys.stderr)
+            return 1
+        for o in objs:
+            key = o['Key']
+            rel = key[len(prefix):] if prefix else key
+            rel = rel.lstrip('/')
+            outpath = os.path.join(dest, rel)
+            src_uri = 's3://%s/%s' % (bucket, key)
+            if dryrun:
+                uni_print("(dryrun) download: %s to %s\n" % (src_uri, outpath))
+                continue
+            try:
+                os.makedirs(os.path.dirname(outpath) or '.', exist_ok=True)
+                data = client.get_object(bucket, key)
+                with open(outpath, 'wb') as f:
+                    f.write(data)
+                uni_print("download: %s to %s\n" % (src_uri, outpath))
+            except ClientError as e:
+                uni_print("download failed: %s to %s %s\n" % (src_uri, outpath, e), sys.stderr)
+                rc = 1
+        return rc
+    return 1
+
+
+def do_sync(args):
+    if '--recursive' in args:
+        uni_print("aws: error: unrecognized arguments: --recursive\n", sys.stderr)
+        return 252
+    positional, opts, unknown = parse_transfer_opts(args)
+    if unknown:
+        uni_print("\nUnknown options: %s\n" % ','.join(unknown), sys.stderr)
+        return 252
+    dryrun = bool(opts.get('--dryrun'))
+    delete = bool(opts.get('--delete'))
+    extra_headers = build_transfer_headers(opts)
+
+    if len(positional) < 2:
+        uni_print("usage: aws s3 sync <LocalPath> <S3Uri> or <S3Uri> <LocalPath> or <S3Uri> <S3Uri>\n", sys.stderr)
+        return 252
+
+    src, dest = positional[0], positional[1]
+    src_s3 = is_s3(src)
+    dest_s3 = is_s3(dest)
+    client = S3Client()
+
+    # sync to a key destination is invalid
+    if dest_s3:
+        db, dk = split_s3_bucket_key(dest)
+        if dk and not dk.endswith('/'):
+            # invalid: sync needs directory destination -> but must call ListObjectsV2, PutObject
+            pass
+
+    # local -> s3
+    if not src_s3 and dest_s3:
+        if not os.path.isdir(src):
+            uni_print("The user-provided path %s does not exist.\n" % src, sys.stderr)
+            return 255
+        bucket, prefix = split_s3_bucket_key(dest)
+        if prefix and not prefix.endswith('/'):
+            prefix += '/'
+        try:
+            existing, _ = client.list_objects_v2(bucket, prefix=prefix)
+        except ClientError as e:
+            uni_print("sync failed: %s\n" % e, sys.stderr)
+            return 255
+        existing_map = {o['Key']: o for o in existing}
+        rc = 0
+        for root, dirs, files in os.walk(src):
+            for fn in files:
+                fp = os.path.join(root, fn)
+                rel = os.path.relpath(fp, src).replace(os.sep, '/')
+                key = prefix + rel
+                size = os.path.getsize(fp)
+                need = True
+                if key in existing_map and existing_map[key]['Size'] == size:
+                    need = False
+                if not need:
+                    continue
+                dest_uri = 's3://%s/%s' % (bucket, key)
+                if dryrun:
+                    uni_print("(dryrun) upload: %s to %s\n" % (fp, dest_uri))
+                    continue
+                try:
+                    with open(fp, 'rb') as f:
+                        data = f.read()
+                    client.put_object(bucket, key, data, extra_headers=extra_headers)
+                    uni_print("upload: %s to %s\n" % (fp, dest_uri))
+                except ClientError as e:
+                    uni_print("upload failed: %s to %s %s\n" % (fp, dest_uri, e), sys.stderr)
+                    rc = 1
+        return rc
+
+    # s3 -> local
+    if src_s3 and not dest_s3:
+        bucket, prefix = split_s3_bucket_key(src)
+        try:
+            objs, _ = client.list_objects_v2(bucket, prefix=prefix)
+        except ClientError as e:
+            uni_print("sync failed: %s\n" % e, sys.stderr)
+            return 255
+        rc = 0
+        for o in objs:
+            key = o['Key']
+            rel = key[len(prefix):] if prefix else key
+            rel = rel.lstrip('/')
+            if not rel:
+                continue
+            outpath = os.path.join(dest, rel)
+            need = True
+            if os.path.isfile(outpath) and os.path.getsize(outpath) == o['Size']:
+                need = False
+            if not need:
+                continue
+            src_uri = 's3://%s/%s' % (bucket, key)
+            if dryrun:
+                uni_print("(dryrun) download: %s to %s\n" % (src_uri, outpath))
+                continue
+            try:
+                os.makedirs(os.path.dirname(outpath) or '.', exist_ok=True)
+                data = client.get_object(bucket, key)
+                with open(outpath, 'wb') as f:
+                    f.write(data)
+                uni_print("download: %s to %s\n" % (src_uri, outpath))
+            except ClientError as e:
+                uni_print("download failed: %s to %s %s\n" % (src_uri, outpath, e), sys.stderr)
+                rc = 1
+        return rc
+
+    # s3 -> s3
+    if src_s3 and dest_s3:
+        sb, sp = split_s3_bucket_key(src)
+        db, dp = split_s3_bucket_key(dest)
+        if dp and not dp.endswith('/'):
+            dp += '/'
+        try:
+            objs, _ = client.list_objects_v2(sb, prefix=sp)
+            existing, _ = client.list_objects_v2(db, prefix=dp)
+        except ClientError as e:
+            uni_print("sync failed: %s\n" % e, sys.stderr)
+            return 255
+        existing_map = {o['Key']: o for o in existing}
+        rc = 0
+        for o in objs:
+            key = o['Key']
+            rel = key[len(sp):] if sp else key
+            rel = rel.lstrip('/')
+            dk = dp + rel
+            if dk in existing_map and existing_map[dk]['Size'] == o['Size']:
+                continue
+            src_uri = 's3://%s/%s' % (sb, key)
+            dest_uri = 's3://%s/%s' % (db, dk)
+            if dryrun:
+                uni_print("(dryrun) copy: %s to %s\n" % (src_uri, dest_uri))
+                continue
+            try:
+                client.copy_object(db, dk, sb, key, extra_headers=extra_headers)
+                uni_print("copy: %s to %s\n" % (src_uri, dest_uri))
+            except ClientError as e:
+                uni_print("copy failed: %s to %s %s\n" % (src_uri, dest_uri, e), sys.stderr)
+                rc = 1
+        return rc
+
+    uni_print("Error: Invalid argument type\n", sys.stderr)
+    return 255
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 2:
+        uni_print("usage: aws s3 <subcommand>\n", sys.stderr)
+        return 2
+    if argv[1] != 's3':
+        uni_print("aws: error: argument command: Invalid choice: '%s'\n" % argv[1], sys.stderr)
+        return 2
+    if len(argv) < 3:
+        uni_print("usage: aws s3 <subcommand>\n", sys.stderr)
+        return 2
+    sub = argv[2]
+    rest = argv[3:]
+    try:
+        if sub == 'mb':
+            return do_mb(rest)
+        elif sub == 'rb':
+            return do_rb(rest)
+        elif sub == 'rm':
+            return do_rm(rest)
+        elif sub == 'cp':
+            return do_cp(rest)
+        elif sub == 'sync':
+            return do_sync(rest)
+        else:
+            uni_print("aws: error: argument subcommand: Invalid choice: '%s'\n" % sub, sys.stderr)
+            return 2
+    except ClientError as e:
+        uni_print("%s\n" % e, sys.stderr)
+        return 1
+    except BrokenPipeError:
+        return 0
+    except Exception as e:
+        uni_print("%s\n" % e, sys.stderr)
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
