+def do_rm(args):
+    path = None
+    recursive = False
+    dryrun = False
+    unknown = []
+    i = 0
+    n = len(args)
+    while i < n:
+        a = args[i]
+        if a == '--recursive':
+            recursive = True
+            i += 1
+        elif a == '--dryrun':
+            dryrun = True
+            i += 1
+        elif a in RM_BOOL_OPTS:
+            i += 1
+        elif a.startswith('--') and '=' in a:
+            k = a.split('=', 1)[0]
+            if k not in RM_VALUE_OPTS and k not in RM_BOOL_OPTS:
+                unknown.append(k)
+            i += 1
+        elif a in RM_VALUE_OPTS:
+            i += 2
+        elif a.startswith('-') and a != '-':
+            unknown.append(a)
+            i += 1
+        else:
+            path = a
+            i += 1
+    if unknown:
+        uni_print("\nUnknown options: %s\n" % ','.join(unknown), sys.stderr)
+        return 252
+    if path is None or not path.startswith('s3://'):
+        uni_print("aws: error: argument paths: Invalid argument type\n", sys.stderr)
+        return 252
+    bucket, key = split_s3_bucket_key(path)
+    client = S3Client()
+    if recursive:
+        try:
+            objs, _ = client.list_objects_v2(bucket, prefix=key)
+        except ClientError as e:
+            uni_print("delete failed: %s %s\n" % (path, e), sys.stderr)
+            return 1
+        rc = 0
+        for o in objs:
+            dest = 's3://%s/%s' % (bucket, o['Key'])
+            if dryrun:
+                uni_print("(dryrun) delete: %s\n" % dest)
+                continue
+            try:
+                client.delete_object(bucket, o['Key'])
+                uni_print("delete: %s\n" % dest)
+            except ClientError as e:
+                uni_print("delete failed: %s %s\n" % (dest, e), sys.stderr)
+                rc = 1
+        return rc
+    else:
+        if dryrun:
+            uni_print("(dryrun) delete: s3://%s/%s\n" % (bucket, key))
+            return 0
+        try:
+            client.delete_object(bucket, key)
+            uni_print("delete: s3://%s/%s\n" % (bucket, key))
+            return 0
+        except ClientError as e:
+            uni_print("delete failed: s3://%s/%s %s\n" % (bucket, key, e), sys.stderr)
+            return 1
+
