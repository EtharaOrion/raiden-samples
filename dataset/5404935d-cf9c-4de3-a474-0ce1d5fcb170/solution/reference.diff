+#!/usr/bin/env python3
+import sys
+import os
+import hashlib
+import hmac
+import datetime
+import urllib.parse
+import http.client
+import xml.etree.ElementTree as ET
+
+MULTIPART_THRESHOLD = 8 * 1024 * 1024
+EMPTY_SHA256 = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
+S3_NS = 'http://s3.amazonaws.com/doc/2006-03-01/'
+
+
+def uni_print(s, out=None):
+    if out is None:
+        out = sys.stdout
+    out.write(s)
+    out.flush()
+
+
+def get_region():
+    return os.environ.get('AWS_REGION') or os.environ.get('AWS_DEFAULT_REGION') or 'us-east-1'
+
+
+def get_endpoint():
+    return os.environ.get('AWS_ENDPOINT_URL_S3') or os.environ.get('AWS_ENDPOINT_URL')
+
+
+def find_bucket_key(path):
+    parts = path.split('/', 1)
+    if len(parts) == 1:
+        return parts[0], ''
+    return parts[0], parts[1]
+
+
+def split_s3_bucket_key(path):
+    if path.startswith('s3://'):
+        path = path[5:]
+    return find_bucket_key(path)
+
+
+def is_s3express_bucket(bucket):
+    return bucket.endswith('--x-s3')
+
+
+class ClientError(Exception):
+    def __init__(self, code, message, status=400):
+        self.code = code
+        self.message = message
+        self.status = status
+        super().__init__(message)
+
+    def __str__(self):
+        return "An error occurred (%s) when calling the operation: %s" % (
+            self.code, self.message)
+
+
+def strip_ns(tag):
+    if '}' in tag:
+        return tag.split('}', 1)[1]
+    return tag
+
+
+class S3Client:
+    def __init__(self):
+        self.region = get_region()
+        self.access_key = os.environ.get('AWS_ACCESS_KEY_ID', 'testing')
+        self.secret_key = os.environ.get('AWS_SECRET_ACCESS_KEY', 'testing')
+        self.session_token = os.environ.get('AWS_SESSION_TOKEN')
+        endpoint = get_endpoint()
+        if not endpoint:
+            endpoint = 'https://s3.%s.amazonaws.com' % self.region
+        self.endpoint = endpoint.rstrip('/')
+        parsed = urllib.parse.urlparse(self.endpoint)
+        self.scheme = parsed.scheme
+        self.host = parsed.hostname
+        self.port = parsed.port
+
+    def _host_header(self):
+        if self.port:
+            return '%s:%d' % (self.host, self.port)
+        return self.host
+
+    def _sign(self, method, path, query, headers, body):
+        now = datetime.datetime.utcnow()
+        amzdate = now.strftime('%Y%m%dT%H%M%SZ')
+        datestamp = now.strftime('%Y%m%d')
+        payload_hash = hashlib.sha256(body).hexdigest() if body else EMPTY_SHA256
+
+        headers['host'] = self._host_header()
+        headers['x-amz-date'] = amzdate
+        headers['x-amz-content-sha256'] = payload_hash
+        if self.session_token:
+            headers['x-amz-security-token'] = self.session_token
+
+        canonical_uri = urllib.parse.quote(path, safe='/')
+        if query:
+            items = sorted(query.items())
+            canonical_query = '&'.join(
+                '%s=%s' % (urllib.parse.quote(str(k), safe='-_.~'),
+                           urllib.parse.quote(str(v), safe='-_.~'))
+                for k, v in items)
+        else:
+            canonical_query = ''
+
+        signed_names = sorted(h.lower() for h in headers)
+        canonical_headers = ''.join(
+            '%s:%s\n' % (n, headers[n].strip())
+            for n in signed_names)
+        signed_headers = ';'.join(signed_names)
+
+        canonical_request = '\n'.join([
+            method, canonical_uri, canonical_query,
+            canonical_headers, signed_headers, payload_hash])
+
+        cred_scope = '%s/%s/s3/aws4_request' % (datestamp, self.region)
+        string_to_sign = '\n'.join([
+            'AWS4-HMAC-SHA256', amzdate, cred_scope,
+            hashlib.sha256(canonical_request.encode('utf-8')).hexdigest()])
+
+        def hmac_sha(key, msg):
+            return hmac.new(key, msg.encode('utf-8'), hashlib.sha256).digest()
+
+        kdate = hmac_sha(('AWS4' + self.secret_key).encode('utf-8'), datestamp)
+        kregion = hmac_sha(kdate, self.region)
+        kservice = hmac_sha(kregion, 's3')
+        ksigning = hmac_sha(kservice, 'aws4_request')
+        signature = hmac.new(ksigning, string_to_sign.encode('utf-8'),
+                             hashlib.sha256).hexdigest()
+
+        headers['Authorization'] = (
+            'AWS4-HMAC-SHA256 Credential=%s/%s, SignedHeaders=%s, Signature=%s'
+            % (self.access_key, cred_scope, signed_headers, signature))
+        return headers
+
+    def request(self, method, path, query=None, headers=None, body=b''):
+        if headers is None:
+            headers = {}
+        if body is None:
+            body = b''
+        headers = {k: v for k, v in headers.items()}
+        self._sign(method, path, query or {}, headers, body)
+
+        url_path = urllib.parse.quote(path, safe='/')
+        if query:
+            qs = '&'.join(
+                '%s=%s' % (urllib.parse.quote(str(k), safe='-_.~'),
+                           urllib.parse.quote(str(v), safe='-_.~'))
+                for k, v in sorted(query.items()))
+            url_path = url_path + '?' + qs
+
+        if self.scheme == 'https':
+            conn = http.client.HTTPSConnection(self.host, self.port or 443)
+        else:
+            conn = http.client.HTTPConnection(self.host, self.port or 80)
+        try:
+            conn.request(method, url_path, body=body, headers=headers)
+            resp = conn.getresponse()
+            data = resp.read()
+            status = resp.status
+            resp_headers = dict(resp.getheaders())
+        finally:
+            conn.close()
+
+        if status >= 300:
+            code = 'Unknown'
+            message = 'Unknown error'
+            if data:
+                try:
+                    root = ET.fromstring(data)
+                    c = root.find('.//Code')
+                    m = root.find('.//Message')
+                    for el in root.iter():
+                        t = strip_ns(el.tag)
+                        if t == 'Code' and el.text:
+                            code = el.text
+                        elif t == 'Message' and el.text:
+                            message = el.text
+                except ET.ParseError:
+                    pass
+            raise ClientError(code, message, status)
+
+        return status, resp_headers, data
+
+    # Operations
+    def create_bucket(self, bucket):
+        headers = {}
+        body = b''
+        if self.region != 'us-east-1':
+            body = (
+                '<CreateBucketConfiguration xmlns="%s">'
+                '<LocationConstraint>%s</LocationConstraint>'
+                '</CreateBucketConfiguration>' % (S3_NS, self.region)
+            ).encode('utf-8')
+        self.request('PUT', '/' + bucket, headers=headers, body=body)
+
+    def delete_bucket(self, bucket):
+        self.request('DELETE', '/' + bucket)
+
+    def put_object(self, bucket, key, body, extra_headers=None):
+        headers = dict(extra_headers) if extra_headers else {}
+        self.request('PUT', '/%s/%s' % (bucket, key), headers=headers, body=body)
+
+    def get_object(self, bucket, key):
+        status, headers, data = self.request('GET', '/%s/%s' % (bucket, key))
+        return data
+
+    def delete_object(self, bucket, key):
+        self.request('DELETE', '/%s/%s' % (bucket, key))
+
+    def copy_object(self, bucket, key, src_bucket, src_key, extra_headers=None):
+        headers = {'x-amz-copy-source': '/%s/%s' % (src_bucket, src_key)}
+        if extra_headers:
+            headers.update(extra_headers)
+        self.request('PUT', '/%s/%s' % (bucket, key), headers=headers)
+
+    def list_objects_v2(self, bucket, prefix='', delimiter=None):
+        results = []
+        prefixes = []
+        token = None
+        while True:
+            query = {'list-type': '2'}
+            if prefix:
+                query['prefix'] = prefix
+            if delimiter:
+                query['delimiter'] = delimiter
+            if token:
+                query['continuation-token'] = token
+            status, headers, data = self.request('GET', '/' + bucket, query=query)
+            root = ET.fromstring(data)
+            truncated = False
+            next_token = None
+            for el in root:
+                t = strip_ns(el.tag)
+                if t == 'Contents':
+                    key = None
+                    size = 0
+                    lm = ''
+                    for c in el:
+                        ct = strip_ns(c.tag)
+                        if ct == 'Key':
+                            key = c.text
+                        elif ct == 'Size':
+                            size = int(c.text or '0')
+                        elif ct == 'LastModified':
+                            lm = c.text or ''
+                    results.append({'Key': key, 'Size': size, 'LastModified': lm})
+                elif t == 'CommonPrefixes':
+                    for c in el:
+                        if strip_ns(c.tag) == 'Prefix':
+                            prefixes.append(c.text)
+                elif t == 'IsTruncated':
+                    truncated = (el.text == 'true')
+                elif t == 'NextContinuationToken':
+                    next_token = el.text
+            if truncated and next_token:
+                token = next_token
+            else:
+                break
+        return results, prefixes
+
