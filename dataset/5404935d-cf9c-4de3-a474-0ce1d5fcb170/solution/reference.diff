+def do_rb(args):
+    path = None
+    force = False
+    for a in args:
+        if a == '--force':
+            force = True
+        else:
+            path = a
+    if path is None or not path.startswith('s3://'):
+        uni_print("Error: Invalid argument type\n", sys.stderr)
+        return 252
+    bucket, key = split_s3_bucket_key(path)
+    if key:
+        uni_print("Please specify a valid bucket name only. E.g. s3://%s\n" % bucket, sys.stderr)
+        return 252
+    client = S3Client()
+    if force:
+        try:
+            objs, _ = client.list_objects_v2(bucket)
+        except ClientError as e:
+            uni_print("remove_bucket failed: %s %s\n" % (path, e), sys.stderr)
+            return 255
+        for o in objs:
+            try:
+                client.delete_object(bucket, o['Key'])
+                uni_print("delete: s3://%s/%s\n" % (bucket, o['Key']))
+            except ClientError as e:
+                uni_print("delete failed: s3://%s/%s %s\n" % (bucket, o['Key'], e), sys.stderr)
+                return 255
+    try:
+        client.delete_bucket(bucket)
+        uni_print("remove_bucket: %s\n" % bucket)
+        return 0
+    except ClientError as e:
+        uni_print("remove_bucket failed: %s %s\n" % (path, e), sys.stderr)
+        return 1
+
