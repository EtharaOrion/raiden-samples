+#!/usr/bin/env python3
+import sys
+import os
+import hashlib
+import hmac
+import datetime
+import urllib.parse
+import http.client
+import xml.etree.ElementTree as ET
+
+EMPTY_SHA256 = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
+NS = 'http://s3.amazonaws.com/doc/2006-03-01/'
+
+CP_FLAGS = [
+    '--copy-props', '--checksum-algorithm', '--checksum-mode', '--content-type',
+    '--content-encoding', '--content-disposition', '--content-language',
+    '--cache-control', '--expires', '--metadata', '--metadata-directive',
+    '--acl', '--grants', '--content-md5', '--website-redirect',
+    '--storage-class', '--sse-c', '--sse-c-key', '--sse-kms-key-id',
+    '--sse-c-copy-source', '--sse-c-copy-source-key', '--request-payer',
+    '--expected-size', '--page-size', '--sse', '--source-region',
+]
+CP_TAKESVAL = set(CP_FLAGS)
+# flags that don't take a value (store_true)
+CP_BOOL = set([
+    '--quiet', '--only-show-errors', '--no-progress', '--no-guess-mime-type',
+    '--follow-symlinks', '--no-follow-symlinks', '--recursive', '--dryrun',
+    '--force-glacier-transfer', '--ignore-glacier-warnings', '--delete',
+    '--size-only', '--exact-timestamps', '--no-preserve',
+])
+# --exclude / --include take value and are repeatable
+
+
+class ClientError(Exception):
+    def __init__(self, code, message, status=400):
+        self.code = code
+        self.message = message
+        self.status = status
+        super().__init__(message)
+
+    def __str__(self):
+        return ('An error occurred (%s) when calling the operation: %s'
+                % (self.code, self.message))
+
+
+def get_config():
+    ak = os.environ.get('AWS_ACCESS_KEY_ID', 'testing')
+    sk = os.environ.get('AWS_SECRET_ACCESS_KEY', 'testing')
+    st = os.environ.get('AWS_SESSION_TOKEN')
+    region = os.environ.get('AWS_REGION') or os.environ.get('AWS_DEFAULT_REGION') or 'us-east-1'
+    endpoint = os.environ.get('AWS_ENDPOINT_URL_S3') or os.environ.get('AWS_ENDPOINT_URL') or 'https://s3.amazonaws.com'
+    return {'ak': ak, 'sk': sk, 'st': st, 'region': region, 'endpoint': endpoint}
+
+
+def _sign(key, msg):
+    return hmac.new(key, msg.encode('utf-8'), hashlib.sha256).digest()
+
+
+def _sigkey(secret, datestamp, region, service):
+    kd = _sign(('AWS4' + secret).encode('utf-8'), datestamp)
+    kr = _sign(kd, region)
+    ks = _sign(kr, service)
+    return _sign(ks, 'aws4_request')
+
+
+def _uri_encode(s, keep_slash=True):
+    safe = '/' if keep_slash else ''
+    return urllib.parse.quote(s, safe=safe + '-_.~')
+
+
+def s3_request(method, bucket=None, key=None, query=None, body=b'', headers=None):
+    cfg = get_config()
+    if headers is None:
+        headers = {}
+    if query is None:
+        query = {}
+    ep = cfg['endpoint'].rstrip('/')
+    parsed = urllib.parse.urlparse(ep)
+    host = parsed.netloc
+    scheme = parsed.scheme
+
+    path = ''
+    if bucket:
+        path = '/' + bucket
+        if key:
+            path += '/' + key
+    else:
+        path = '/'
+
+    canonical_uri = _uri_encode(path, keep_slash=True)
+    if not canonical_uri:
+        canonical_uri = '/'
+
+    qitems = sorted(query.items())
+    canonical_qs = '&'.join(
+        '%s=%s' % (_uri_encode(k, False), _uri_encode(str(v), False))
+        for k, v in qitems
+    )
+
+    if isinstance(body, str):
+        body = body.encode('utf-8')
+    payload_hash = EMPTY_SHA256 if not body else hashlib.sha256(body).hexdigest()
+
+    now = datetime.datetime.now(datetime.timezone.utc)
+    amzdate = now.strftime('%Y%m%dT%H%M%SZ')
+    datestamp = now.strftime('%Y%m%d')
+
+    hdrs = {}
+    for k, v in headers.items():
+        hdrs[k.lower()] = v
+    hdrs['host'] = host
+    hdrs['x-amz-content-sha256'] = payload_hash
+    hdrs['x-amz-date'] = amzdate
+    if cfg['st']:
+        hdrs['x-amz-security-token'] = cfg['st']
+
+    signed_headers = ';'.join(sorted(hdrs.keys()))
+    canonical_headers = ''.join(
+        '%s:%s\n' % (k, str(hdrs[k]).strip()) for k in sorted(hdrs.keys())
+    )
+    canonical_request = '\n'.join([
+        method, canonical_uri, canonical_qs, canonical_headers,
+        signed_headers, payload_hash
+    ])
+
+    scope = '%s/%s/s3/aws4_request' % (datestamp, cfg['region'])
+    string_to_sign = '\n'.join([
+        'AWS4-HMAC-SHA256', amzdate, scope,
+        hashlib.sha256(canonical_request.encode('utf-8')).hexdigest()
+    ])
+    signing_key = _sigkey(cfg['sk'], datestamp, cfg['region'], 's3')
+    signature = hmac.new(signing_key, string_to_sign.encode('utf-8'),
+                         hashlib.sha256).hexdigest()
+
+    auth = ('AWS4-HMAC-SHA256 Credential=%s/%s, SignedHeaders=%s, Signature=%s'
+            % (cfg['ak'], scope, signed_headers, signature))
+    hdrs['Authorization'] = auth
+
+    url_path = canonical_uri
+    if canonical_qs:
+        url_path += '?' + canonical_qs
+
+    if scheme == 'https':
+        conn = http.client.HTTPSConnection(host, timeout=60)
+    else:
+        conn = http.client.HTTPConnection(host, timeout=60)
+
+    send_headers = {}
+    for k, v in hdrs.items():
+        send_headers[k] = v
+
+    try:
+        conn.request(method, url_path, body=body, headers=send_headers)
+        resp = conn.getresponse()
+        data = resp.read()
+        status = resp.status
+        resp_headers = dict(resp.getheaders())
+    except Exception as e:
+        raise ClientError('EndpointConnectionError', str(e), 0)
+    finally:
+        conn.close()
+
+    if status < 200 or status >= 300:
+        code = 'Unknown'
+        msg = data.decode('utf-8', 'replace') if data else 'HTTP %d' % status
+        if data:
+            try:
+                root = ET.fromstring(data)
+                c = root.find('.//Code')
+                m = root.find('.//Message')
+                if c is not None and c.text:
+                    code = c.text
+                if m is not None and m.text:
+                    msg = m.text
+            except Exception:
+                pass
+        raise ClientError(code, msg, status)
+
+    return status, resp_headers, data
+
+
+def strip_ns(tag):
+    if '}' in tag:
+        return tag.split('}', 1)[1]
+    return tag
+
+
+def find_bucket_key(path):
+    if path.startswith('s3://'):
+        path = path[5:]
+    parts = path.split('/', 1)
+    bucket = parts[0]
+    key = parts[1] if len(parts) > 1 else ''
+    return bucket, key
+
+
+def is_s3express(bucket):
+    return '--x-s3' in bucket
+
+
+# ------------------ ls ------------------
+
+def make_last_mod_str(dt):
+    return dt
+
+
+def cmd_ls(args):
+    import argparse
+    p = argparse.ArgumentParser(prog='aws s3 ls', add_help=False)
+    p.add_argument('paths', nargs='?', default='s3://')
+    p.add_argument('--recursive', action='store_true', dest='dir_op')
+    p.add_argument('--human-readable', action='store_true')
+    p.add_argument('--summarize', action='store_true')
+    p.add_argument('--page-size', type=int, default=None)
+    p.add_argument('--request-payer', nargs='?', default=None)
+    p.add_argument('--bucket-name-prefix', default=None)
+    p.add_argument('--bucket-region', default=None)
+    try:
+        parsed, unknown = p.parse_known_args(args)
+    except SystemExit:
+        sys.exit(252)
+    for u in unknown:
+        if u.startswith('-'):
+            sys.stderr.write("Unknown options: %s\n" % u)
+            sys.exit(252)
+
+    path = parsed.paths
+    if path.startswith('s3://'):
+        path = path[5:]
+    bucket, key = find_bucket_key(path)
+
+    try:
+        if not bucket:
+            list_all_buckets()
+        elif parsed.dir_op:
+            list_objects_recursive(bucket, key)
+        else:
+            list_objects(bucket, key)
+    except ClientError as e:
+        sys.stderr.write('\n' + str(e) + '\n')
+        sys.exit(1)
+
+    if key:
+        return _check_no_objects()
+    return 0
+
+
+_ls_had_results = False
+
+
+def _check_no_objects():
+    global _ls_had_results
+    if not _ls_had_results:
+        return 1
+    return 0
+
+
+def list_all_buckets():
+    global _ls_had_results
+    status, hdrs, data = s3_request('GET')
+    root = ET.fromstring(data)
+    for b in root.iter():
+        if strip_ns(b.tag) == 'Bucket':
+            name = None
+            date = None
+            for c in b:
+                t = strip_ns(c.tag)
+                if t == 'Name':
+                    name = c.text
+                elif t == 'CreationDate':
+                    date = c.text
+            ds = fmt_date(date)
+            sys.stdout.write('%s %s\n' % (ds, name))
+            _ls_had_results = True
+
+
+def fmt_date(iso):
+    if not iso:
+        return '                   '
+    try:
+        s = iso.replace('Z', '')
+        if '.' in s:
+            s = s.split('.')[0]
+        dt = datetime.datetime.strptime(s, '%Y-%m-%dT%H:%M:%S')
+        return dt.strftime('%Y-%m-%d %H:%M:%S')
+    except Exception:
+        return iso
+
+
+def list_objects(bucket, key):
+    global _ls_had_results
+    query = {'list-type': '2', 'prefix': key, 'delimiter': '/'}
+    cont = None
+    while True:
+        q = dict(query)
+        if cont:
+            q['continuation-token'] = cont
+        status, hdrs, data = s3_request('GET', bucket=bucket, query=q)
+        root = ET.fromstring(data)
+        prefixes = []
+        contents = []
+        truncated = False
+        nexttok = None
+        for c in root:
+            t = strip_ns(c.tag)
+            if t == 'CommonPrefixes':
+                for cc in c:
+                    if strip_ns(cc.tag) == 'Prefix':
+                        prefixes.append(cc.text)
+            elif t == 'Contents':
+                contents.append(c)
+            elif t == 'IsTruncated':
+                truncated = (c.text == 'true')
+            elif t == 'NextContinuationToken':
+                nexttok = c.text
+        for pr in prefixes:
+            display = pr
+            if key and display.startswith(key):
+                display = display[len(key):]
+            sys.stdout.write('%s%s\n' % (' ' * 27 + 'PRE ', display))
+            _ls_had_results = True
+        for cont_el in contents:
+            okey = None
+            lm = None
+            size = 0
+            for cc in cont_el:
+                tt = strip_ns(cc.tag)
+                if tt == 'Key':
+                    okey = cc.text
+                elif tt == 'LastModified':
+                    lm = cc.text
+                elif tt == 'Size':
+                    size = int(cc.text or '0')
+            display = okey
+            if key and display.startswith(key):
+                display = display[len(key):]
+            if display == '':
+                display = okey.split('/')[-1]
+            sys.stdout.write('%s %10d %s\n' % (fmt_date(lm), size, display))
+            _ls_had_results = True
+        if truncated and nexttok:
+            cont = nexttok
+        else:
+            break
+
+
+def list_objects_recursive(bucket, key):
+    global _ls_had_results
+    query = {'list-type': '2', 'prefix': key}
+    cont = None
+    while True:
+        q = dict(query)
+        if cont:
+            q['continuation-token'] = cont
+        status, hdrs, data = s3_request('GET', bucket=bucket, query=q)
+        root = ET.fromstring(data)
+        truncated = False
+        nexttok = None
+        for c in root:
+            t = strip_ns(c.tag)
+            if t == 'Contents':
+                okey = None
+                lm = None
+                size = 0
+                for cc in c:
+                    tt = strip_ns(cc.tag)
+                    if tt == 'Key':
+                        okey = cc.text
+                    elif tt == 'LastModified':
+                        lm = cc.text
+                    elif tt == 'Size':
+                        size = int(cc.text or '0')
+                sys.stdout.write('%s %10d %s\n' % (fmt_date(lm), size, okey))
+                _ls_had_results = True
+            elif t == 'IsTruncated':
+                truncated = (c.text == 'true')
+            elif t == 'NextContinuationToken':
+                nexttok = c.text
+        if truncated and nexttok:
+            cont = nexttok
+        else:
+            break
+
+
+# ------------------ mb ------------------
+
+def cmd_mb(args):
+    import argparse
+    p = argparse.ArgumentParser(prog='aws s3 mb', add_help=False)
+    p.add_argument('path')
+    p.add_argument('--region', default=None)
+    p.add_argument('--endpoint-url', default=None)
+    try:
+        parsed, unknown = p.parse_known_args(args)
+    except SystemExit:
+        sys.exit(252)
+    for u in unknown:
+        if u.startswith('-'):
+            sys.stderr.write("Unknown options: %s\n" % u)
+            sys.exit(252)
+
+    usage = ("\nusage: aws s3 mb <S3Uri> [--options]\n")
+    if not parsed.path.startswith('s3://'):
+        sys.stderr.write(usage + "Error: Invalid argument type\n")
+        sys.exit(252)
+
+    bucket, _ = find_bucket_key(parsed.path)
+
+    if is_s3express(bucket):
+        sys.stderr.write("Cannot use mb command with a directory bucket.\n")
+        sys.exit(252)
+
+    region = parsed.region or get_config()['region']
+
+    body = b''
+    if region != 'us-east-1':
+        body = ('<CreateBucketConfiguration xmlns="%s">'
+                '<LocationConstraint>%s</LocationConstraint>'
+                '</CreateBucketConfiguration>' % (NS, region)).encode('utf-8')
+
+    try:
+        s3_request('PUT', bucket=bucket, body=body)
+        sys.stdout.write("make_bucket: %s\n" % bucket)
+        return 0
+    except ClientError as e:
+        sys.stderr.write("make_bucket failed: %s %s\n" % (parsed.path, str(e)))
+        return 1
+
+
+# ------------------ transfer parsing ------------------
+
+def parse_transfer_args(args):
+    result = {'positionals': [], 'recursive': False, 'dryrun': False,
+              'exclude': [], 'include': [], 'flags': {}}
+    i = 0
+    while i < len(args):
+        a = args[i]
+        if a == '--recursive':
+            result['recursive'] = True
+        elif a == '--dryrun':
+            result['dryrun'] = True
+        elif a in ('--exclude', '--include'):
+            if i + 1 >= len(args):
+                sys.exit(2)
+            i += 1
+            result[a[2:]].append(args[i])
+        elif a in CP_BOOL:
+            result['flags'][a] = True
+        elif a in CP_TAKESVAL:
+            if i + 1 < len(args):
+                i += 1
+                result['flags'][a] = args[i]
+        elif a.startswith('--') and '=' in a:
+            k, v = a.split('=', 1)
+            result['flags'][k] = v
+        elif a.startswith('-') and a != '-':
+            # unknown flag: tolerate; consume optional value
+            if i + 1 < len(args) and not args[i + 1].startswith('-'):
+                i += 1
+        else:
+            result['positionals'].append(a)
+        i += 1
+    return result
+
+
+def is_s3(p):
+    return p.startswith('s3://')
+
+
+# ------------------ cp ------------------
+
+def cmd_cp(args):
+    r = parse_transfer_args(args)
+    pos = r['positionals']
+    if len(pos) < 2:
+        sys.stderr.write("\nusage: aws s3 cp <LocalPath> <S3Uri> or <S3Uri> <LocalPath> "
+                         "or <S3Uri> <S3Uri>\n")
+        sys.exit(252)
+    src, dst = pos[0], pos[1]
+
+    src_s3 = is_s3(src)
+    dst_s3 = is_s3(dst)
+
+    # stream cases
+    if src == '-' and dst_s3:
+        return _upload_stream(dst, r)
+    if dst == '-' and src_s3:
+        return _download_stream(src, r)
+
+    if not src_s3 and dst_s3:
+        return _do_upload(src, dst, r)
+    elif src_s3 and not dst_s3:
+        return _do_download(src, dst, r)
+    elif src_s3 and dst_s3:
+        return _do_copy(src, dst, r)
+    else:
+        sys.stderr.write("\nusage: aws s3 cp <LocalPath> <S3Uri>\n")
+        sys.exit(2)
+
+
+def _resolve_dest_key(dst, src_basename):
+    bucket, key = find_bucket_key(dst)
+    if key == '' or key.endswith('/'):
+        key = key + src_basename
+    return bucket, key
+
+
+# real aws-cli defaults: multipart_threshold=8MiB, multipart_chunksize=8MiB
+MULTIPART_THRESHOLD = 8 * 1024 * 1024
+MULTIPART_CHUNKSIZE = 8 * 1024 * 1024
+
+
+def _build_put_headers(r):
+    """Map cp/mv/sync flags to S3 PUT request headers (SSE, content-type, ...)."""
+    h = {}
+    flags = r['flags']
+    sse = flags.get('--sse')
+    if sse is not None:
+        h['x-amz-server-side-encryption'] = sse if sse else 'AES256'
+    if flags.get('--sse-kms-key-id'):
+        h['x-amz-server-side-encryption-aws-kms-key-id'] = flags['--sse-kms-key-id']
+    if flags.get('--content-type'):
+        h['content-type'] = flags['--content-type']
+    if flags.get('--website-redirect'):
+        h['x-amz-website-redirect-location'] = flags['--website-redirect']
+    if flags.get('--storage-class'):
+        h['x-amz-storage-class'] = flags['--storage-class']
+    if flags.get('--cache-control'):
+        h['cache-control'] = flags['--cache-control']
+    if flags.get('--content-disposition'):
+        h['content-disposition'] = flags['--content-disposition']
+    if flags.get('--content-encoding'):
+        h['content-encoding'] = flags['--content-encoding']
+    if flags.get('--content-language'):
+        h['content-language'] = flags['--content-language']
+    return h
+
+
+def _hdr_get(headers, name):
+    for hk, hv in headers.items():
+        if hk.lower() == name.lower():
+            return hv
+    return None
+
+
+def _multipart_upload(bucket, key, body, extra_headers):
+    """Perform a real S3 multipart upload so moto returns an ETag '<md5>-<N>'."""
+    # 1. initiate (preserve SSE/content-type etc on create)
+    status, hdrs, data = s3_request('POST', bucket=bucket, key=key,
+                                    query={'uploads': ''}, headers=extra_headers)
+    root = ET.fromstring(data)
+    upload_id = None
+    for el in root.iter():
+        if strip_ns(el.tag) == 'UploadId':
+            upload_id = el.text
+            break
+    if not upload_id:
+        raise ClientError('InternalError', 'no UploadId returned', 500)
+    # 2. upload each 8MiB part (part numbers start at 1)
+    parts = []
+    offset = 0
+    part_num = 1
+    while offset < len(body):
+        chunk = body[offset:offset + MULTIPART_CHUNKSIZE]
+        offset += MULTIPART_CHUNKSIZE
+        st, ph, pd = s3_request('PUT', bucket=bucket, key=key,
+                                query={'partNumber': str(part_num),
+                                       'uploadId': upload_id},
+                                body=chunk)
+        etag = _hdr_get(ph, 'ETag')
+        parts.append((part_num, etag))
+        part_num += 1
+    # 3. complete
+    xml = ['<CompleteMultipartUpload>']
+    for pn, et in parts:
+        xml.append('<Part><PartNumber>%d</PartNumber><ETag>%s</ETag></Part>' % (pn, et))
+    xml.append('</CompleteMultipartUpload>')
+    s3_request('POST', bucket=bucket, key=key, query={'uploadId': upload_id},
+               body=''.join(xml).encode('utf-8'))
+
+
+def _upload_stream(dst, r):
+    body = sys.stdin.buffer.read()
+    bucket, key = find_bucket_key(dst)
+    if key == '' or key.endswith('/'):
+        sys.stderr.write("\nupload failed: streaming requires a key\n")
+        sys.exit(1)
+    if r['dryrun']:
+        sys.stdout.write("(dryrun) upload: - to s3://%s/%s\n" % (bucket, key))
+        return 0
+    try:
+        s3_request('PUT', bucket=bucket, key=key, body=body)
+    except ClientError as e:
+        sys.stderr.write("upload failed: - to s3://%s/%s %s\n" % (bucket, key, str(e)))
+        return 1
+    return 0
+
+
+def _download_stream(src, r):
+    bucket, key = find_bucket_key(src)
+    if r['dryrun']:
+        return 0
+    try:
+        status, hdrs, data = s3_request('GET', bucket=bucket, key=key)
+    except ClientError as e:
+        sys.stderr.write("download failed: s3://%s/%s to - %s\n" % (bucket, key, str(e)))
+        return 1
+    sys.stdout.buffer.write(data)
+    return 0
+
+
+def _do_upload(src, dst, r):
+    if r['recursive']:
+        return _upload_recursive(src, dst, r)
+    if not os.path.isfile(src):
+        sys.stderr.write("\nupload failed: %s The user-provided path %s does not exist.\n"
+                         % (src, src))
+        sys.exit(1)
+    basename = os.path.basename(src)
+    bucket, key = _resolve_dest_key(dst, basename)
+    if r['dryrun']:
+        sys.stdout.write("(dryrun) upload: %s to s3://%s/%s\n" % (src, bucket, key))
+        return 0
+    extra = _build_put_headers(r)
+    try:
+        with open(src, 'rb') as f:
+            body = f.read()
+        if len(body) >= MULTIPART_THRESHOLD:
+            _multipart_upload(bucket, key, body, extra)
+        else:
+            s3_request('PUT', bucket=bucket, key=key, body=body, headers=extra)
+    except ClientError as e:
+        sys.stderr.write("upload failed: %s to s3://%s/%s %s\n" % (src, bucket, key, str(e)))
+        return 1
+    sys.stdout.write("upload: %s to s3://%s/%s\n" % (src, bucket, key))
+    return 0
+
+
+def _upload_recursive(src, dst, r):
+    bucket, prefix = find_bucket_key(dst)
+    rc = 0
+    for root, dirs, files in os.walk(src):
+        for fn in files:
+            full = os.path.join(root, fn)
+            rel = os.path.relpath(full, src).replace(os.sep, '/')
+            key = (prefix.rstrip('/') + '/' + rel) if prefix else rel
+            if r['dryrun']:
+                sys.stdout.write("(dryrun) upload: %s to s3://%s/%s\n" % (full, bucket, key))
+                continue
+            try:
+                with open(full, 'rb') as f:
+                    body = f.read()
+                s3_request('PUT', bucket=bucket, key=key, body=body)
+                sys.stdout.write("upload: %s to s3://%s/%s\n" % (full, bucket, key))
+            except ClientError as e:
+                sys.stderr.write("upload failed: %s to s3://%s/%s %s\n"
+                                 % (full, bucket, key, str(e)))
+                rc = 1
+    return rc
+
+
+def _do_download(src, dst, r):
+    if r['recursive']:
+        return _download_recursive(src, dst, r)
+    bucket, key = find_bucket_key(src)
+    if dst.endswith('/') or os.path.isdir(dst):
+        outpath = os.path.join(dst, os.path.basename(key))
+    else:
+        outpath = dst
+    if r['dryrun']:
+        sys.stdout.write("(dryrun) download: s3://%s/%s to %s\n" % (bucket, key, outpath))
+        return 0
+    try:
+        status, hdrs, data = s3_request('GET', bucket=bucket, key=key)
+    except ClientError as e:
+        sys.stderr.write("download failed: s3://%s/%s to %s %s\n"
+                         % (bucket, key, outpath, str(e)))
+        return 1
+    d = os.path.dirname(outpath)
+    if d and not os.path.exists(d):
+        os.makedirs(d, exist_ok=True)
+    with open(outpath, 'wb') as f:
+        f.write(data)
+    sys.stdout.write("download: s3://%s/%s to %s\n" % (bucket, key, outpath))
+    return 0
+
+
+def _download_recursive(src, dst, r):
+    bucket, prefix = find_bucket_key(src)
+    keys = _list_keys(bucket, prefix)
+    rc = 0
+    for k, size, lm in keys:
+        rel = k[len(prefix):] if prefix and k.startswith(prefix) else k
+        rel = rel.lstrip('/')
+        outpath = os.path.join(dst, rel)
+        if r['dryrun']:
+            sys.stdout.write("(dryrun) download: s3://%s/%s to %s\n" % (bucket, k, outpath))
+            continue
+        try:
+            status, hdrs, data = s3_request('GET', bucket=bucket, key=k)
+            d = os.path.dirname(outpath)
+            if d and not os.path.exists(d):
+                os.makedirs(d, exist_ok=True)
+            with open(outpath, 'wb') as f:
+                f.write(data)
+            sys.stdout.write("download: s3://%s/%s to %s\n" % (bucket, k, outpath))
+        except ClientError as e:
+            sys.stderr.write("download failed: s3://%s/%s to %s %s\n"
+                             % (bucket, k, outpath, str(e)))
+            rc = 1
+    return rc
+
+
+def _do_copy(src, dst, r):
+    sbucket, skey = find_bucket_key(src)
+    dbucket, dkey = _resolve_dest_key(dst, os.path.basename(skey))
+    if r['dryrun']:
+        sys.stdout.write("(dryrun) copy: s3://%s/%s to s3://%s/%s\n"
+                         % (sbucket, skey, dbucket, dkey))
+        return 0
+    try:
+        headers = {'x-amz-copy-source': '/' + sbucket + '/' + urllib.parse.quote(skey)}
+        s3_request('PUT', bucket=dbucket, key=dkey, headers=headers)
+    except ClientError as e:
+        sys.stderr.write("copy failed: s3://%s/%s to s3://%s/%s %s\n"
+                         % (sbucket, skey, dbucket, dkey, str(e)))
+        return 1
+    sys.stdout.write("copy: s3://%s/%s to s3://%s/%s\n"
+                     % (sbucket, skey, dbucket, dkey))
+    return 0
+
+
+def _list_keys(bucket, prefix):
+    keys = []
+    query = {'list-type': '2', 'prefix': prefix}
+    cont = None
+    while True:
+        q = dict(query)
+        if cont:
+            q['continuation-token'] = cont
+        status, hdrs, data = s3_request('GET', bucket=bucket, query=q)
+        root = ET.fromstring(data)
+        truncated = False
+        nexttok = None
+        for c in root:
+            t = strip_ns(c.tag)
+            if t == 'Contents':
+                okey = None
+                lm = None
+                size = 0
+                for cc in c:
+                    tt = strip_ns(cc.tag)
+                    if tt == 'Key':
+                        okey = cc.text
+                    elif tt == 'LastModified':
+                        lm = cc.text
+                    elif tt == 'Size':
+                        size = int(cc.text or '0')
+                keys.append((okey, size, lm))
+            elif t == 'IsTruncated':
+                truncated = (c.text == 'true')
+            elif t == 'NextContinuationToken':
+                nexttok = c.text
+        if truncated and nexttok:
+            cont = nexttok
+        else:
+            break
+    return keys
+
+
+# ------------------ mv ------------------
+
+def cmd_mv(args):
+    r = parse_transfer_args(args)
+    pos = r['positionals']
+    if len(pos) < 2:
+        sys.stderr.write("\nusage: aws s3 mv <src> <dst>\n")
+        sys.exit(252)
+    src, dst = pos[0], pos[1]
+    src_s3 = is_s3(src)
+    dst_s3 = is_s3(dst)
+
+    if src_s3 and dst_s3:
+        sbucket, skey = find_bucket_key(src)
+        dbucket, dkey = _resolve_dest_key(dst, os.path.basename(skey))
+        if sbucket == dbucket and skey == dkey:
+            sys.stderr.write("\nCannot mv a file onto itself.\n")
+            sys.exit(252)
+        if r['dryrun']:
+            sys.stdout.write("(dryrun) move: s3://%s/%s to s3://%s/%s\n"
+                             % (sbucket, skey, dbucket, dkey))
+            return 0
+        try:
+            headers = {'x-amz-copy-source': '/' + sbucket + '/' + urllib.parse.quote(skey)}
+            s3_request('PUT', bucket=dbucket, key=dkey, headers=headers)
+            s3_request('DELETE', bucket=sbucket, key=skey)
+        except ClientError as e:
+            sys.stderr.write("move failed: s3://%s/%s to s3://%s/%s %s\n"
+                             % (sbucket, skey, dbucket, dkey, str(e)))
+            return 1
+        sys.stdout.write("move: s3://%s/%s to s3://%s/%s\n"
+                         % (sbucket, skey, dbucket, dkey))
+        return 0
+    elif not src_s3 and dst_s3:
+        if not os.path.isfile(src):
+            sys.stderr.write("\nmove failed: %s does not exist.\n" % src)
+            sys.exit(1)
+        bucket, key = _resolve_dest_key(dst, os.path.basename(src))
+        if r['dryrun']:
+            sys.stdout.write("(dryrun) move: %s to s3://%s/%s\n" % (src, bucket, key))
+            return 0
+        try:
+            with open(src, 'rb') as f:
+                body = f.read()
+            s3_request('PUT', bucket=bucket, key=key, body=body)
+        except ClientError as e:
+            sys.stderr.write("move failed: %s to s3://%s/%s %s\n"
+                             % (src, bucket, key, str(e)))
+            return 1
+        os.remove(src)
+        sys.stdout.write("move: %s to s3://%s/%s\n" % (src, bucket, key))
+        return 0
+    elif src_s3 and not dst_s3:
+        bucket, key = find_bucket_key(src)
+        if dst.endswith('/') or os.path.isdir(dst):
+            outpath = os.path.join(dst, os.path.basename(key))
+        else:
+            outpath = dst
+        if r['dryrun']:
+            sys.stdout.write("(dryrun) move: s3://%s/%s to %s\n" % (bucket, key, outpath))
+            return 0
+        try:
+            status, hdrs, data = s3_request('GET', bucket=bucket, key=key)
+            d = os.path.dirname(outpath)
+            if d and not os.path.exists(d):
+                os.makedirs(d, exist_ok=True)
+            with open(outpath, 'wb') as f:
+                f.write(data)
+            s3_request('DELETE', bucket=bucket, key=key)
+        except ClientError as e:
+            sys.stderr.write("move failed: s3://%s/%s to %s %s\n"
+                             % (bucket, key, outpath, str(e)))
+            return 1
+        sys.stdout.write("move: s3://%s/%s to %s\n" % (bucket, key, outpath))
+        return 0
+    else:
+        sys.stderr.write("\nusage: aws s3 mv <src> <dst>\n")
+        sys.exit(252)
+
+
+# ------------------ sync ------------------
+
+def cmd_sync(args):
+    r = parse_transfer_args(args)
+    pos = r['positionals']
+    if r['recursive']:
+        sys.stderr.write("\nusage: aws s3 sync <LocalPath> <S3Uri> or <S3Uri> <LocalPath> "
+                         "or <S3Uri> <S3Uri>\nUnknown options: --recursive\n")
+        sys.exit(252)
+    if len(pos) < 2:
+        sys.stderr.write("\nusage: aws s3 sync <src> <dst>\n")
+        sys.exit(252)
+    src, dst = pos[0], pos[1]
+    src_s3 = is_s3(src)
+    dst_s3 = is_s3(dst)
+
+    if not src_s3 and dst_s3:
+        return _sync_upload(src, dst, r)
+    elif src_s3 and not dst_s3:
+        return _sync_download(src, dst, r)
+    elif src_s3 and dst_s3:
+        return _sync_s3s3(src, dst, r)
+    else:
+        sys.stderr.write("\nusage: aws s3 sync <src> <dst>\n")
+        sys.exit(255)
+
+
+def _sync_upload(src, dst, r):
+    if not os.path.isdir(src):
+        sys.stderr.write("\nThe user-provided path %s does not exist.\n" % src)
+        sys.exit(255)
+    bucket, prefix = find_bucket_key(dst)
+    # sync requires dest to be a prefix (directory)
+    existing = {}
+    try:
+        for k, size, lm in _list_keys(bucket, prefix):
+            existing[k] = size
+    except ClientError as e:
+        sys.stderr.write("\n" + str(e) + "\n")
+        sys.exit(2)
+    rc = 0
+    for root, dirs, files in os.walk(src):
+        for fn in files:
+            full = os.path.join(root, fn)
+            rel = os.path.relpath(full, src).replace(os.sep, '/')
+            key = (prefix.rstrip('/') + '/' + rel) if prefix else rel
+            lsize = os.path.getsize(full)
+            if key in existing and existing[key] == lsize:
+                continue
+            if r['dryrun']:
+                sys.stdout.write("(dryrun) upload: %s to s3://%s/%s\n" % (full, bucket, key))
+                continue
+            try:
+                with open(full, 'rb') as f:
+                    body = f.read()
+                s3_request('PUT', bucket=bucket, key=key, body=body)
+                sys.stdout.write("upload: %s to s3://%s/%s\n" % (full, bucket, key))
+            except ClientError as e:
+                sys.stderr.write("upload failed: %s to s3://%s/%s %s\n"
+                                 % (full, bucket, key, str(e)))
+                rc = 1
+    return rc
+
+
+def _sync_download(src, dst, r):
+    bucket, prefix = find_bucket_key(src)
+    try:
+        keys = _list_keys(bucket, prefix)
+    except ClientError as e:
+        sys.stderr.write("\n" + str(e) + "\n")
+        sys.exit(2)
+    rc = 0
+    for k, size, lm in keys:
+        rel = k[len(prefix):] if prefix and k.startswith(prefix) else k
+        rel = rel.lstrip('/')
+        outpath = os.path.join(dst, rel)
+        if os.path.isfile(outpath) and os.path.getsize(outpath) == size:
+            continue
+        if r['dryrun']:
+            sys.stdout.write("(dryrun) download: s3://%s/%s to %s\n" % (bucket, k, outpath))
+            continue
+        try:
+            status, hdrs, data = s3_request('GET', bucket=bucket, key=k)
+            d = os.path.dirname(outpath)
+            if d and not os.path.exists(d):
+                os.makedirs(d, exist_ok=True)
+            with open(outpath, 'wb') as f:
+                f.write(data)
+            sys.stdout.write("download: s3://%s/%s to %s\n" % (bucket, k, outpath))
+        except ClientError as e:
+            sys.stderr.write("download failed: s3://%s/%s to %s %s\n"
+                             % (bucket, k, outpath, str(e)))
+            rc = 1
+    return rc
+
+
+def _sync_s3s3(src, dst, r):
+    sbucket, sprefix = find_bucket_key(src)
+    dbucket, dprefix = find_bucket_key(dst)
+    try:
+        skeys = _list_keys(sbucket, sprefix)
+        dexisting = {}
+        for k, size, lm in _list_keys(dbucket, dprefix):
+            dexisting[k] = size
+    except ClientError as e:
+        sys.stderr.write("\n" + str(e) + "\n")
+        sys.exit(2)
+    rc = 0
+    for k, size, lm in skeys:
+        rel = k[len(sprefix):] if sprefix and k.startswith(sprefix) else k
+        rel = rel.lstrip('/')
+        dkey = (dprefix.rstrip('/') + '/' + rel) if dprefix else rel
+        if dkey in dexisting and dexisting[dkey] == size:
+            continue
+        if r['dryrun']:
+            sys.stdout.write("(dryrun) copy: s3://%s/%s to s3://%s/%s\n"
+                             % (sbucket, k, dbucket, dkey))
+            continue
+        try:
+            headers = {'x-amz-copy-source': '/' + sbucket + '/' + urllib.parse.quote(k)}
+            s3_request('PUT', bucket=dbucket, key=dkey, headers=headers)
+            sys.stdout.write("copy: s3://%s/%s to s3://%s/%s\n"
+                             % (sbucket, k, dbucket, dkey))
+        except ClientError as e:
+            sys.stderr.write("copy failed: s3://%s/%s to s3://%s/%s %s\n"
+                             % (sbucket, k, dbucket, dkey, str(e)))
+            rc = 1
+    return rc
+
+
+# ------------------ main ------------------
+
+def main():
+    argv = sys.argv
+    if len(argv) < 2:
+        sys.stderr.write("usage: aws <command> <subcommand> [args]\n")
+        sys.exit(2)
+    if argv[1] != 's3':
+        sys.stderr.write("Invalid choice: '%s'\n" % argv[1])
+        sys.exit(2)
+    if len(argv) < 3:
+        sys.stderr.write("usage: aws s3 <subcommand> [args]\n")
+        sys.exit(2)
+    sub = argv[2]
+    rest = argv[3:]
+
+    try:
+        if sub == 'ls':
+            rc = cmd_ls(rest)
+        elif sub == 'mb':
+            rc = cmd_mb(rest)
+        elif sub == 'cp':
+            rc = cmd_cp(rest)
+        elif sub == 'mv':
+            rc = cmd_mv(rest)
+        elif sub == 'sync':
+            rc = cmd_sync(rest)
+        else:
+            sys.stderr.write("Invalid choice: '%s'\n" % sub)
+            sys.exit(2)
+    except SystemExit:
+        raise
+    except ClientError as e:
+        sys.stderr.write(str(e) + "\n")
+        sys.exit(1)
+    except BrokenPipeError:
+        sys.exit(0)
+    except Exception as e:
+        sys.stderr.write(str(e) + "\n")
+        sys.exit(1)
+
+    sys.exit(rc if rc else 0)
+
+
+if __name__ == '__main__':
+    main()
