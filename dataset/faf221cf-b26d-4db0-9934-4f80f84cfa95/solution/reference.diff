+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+SPECS = {
+    "delete-item": {
+        "target": "DeleteItem",
+        "flags": {
+            "condition-expression": ("ConditionExpression", "str"),
+            "conditional-operator": ("ConditionalOperator", "str"),
+            "expected": ("Expected", "json"),
+            "expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "key": ("Key", "json"),
+            "return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+            "return-values": ("ReturnValues", "str"),
+            "return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+            "table-name": ("TableName", "str"),
+        },
+    },
+    "get-item": {
+        "target": "GetItem",
+        "flags": {
+            "attributes-to-get": ("AttributesToGet", "json"),
+            "consistent-read": ("ConsistentRead", "bool"),
+            "expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "key": ("Key", "json"),
+            "projection-expression": ("ProjectionExpression", "str"),
+            "return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "table-name": ("TableName", "str"),
+        },
+    },
+    "list-tables": {
+        "target": "ListTables",
+        "flags": {
+            "exclusive-start-table-name": ("ExclusiveStartTableName", "str"),
+            "limit": ("Limit", "int"),
+        },
+    },
+    "put-item": {
+        "target": "PutItem",
+        "flags": {
+            "condition-expression": ("ConditionExpression", "str"),
+            "conditional-operator": ("ConditionalOperator", "str"),
+            "expected": ("Expected", "json"),
+            "expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "item": ("Item", "json"),
+            "return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+            "return-values": ("ReturnValues", "str"),
+            "return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+            "table-name": ("TableName", "str"),
+        },
+    },
+    "update-item": {
+        "target": "UpdateItem",
+        "flags": {
+            "attribute-updates": ("AttributeUpdates", "json"),
+            "condition-expression": ("ConditionExpression", "str"),
+            "conditional-operator": ("ConditionalOperator", "str"),
+            "expected": ("Expected", "json"),
+            "expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "key": ("Key", "json"),
+            "return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+            "return-values": ("ReturnValues", "str"),
+            "return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+            "table-name": ("TableName", "str"),
+            "update-expression": ("UpdateExpression", "str"),
+        },
+    },
+}
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: " + msg + "\n")
+    sys.exit(252)
+
+
+def parse_args(spec, argv):
+    flags = spec["flags"]
+    result = {}
+    seen = set()
+    i = 0
+    n = len(argv)
+    while i < n:
+        tok = argv[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: " + tok)
+        name = tok[2:]
+        if name not in flags:
+            usage_error("unknown option: " + tok)
+        field, typ = flags[name]
+        if name in seen:
+            usage_error("duplicate option: " + tok)
+        seen.add(name)
+        if typ == "bool":
+            result[field] = True
+            i += 1
+            continue
+        if i + 1 >= n:
+            usage_error("missing value for: " + tok)
+        val = argv[i + 1]
+        i += 2
+        if typ == "str":
+            if val == "":
+                usage_error("empty value for: " + tok)
+            result[field] = val
+        elif typ == "int":
+            try:
+                result[field] = int(val)
+            except ValueError:
+                usage_error("invalid integer for: " + tok)
+        elif typ == "json":
+            try:
+                result[field] = json.loads(val)
+            except Exception:
+                usage_error("invalid JSON for: " + tok)
+    return result
+
+
+def call(target, payload):
+    endpoint = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ["AWS_ENDPOINT_URL"]
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + target)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20120810/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=host;x-amz-date;x-amz-target, Signature=dummy")
+    req.add_header("X-Amz-Date", "20120810T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        return 0, body
+    except urllib.error.HTTPError as e:
+        body = e.read().decode("utf-8")
+        code = "Unknown"
+        try:
+            j = json.loads(body)
+            t = j.get("__type") or j.get("code") or ""
+            if t:
+                code = t.split("#")[-1]
+            msg = j.get("message") or j.get("Message") or ""
+        except Exception:
+            msg = body
+        sys.stderr.write("An error occurred (" + code + "): " + msg + "\n")
+        return 254, None
+    except Exception as e:
+        sys.stderr.write("An error occurred: " + str(e) + "\n")
+        return 254, None
+
+
+def main():
+    if len(sys.argv) < 3:
+        usage_error("missing command")
+    sub = sys.argv[2]
+    if sub not in SPECS:
+        usage_error("unknown subcommand: " + sub)
+    spec = SPECS[sub]
+    args = parse_args(spec, sys.argv[3:])
+    rc, body = call(spec["target"], args)
+    if rc != 0:
+        sys.exit(rc)
+    if body:
+        try:
+            obj = json.loads(body)
+        except Exception:
+            obj = {}
+        if obj:
+            sys.stdout.write(json.dumps(obj, indent=4) + "\n")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
