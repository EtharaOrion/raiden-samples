+#!/usr/bin/env python3
+import sys
+import os
+import hashlib
+import hmac
+import datetime
+import urllib.parse
+import http.client
+import xml.etree.ElementTree as ET
+
+S3_NS = 'http://s3.amazonaws.com/doc/2006-03-01/'
+EMPTY_SHA256 = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
+
+
+def uni_print(s, stream=None):
+    if stream is None:
+        stream = sys.stdout
+    stream.write(s)
+    stream.flush()
+
+
+class ClientError(Exception):
+    def __init__(self, code, message, status=400):
+        self.code = code
+        self.message = message
+        self.status = status
+        super().__init__(message)
+
+    def __str__(self):
+        return "An error occurred (%s) when calling operation: %s" % (
+            self.code, self.message)
+
+
+def find_bucket_key(path):
+    parts = path.split('/', 1)
+    bucket = parts[0]
+    key = parts[1] if len(parts) > 1 else ''
+    return bucket, key
+
+
+def split_s3_bucket_key(path):
+    if path.startswith('s3://'):
+        path = path[5:]
+    return find_bucket_key(path)
+
+
+def is_s3express_bucket(bucket):
+    return bucket.endswith('--x-s3')
+
+
+class Config:
+    def __init__(self):
+        self.access_key = os.environ.get('AWS_ACCESS_KEY_ID', 'testing')
+        self.secret_key = os.environ.get('AWS_SECRET_ACCESS_KEY', 'testing')
+        self.session_token = os.environ.get('AWS_SESSION_TOKEN')
+        self.region = (os.environ.get('AWS_REGION') or
+                       os.environ.get('AWS_DEFAULT_REGION') or 'us-east-1')
+        self.endpoint = (os.environ.get('AWS_ENDPOINT_URL_S3') or
+                         os.environ.get('AWS_ENDPOINT_URL') or
+                         'https://s3.%s.amazonaws.com' % self.region)
+
+
+def sign(config, method, bucket, key, query, body, extra_headers=None):
+    cfg = config
+    parsed = urllib.parse.urlparse(cfg.endpoint)
+    host = parsed.netloc
+    scheme = parsed.scheme
+    base_path = parsed.path.rstrip('/')
+
+    path = base_path + '/' + bucket
+    if key:
+        path += '/' + key
+
+    canonical_uri = '/'.join(
+        urllib.parse.quote(seg, safe='') for seg in path.split('/'))
+    if canonical_uri == '':
+        canonical_uri = '/'
+
+    if query is None:
+        query = {}
+    qitems = sorted(query.items())
+    canonical_qs = '&'.join(
+        '%s=%s' % (urllib.parse.quote(str(k), safe=''),
+                   urllib.parse.quote(str(v), safe='')) for k, v in qitems)
+
+    if body is None:
+        body = b''
+    payload_hash = EMPTY_SHA256 if body == b'' else hashlib.sha256(body).hexdigest()
+
+    now = datetime.datetime.utcnow()
+    amz_date = now.strftime('%Y%m%dT%H%M%SZ')
+    date_stamp = now.strftime('%Y%m%d')
+
+    headers = {
+        'host': host,
+        'x-amz-content-sha256': payload_hash,
+        'x-amz-date': amz_date,
+    }
+    if cfg.session_token:
+        headers['x-amz-security-token'] = cfg.session_token
+    if extra_headers:
+        for k, v in extra_headers.items():
+            headers[k.lower()] = v
+
+    signed_headers = ';'.join(sorted(headers.keys()))
+    canonical_headers = ''.join(
+        '%s:%s\n' % (k, str(headers[k]).strip()) for k in sorted(headers.keys()))
+
+    canonical_request = '\n'.join([
+        method, canonical_uri, canonical_qs, canonical_headers,
+        signed_headers, payload_hash])
+
+    scope = '%s/%s/s3/aws4_request' % (date_stamp, cfg.region)
+    string_to_sign = '\n'.join([
+        'AWS4-HMAC-SHA256', amz_date, scope,
+        hashlib.sha256(canonical_request.encode('utf-8')).hexdigest()])
+
+    def hmac_sha(key, msg):
+        return hmac.new(key, msg.encode('utf-8'), hashlib.sha256).digest()
+
+    kdate = hmac_sha(('AWS4' + cfg.secret_key).encode('utf-8'), date_stamp)
+    kregion = hmac.new(kdate, cfg.region.encode('utf-8'), hashlib.sha256).digest()
+    kservice = hmac.new(kregion, b's3', hashlib.sha256).digest()
+    ksigning = hmac.new(kservice, b'aws4_request', hashlib.sha256).digest()
+    signature = hmac.new(ksigning, string_to_sign.encode('utf-8'),
+                         hashlib.sha256).hexdigest()
+
+    auth = ('AWS4-HMAC-SHA256 Credential=%s/%s, SignedHeaders=%s, Signature=%s'
+            % (cfg.access_key, scope, signed_headers, signature))
+
+    final_headers = dict(headers)
+    final_headers['Authorization'] = auth
+
+    url_path = canonical_uri
+    if canonical_qs:
+        url_path += '?' + canonical_qs
+
+    return scheme, host, url_path, final_headers
+
+
+def do_request(config, method, bucket, key, query=None, body=None,
+               extra_headers=None):
+    scheme, host, url_path, headers = sign(
+        config, method, bucket, key, query, body, extra_headers)
+    if scheme == 'https':
+        conn = http.client.HTTPSConnection(host, timeout=60)
+    else:
+        conn = http.client.HTTPConnection(host, timeout=60)
+    if body is None:
+        body = b''
+    try:
+        conn.request(method, url_path, body=body, headers=headers)
+        resp = conn.getresponse()
+        data = resp.read()
+        status = resp.status
+        resp_headers = dict(resp.getheaders())
+    finally:
+        conn.close()
+
+    if status >= 300:
+        code, msg = parse_error(data)
+        raise ClientError(code, msg, status)
+    return status, data, resp_headers
+
+
+def parse_error(data):
+    try:
+        root = ET.fromstring(data)
+        code = root.findtext('.//Code') or 'Unknown'
+        msg = root.findtext('.//Message') or 'Unknown error'
+        return code, msg
+    except Exception:
+        return 'Unknown', 'Unknown error'
+
+
+def strip_ns(tag):
+    if '}' in tag:
+        return tag.split('}', 1)[1]
+    return tag
+
+
+# ---------- Commands ----------
+
+def cmd_mb(argv):
+    config = Config()
+    path = None
+    region = None
+    unknown = []
+    i = 0
+    while i < len(argv):
+        a = argv[i]
+        if a == '--region':
+            region = argv[i + 1]
+            i += 2
+        elif a.startswith('--region='):
+            region = a.split('=', 1)[1]
+            i += 1
+        elif a.startswith('--'):
+            unknown.append(a.split('=', 1)[0])
+            i += 1
+        else:
+            path = a
+            i += 1
+
+    if unknown:
+        uni_print("\nUnknown options: %s\n" % ', '.join(unknown), sys.stderr)
+        return 252
+
+    if path is None:
+        uni_print("usage: aws s3 mb <S3Uri>\n", sys.stderr)
+        return 252
+
+    if not path.startswith('s3://'):
+        uni_print("usage: aws s3 mb <S3Uri>\nError: Invalid argument type\n",
+                  sys.stderr)
+        return 252
+
+    if region:
+        config.region = region
+
+    bucket, _ = split_s3_bucket_key(path)
+
+    if is_s3express_bucket(bucket):
+        uni_print("Cannot use mb command with a directory bucket.\n", sys.stderr)
+        return 252
+
+    body = None
+    if config.region != 'us-east-1':
+        body = ('<CreateBucketConfiguration xmlns="%s">'
+                '<LocationConstraint>%s</LocationConstraint>'
+                '</CreateBucketConfiguration>' % (S3_NS, config.region)).encode('utf-8')
+
+    try:
+        do_request(config, 'PUT', bucket, '', body=body)
+        uni_print("make_bucket: %s\n" % bucket)
+        return 0
+    except ClientError as e:
+        uni_print("make_bucket failed: %s %s\n" % (path, e), sys.stderr)
+        return 1
+
+
+def list_objects_v2(config, bucket, prefix, delimiter=None):
+    objs = []
+    prefixes = []
+    token = None
+    while True:
+        query = {'list-type': '2', 'prefix': prefix}
+        if delimiter:
+            query['delimiter'] = delimiter
+        if token:
+            query['continuation-token'] = token
+        status, data, _ = do_request(config, 'GET', bucket, '', query=query)
+        root = ET.fromstring(data)
+        truncated = False
+        next_token = None
+        for child in root:
+            tag = strip_ns(child.tag)
+            if tag == 'Contents':
+                key = None
+                size = 0
+                lm = None
+                etag = None
+                for c in child:
+                    ct = strip_ns(c.tag)
+                    if ct == 'Key':
+                        key = c.text
+                    elif ct == 'Size':
+                        size = int(c.text)
+                    elif ct == 'LastModified':
+                        lm = c.text
+                    elif ct == 'ETag':
+                        etag = c.text
+                objs.append({'Key': key, 'Size': size, 'LastModified': lm,
+                             'ETag': etag})
+            elif tag == 'CommonPrefixes':
+                for c in child:
+                    if strip_ns(c.tag) == 'Prefix':
+                        prefixes.append(c.text)
+            elif tag == 'IsTruncated':
+                truncated = (child.text == 'true')
+            elif tag == 'NextContinuationToken':
+                next_token = child.text
+        if truncated and next_token:
+            token = next_token
+        else:
+            break
+    return objs, prefixes
+
+
+def put_object(config, bucket, key, body, extra_headers=None):
+    do_request(config, 'PUT', bucket, key, body=body,
+               extra_headers=extra_headers)
+
+
+def get_object(config, bucket, key):
+    status, data, headers = do_request(config, 'GET', bucket, key)
+    return data
+
+
+def delete_object(config, bucket, key):
+    do_request(config, 'DELETE', bucket, key)
+
+
+def copy_object(config, dest_bucket, dest_key, src_bucket, src_key):
+    src = '/' + src_bucket + '/' + urllib.parse.quote(src_key)
+    do_request(config, 'PUT', dest_bucket, dest_key, extra_headers={
+        'x-amz-copy-source': src})
+
+
+def is_s3(p):
+    return p.startswith('s3://')
+
+
+_BOOL_FLAGS = {'--dryrun', '--recursive', '--follow-symlinks',
+               '--no-follow-symlinks', '--no-guess-mime-type',
+               '--only-show-errors', '--no-progress', '--quiet',
+               '--force-glacier-transfer', '--size-only', '--exact-timestamps',
+               '--delete', '--copy-props'}
+_VALUE_FLAGS = {'--region', '--website-redirect', '--sse-kms-key-id',
+                '--metadata-directive', '--storage-class', '--content-type',
+                '--cache-control', '--acl', '--content-encoding',
+                '--content-disposition', '--content-language', '--expires',
+                '--metadata', '--grants', '--page-size', '--exclude',
+                '--include', '--source-region'}
+
+
+def parse_transfer_args(argv):
+    positional = []
+    flags = {'dryrun': False, 'recursive': False, 'unknown': []}
+    i = 0
+    while i < len(argv):
+        a = argv[i]
+        if a == '--dryrun':
+            flags['dryrun'] = True
+            i += 1
+        elif a == '--recursive':
+            flags['recursive'] = True
+            i += 1
+        elif a == '--sse':
+            nxt = argv[i + 1] if i + 1 < len(argv) else None
+            if nxt is not None and not nxt.startswith('-'):
+                flags['sse'] = nxt
+                i += 2
+            else:
+                flags['sse'] = 'AES256'
+                i += 1
+        elif a == '--request-payer':
+            nxt = argv[i + 1] if i + 1 < len(argv) else None
+            if nxt == 'requester':
+                i += 2
+            else:
+                i += 1
+            flags['request_payer'] = 'requester'
+        elif '=' in a and a.split('=', 1)[0] in _VALUE_FLAGS:
+            name, val = a.split('=', 1)
+            flags[name[2:].replace('-', '_')] = val
+            i += 1
+        elif a in _VALUE_FLAGS:
+            val = argv[i + 1] if i + 1 < len(argv) else ''
+            flags[a[2:].replace('-', '_')] = val
+            i += 2
+        elif a in _BOOL_FLAGS:
+            flags[a[2:].replace('-', '_')] = True
+            i += 1
+        elif a == '-':
+            positional.append(a)
+            i += 1
+        elif a.startswith('--'):
+            flags['unknown'].append(a.split('=', 1)[0])
+            i += 1
+        else:
+            positional.append(a)
+            i += 1
+    return positional, flags
+
+
+def _put_extra_headers(flags):
+    h = {}
+    wr = flags.get('website_redirect')
+    if wr:
+        h['x-amz-website-redirect-location'] = wr
+    sse = flags.get('sse')
+    if sse:
+        h['x-amz-server-side-encryption'] = sse
+    kms = flags.get('sse_kms_key_id')
+    if kms:
+        h['x-amz-server-side-encryption-aws-kms-key-id'] = kms
+    return h or None
+
+
+def cmd_cp(argv, is_mv=False):
+    positional, flags = parse_transfer_args(argv)
+    if flags['unknown']:
+        uni_print("\nUnknown options: %s\n" % ', '.join(flags['unknown']),
+                  sys.stderr)
+        return 252
+    if len(positional) < 2:
+        uni_print("usage: aws s3 %s <LocalPath> <S3Uri> or "
+                  "<S3Uri> <LocalPath> or <S3Uri> <S3Uri>\n"
+                  % ('mv' if is_mv else 'cp'), sys.stderr)
+        return 2
+
+    src, dest = positional[0], positional[1]
+    config = Config()
+    if 'region' in flags:
+        config.region = flags['region']
+
+    src_is_s3 = is_s3(src)
+    dest_is_s3 = is_s3(dest)
+
+    # mv with identical s3 source and dest is invalid
+    if is_mv and src_is_s3 and dest_is_s3:
+        sb, sk = split_s3_bucket_key(src)
+        db, dk = split_s3_bucket_key(dest)
+        if sk and (sb == db) and (sk == dk):
+            uni_print("Cannot mv a file onto itself: %s\n" % src, sys.stderr)
+            return 252
+        if sb == db and (dk == '' or dk.endswith('/')):
+            base = os.path.basename(sk.rstrip('/'))
+            effective = dk + base
+            if effective == sk:
+                uni_print("Cannot mv a file onto itself: %s\n" % src,
+                          sys.stderr)
+                return 252
+
+    # streaming
+    if src == '-' and dest_is_s3:
+        return _upload_stream(config, dest, flags, is_mv)
+    if src_is_s3 and dest == '-':
+        return _download_stream(config, src, flags)
+
+    if not src_is_s3 and not dest_is_s3:
+        uni_print("usage: aws s3 %s\nError: Invalid argument type\n"
+                  % ('mv' if is_mv else 'cp'), sys.stderr)
+        return 2
+
+    if flags['recursive']:
+        return _transfer_recursive(config, src, dest, flags, is_mv)
+
+    if not src_is_s3 and dest_is_s3:
+        return _upload(config, src, dest, flags, is_mv)
+    elif src_is_s3 and not dest_is_s3:
+        return _download(config, src, dest, flags, is_mv)
+    else:
+        return _copy(config, src, dest, flags, is_mv)
+
+
+def _dest_key(dest, src):
+    b, k = split_s3_bucket_key(dest)
+    if k == '' or k.endswith('/'):
+        base = os.path.basename(src.rstrip('/'))
+        k = k + base
+    return b, k
+
+
+def _upload_stream(config, dest, flags, is_mv):
+    b, k = split_s3_bucket_key(dest)
+    if flags['dryrun']:
+        uni_print("(dryrun) upload: - to s3://%s/%s\n" % (b, k))
+        return 0
+    data = sys.stdin.buffer.read()
+    try:
+        put_object(config, b, k, data)
+    except ClientError as e:
+        uni_print("upload failed: - to s3://%s/%s %s\n" % (b, k, e), sys.stderr)
+        return 1
+    return 0
+
+
+def _download_stream(config, src, flags):
+    b, k = split_s3_bucket_key(src)
+    if flags['dryrun']:
+        uni_print("(dryrun) download: s3://%s/%s to -\n" % (b, k))
+        return 0
+    try:
+        data = get_object(config, b, k)
+    except ClientError as e:
+        uni_print("download failed: s3://%s/%s to - %s\n" % (b, k, e), sys.stderr)
+        return 1
+    sys.stdout.buffer.write(data)
+    sys.stdout.buffer.flush()
+    return 0
+
+
+def _upload(config, src, dest, flags, is_mv):
+    op = 'move' if is_mv else 'upload'
+    b, k = _dest_key(dest, src)
+    if flags['dryrun']:
+        uni_print("(dryrun) %s: %s to s3://%s/%s\n" % (op, src, b, k))
+        return 0
+    if not os.path.isfile(src):
+        uni_print("%s failed: %s to s3://%s/%s "
+                  "The user-provided path %s does not exist.\n"
+                  % ('upload' if not is_mv else 'move', src, b, k, src),
+                  sys.stderr)
+        return 1
+    try:
+        with open(src, 'rb') as f:
+            data = f.read()
+        put_object(config, b, k, data, extra_headers=_put_extra_headers(flags))
+    except ClientError as e:
+        uni_print("%s failed: %s to s3://%s/%s %s\n"
+                  % ('upload' if not is_mv else 'move', src, b, k, e), sys.stderr)
+        return 1
+    uni_print("%s: %s to s3://%s/%s\n"
+              % ('upload' if not is_mv else 'move', src, b, k))
+    if is_mv:
+        try:
+            os.remove(src)
+        except OSError:
+            pass
+    return 0
+
+
+def _download(config, src, dest, flags, is_mv):
+    b, k = split_s3_bucket_key(src)
+    if os.path.isdir(dest) or dest.endswith('/'):
+        dest = os.path.join(dest, os.path.basename(k))
+    op = 'move' if is_mv else 'download'
+    if flags['dryrun']:
+        uni_print("(dryrun) %s: s3://%s/%s to %s\n" % (op, b, k, dest))
+        return 0
+    try:
+        data = get_object(config, b, k)
+    except ClientError as e:
+        uni_print("%s failed: s3://%s/%s to %s %s\n"
+                  % ('download' if not is_mv else 'move', b, k, dest, e),
+                  sys.stderr)
+        return 1
+    with open(dest, 'wb') as f:
+        f.write(data)
+    uni_print("%s: s3://%s/%s to %s\n"
+              % ('download' if not is_mv else 'move', b, k, dest))
+    if is_mv:
+        try:
+            delete_object(config, b, k)
+        except ClientError:
+            pass
+    return 0
+
+
+def _copy(config, src, dest, flags, is_mv):
+    sb, sk = split_s3_bucket_key(src)
+    db, dk = _dest_key(dest, src)
+    op = 'move' if is_mv else 'copy'
+    if flags['dryrun']:
+        uni_print("(dryrun) %s: s3://%s/%s to s3://%s/%s\n"
+                  % (op, sb, sk, db, dk))
+        return 0
+    try:
+        copy_object(config, db, dk, sb, sk)
+    except ClientError as e:
+        uni_print("%s failed: s3://%s/%s to s3://%s/%s %s\n"
+                  % (op, sb, sk, db, dk, e), sys.stderr)
+        return 1
+    uni_print("%s: s3://%s/%s to s3://%s/%s\n" % (op, sb, sk, db, dk))
+    if is_mv:
+        try:
+            delete_object(config, sb, sk)
+        except ClientError:
+            pass
+    return 0
+
+
+def _transfer_recursive(config, src, dest, flags, is_mv):
+    src_is_s3 = is_s3(src)
+    dest_is_s3 = is_s3(dest)
+    rc = 0
+    if not src_is_s3 and dest_is_s3:
+        db, dprefix = split_s3_bucket_key(dest)
+        base = src.rstrip('/')
+        for root, dirs, files in os.walk(base):
+            for fn in files:
+                full = os.path.join(root, fn)
+                rel = os.path.relpath(full, base).replace(os.sep, '/')
+                key = dprefix.rstrip('/')
+                key = (key + '/' + rel) if key else rel
+                if flags['dryrun']:
+                    uni_print("(dryrun) %s: %s to s3://%s/%s\n"
+                              % ('upload', full, db, key))
+                    continue
+                try:
+                    with open(full, 'rb') as f:
+                        put_object(config, db, key, f.read())
+                    uni_print("%s: %s to s3://%s/%s\n" % ('upload', full, db, key))
+                    if is_mv:
+                        os.remove(full)
+                except ClientError as e:
+                    uni_print("upload failed: %s to s3://%s/%s %s\n"
+                              % (full, db, key, e), sys.stderr)
+                    rc = 1
+        return rc
+    elif src_is_s3 and not dest_is_s3:
+        sb, sprefix = split_s3_bucket_key(src)
+        objs, _ = list_objects_v2(config, sb, sprefix)
+        for o in objs:
+            key = o['Key']
+            rel = key[len(sprefix):] if key.startswith(sprefix) else key
+            rel = rel.lstrip('/')
+            out = os.path.join(dest, rel)
+            if flags['dryrun']:
+                uni_print("(dryrun) download: s3://%s/%s to %s\n" % (sb, key, out))
+                continue
+            try:
+                data = get_object(config, sb, key)
+                os.makedirs(os.path.dirname(out) or '.', exist_ok=True)
+                with open(out, 'wb') as f:
+                    f.write(data)
+                uni_print("download: s3://%s/%s to %s\n" % (sb, key, out))
+                if is_mv:
+                    delete_object(config, sb, key)
+            except ClientError as e:
+                uni_print("download failed: s3://%s/%s to %s %s\n"
+                          % (sb, key, out, e), sys.stderr)
+                rc = 1
+        return rc
+    else:
+        sb, sprefix = split_s3_bucket_key(src)
+        db, dprefix = split_s3_bucket_key(dest)
+        objs, _ = list_objects_v2(config, sb, sprefix)
+        for o in objs:
+            key = o['Key']
+            rel = key[len(sprefix):] if key.startswith(sprefix) else key
+            rel = rel.lstrip('/')
+            dk = (dprefix.rstrip('/') + '/' + rel) if dprefix else rel
+            if flags['dryrun']:
+                uni_print("(dryrun) copy: s3://%s/%s to s3://%s/%s\n"
+                          % (sb, key, db, dk))
+                continue
+            try:
+                copy_object(config, db, dk, sb, key)
+                uni_print("copy: s3://%s/%s to s3://%s/%s\n" % (sb, key, db, dk))
+                if is_mv:
+                    delete_object(config, sb, key)
+            except ClientError as e:
+                uni_print("copy failed: s3://%s/%s to s3://%s/%s %s\n"
+                          % (sb, key, db, dk, e), sys.stderr)
+                rc = 1
+        return rc
+
+
+def cmd_rm(argv):
+    positional, flags = parse_transfer_args(argv)
+    if flags['unknown']:
+        uni_print("\nUnknown options: %s\n" % ', '.join(flags['unknown']),
+                  sys.stderr)
+        return 252
+    if len(positional) < 1:
+        uni_print("usage: aws s3 rm <S3Uri>\n", sys.stderr)
+        return 2
+    target = positional[0]
+    config = Config()
+    if 'region' in flags:
+        config.region = flags['region']
+    if not is_s3(target):
+        uni_print("usage: aws s3 rm <S3Uri>\nError: Invalid argument type\n",
+                  sys.stderr)
+        return 2
+
+    if flags['recursive']:
+        b, prefix = split_s3_bucket_key(target)
+        objs, _ = list_objects_v2(config, b, prefix)
+        rc = 0
+        for o in objs:
+            key = o['Key']
+            if flags['dryrun']:
+                uni_print("(dryrun) delete: s3://%s/%s\n" % (b, key))
+                continue
+            try:
+                delete_object(config, b, key)
+                uni_print("delete: s3://%s/%s\n" % (b, key))
+            except ClientError as e:
+                uni_print("delete failed: s3://%s/%s %s\n" % (b, key, e),
+                          sys.stderr)
+                rc = 1
+        return rc
+
+    b, k = split_s3_bucket_key(target)
+    if flags['dryrun']:
+        uni_print("(dryrun) delete: s3://%s/%s\n" % (b, k))
+        return 0
+    try:
+        delete_object(config, b, k)
+    except ClientError as e:
+        uni_print("delete failed: s3://%s/%s %s\n" % (b, k, e), sys.stderr)
+        return 1
+    uni_print("delete: s3://%s/%s\n" % (b, k))
+    return 0
+
+
+def cmd_sync(argv):
+    positional, flags = parse_transfer_args(argv)
+    if flags['unknown']:
+        uni_print("\nUnknown options: %s\n" % ', '.join(flags['unknown']),
+                  sys.stderr)
+        return 252
+    if flags['recursive']:
+        uni_print("usage: aws s3 sync <LocalPath> <S3Uri> or "
+                  "<S3Uri> <LocalPath> or <S3Uri> <S3Uri>\n"
+                  "Unknown options: --recursive\n", sys.stderr)
+        return 252
+    if len(positional) < 2:
+        uni_print("usage: aws s3 sync <LocalPath> <S3Uri> or "
+                  "<S3Uri> <LocalPath> or <S3Uri> <S3Uri>\n", sys.stderr)
+        return 2
+    src, dest = positional[0], positional[1]
+    config = Config()
+    if 'region' in flags:
+        config.region = flags['region']
+    src_is_s3 = is_s3(src)
+    dest_is_s3 = is_s3(dest)
+
+    if not src_is_s3 and not dest_is_s3:
+        uni_print("usage: aws s3 sync\nError: Invalid argument type\n",
+                  sys.stderr)
+        return 252
+
+    if not src_is_s3 and dest_is_s3:
+        if not os.path.isdir(src):
+            uni_print("The user-provided path %s does not exist.\n" % src,
+                      sys.stderr)
+            return 255
+        db, dprefix = split_s3_bucket_key(dest)
+        existing, _ = list_objects_v2(config, db, dprefix)
+        existing_map = {}
+        for o in existing:
+            existing_map[o['Key']] = o
+        rc = 0
+        base = src.rstrip('/')
+        for root, dirs, files in os.walk(base):
+            for fn in files:
+                full = os.path.join(root, fn)
+                rel = os.path.relpath(full, base).replace(os.sep, '/')
+                key = dprefix.rstrip('/')
+                key = (key + '/' + rel) if key else rel
+                st = os.stat(full)
+                need = True
+                if key in existing_map:
+                    if existing_map[key]['Size'] == st.st_size:
+                        need = False
+                if not need:
+                    continue
+                if flags['dryrun']:
+                    uni_print("(dryrun) upload: %s to s3://%s/%s\n"
+                              % (full, db, key))
+                    continue
+                try:
+                    with open(full, 'rb') as f:
+                        put_object(config, db, key, f.read(),
+                                   extra_headers=_put_extra_headers(flags))
+                    uni_print("upload: %s to s3://%s/%s\n" % (full, db, key))
+                except ClientError as e:
+                    uni_print("upload failed: %s to s3://%s/%s %s\n"
+                              % (full, db, key, e), sys.stderr)
+                    rc = 1
+        return rc
+    elif src_is_s3 and not dest_is_s3:
+        sb, sprefix = split_s3_bucket_key(src)
+        objs, _ = list_objects_v2(config, sb, sprefix)
+        rc = 0
+        for o in objs:
+            key = o['Key']
+            rel = key[len(sprefix):] if key.startswith(sprefix) else key
+            rel = rel.lstrip('/')
+            out = os.path.join(dest, rel)
+            local_exists = os.path.isfile(out)
+            need = True
+            if local_exists and os.stat(out).st_size == o['Size']:
+                need = False
+            if not need:
+                continue
+            if flags['dryrun']:
+                uni_print("(dryrun) download: s3://%s/%s to %s\n"
+                          % (sb, key, out))
+                continue
+            try:
+                data = get_object(config, sb, key)
+                os.makedirs(os.path.dirname(out) or '.', exist_ok=True)
+                with open(out, 'wb') as f:
+                    f.write(data)
+                uni_print("download: s3://%s/%s to %s\n" % (sb, key, out))
+            except ClientError as e:
+                uni_print("download failed: s3://%s/%s to %s %s\n"
+                          % (sb, key, out, e), sys.stderr)
+                rc = 1
+        return rc
+    else:
+        sb, sprefix = split_s3_bucket_key(src)
+        db, dprefix = split_s3_bucket_key(dest)
+        src_objs, _ = list_objects_v2(config, sb, sprefix)
+        dest_objs, _ = list_objects_v2(config, db, dprefix)
+        dmap = {o['Key']: o for o in dest_objs}
+        rc = 0
+        for o in src_objs:
+            key = o['Key']
+            rel = key[len(sprefix):] if key.startswith(sprefix) else key
+            rel = rel.lstrip('/')
+            dk = (dprefix.rstrip('/') + '/' + rel) if dprefix else rel
+            if dk in dmap and dmap[dk]['Size'] == o['Size']:
+                continue
+            if flags['dryrun']:
+                uni_print("(dryrun) copy: s3://%s/%s to s3://%s/%s\n"
+                          % (sb, key, db, dk))
+                continue
+            try:
+                copy_object(config, db, dk, sb, key)
+                uni_print("copy: s3://%s/%s to s3://%s/%s\n" % (sb, key, db, dk))
+            except ClientError as e:
+                uni_print("copy failed: s3://%s/%s to s3://%s/%s %s\n"
+                          % (sb, key, db, dk, e), sys.stderr)
+                rc = 1
+        return rc
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 2:
+        uni_print("usage: aws <command> <subcommand> [parameters]\n", sys.stderr)
+        return 2
+    if argv[1] != 's3':
+        uni_print("aws: error: argument command: Invalid choice: '%s'\n"
+                  % argv[1], sys.stderr)
+        return 2
+    if len(argv) < 3:
+        uni_print("usage: aws s3 <subcommand>\n", sys.stderr)
+        return 2
+
+    sub = argv[2]
+    rest = argv[3:]
+
+    try:
+        if sub == 'mb':
+            return cmd_mb(rest)
+        elif sub == 'cp':
+            return cmd_cp(rest, is_mv=False)
+        elif sub == 'mv':
+            return cmd_cp(rest, is_mv=True)
+        elif sub == 'rm':
+            return cmd_rm(rest)
+        elif sub == 'sync':
+            return cmd_sync(rest)
+        else:
+            uni_print("aws: error: argument subcommand: Invalid choice: '%s'\n"
+                      % sub, sys.stderr)
+            return 2
+    except ClientError as e:
+        uni_print("%s\n" % e, sys.stderr)
+        return 1
+    except BrokenPipeError:
+        return 0
+    except Exception as e:
+        uni_print("%s\n" % e, sys.stderr)
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
