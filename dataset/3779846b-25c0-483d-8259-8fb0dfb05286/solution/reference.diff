diff --git a/submission/main.py b/submission/main.py
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/submission/main.py
@@ -0,0 +1,189 @@
+import sys, os, json, urllib.request, urllib.error
+
+USAGE = 252
+SERVICE_ERR = 254
+
+# flag spec: flag -> (field, type)
+# type: 'str', 'json', 'int', 'bool', 'strlist'
+SPECS = {
+    "delete-item": {
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--key": ("Key", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "get-item": {
+        "--attributes-to-get": ("AttributesToGet", "strlist"),
+        "--consistent-read": ("ConsistentRead", "bool"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--key": ("Key", "json"),
+        "--projection-expression": ("ProjectionExpression", "str"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "list-tables": {
+        "--exclusive-start-table-name": ("ExclusiveStartTableName", "str"),
+        "--limit": ("Limit", "int"),
+    },
+    "query": {
+        "--attributes-to-get": ("AttributesToGet", "strlist"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--consistent-read": ("ConsistentRead", "bool"),
+        "--exclusive-start-key": ("ExclusiveStartKey", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--filter-expression": ("FilterExpression", "str"),
+        "--index-name": ("IndexName", "str"),
+        "--key-condition-expression": ("KeyConditionExpression", "str"),
+        "--key-conditions": ("KeyConditions", "json"),
+        "--limit": ("Limit", "int"),
+        "--projection-expression": ("ProjectionExpression", "str"),
+        "--query-filter": ("QueryFilter", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--scan-index-forward": ("ScanIndexForward", "bool"),
+        "--no-scan-index-forward": ("ScanIndexForward", "boolfalse"),
+        "--select": ("Select", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "update-item": {
+        "--attribute-updates": ("AttributeUpdates", "json"),
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--key": ("Key", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+        "--update-expression": ("UpdateExpression", "str"),
+    },
+}
+
+OP = {
+    "delete-item": "DeleteItem",
+    "get-item": "GetItem",
+    "list-tables": "ListTables",
+    "query": "Query",
+    "update-item": "UpdateItem",
+}
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: " + msg + "\n")
+    sys.exit(USAGE)
+
+
+def parse_args(spec, args):
+    result = {}
+    seen = set()
+    i = 0
+    n = len(args)
+    while i < n:
+        tok = args[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: " + tok)
+        if tok not in spec:
+            usage_error("unknown flag: " + tok)
+        field, typ = spec[tok]
+        if field in seen:
+            usage_error("duplicate flag: " + tok)
+        seen.add(field)
+        if typ == "bool":
+            result[field] = True
+            i += 1
+            continue
+        if typ == "boolfalse":
+            result[field] = False
+            i += 1
+            continue
+        if i + 1 >= n:
+            usage_error("flag " + tok + " requires a value")
+        val = args[i + 1]
+        i += 2
+        if typ == "str":
+            if val == "":
+                usage_error("flag " + tok + " requires a non-empty value")
+            result[field] = val
+        elif typ == "int":
+            try:
+                result[field] = int(val)
+            except ValueError:
+                usage_error("flag " + tok + " requires an integer")
+        elif typ == "json":
+            try:
+                result[field] = json.loads(val)
+            except Exception:
+                usage_error("flag " + tok + " requires valid JSON")
+        elif typ == "strlist":
+            result[field] = val.split(",")
+    return result
+
+
+def call(op, payload):
+    endpoint = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ["AWS_ENDPOINT_URL"]
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20200101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=host;x-amz-date;x-amz-target, Signature=dummy")
+    req.add_header("X-Amz-Date", "20200101T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        return json.loads(body) if body else {}
+    except urllib.error.HTTPError as e:
+        body = e.read().decode("utf-8")
+        code = "UnknownError"
+        msg = body
+        try:
+            parsed = json.loads(body)
+            t = parsed.get("__type", "")
+            code = t.split("#")[-1] if t else code
+            msg = parsed.get("message") or parsed.get("Message") or ""
+        except Exception:
+            pass
+        sys.stderr.write(code + ": " + msg + "\n")
+        sys.exit(SERVICE_ERR)
+    except urllib.error.URLError as e:
+        sys.stderr.write("ConnectionError: " + str(e) + "\n")
+        sys.exit(SERVICE_ERR)
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("missing command")
+    sub = argv[2]
+    if sub not in SPECS:
+        usage_error("unknown command: " + sub)
+    spec = SPECS[sub]
+    params = parse_args(spec, argv[3:])
+
+    if sub in ("delete-item", "get-item", "update-item"):
+        if "TableName" not in params:
+            usage_error("--table-name is required")
+        if "Key" not in params:
+            usage_error("--key is required")
+    if sub == "query":
+        if "TableName" not in params:
+            usage_error("--table-name is required")
+
+    result = call(OP[sub], params)
+    sys.stdout.write(json.dumps(result, indent=4) + "\n")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
