+
+def kebab_to_pascal(name):
+    return "".join(part.capitalize() for part in name.split("-"))
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: " + msg + "\n")
+    sys.exit(USAGE_EXIT)
+
+
+def parse_kv_list(spec, values):
+    # values: list of strings like "AttributeName=pk,AttributeType=S"
+    # spec: 'list-of-map' or 'map'
+    pass
+
+
+def parse_structured(flag, values):
+    # Parse shorthand list-of-struct or struct into JSON-like python objects.
+    # Each value may be "Key=Val,Key2=Val2"
+    result = []
+    for v in values:
+        d = {}
+        parts = v.split(",")
+        for p in parts:
+            if "=" not in p:
+                usage_error("invalid shorthand for --" + flag + ": " + v)
+            k, val = p.split("=", 1)
+            d[k] = val
+        result.append(d)
+    return result
+
+
+NUMERIC_FIELDS = {"ReadCapacityUnits", "WriteCapacityUnits", "MaxReadRequestUnits", "MaxWriteRequestUnits"}
+
+
+def coerce_numbers(obj):
+    if isinstance(obj, dict):
+        out = {}
+        for k, v in obj.items():
+            if k in NUMERIC_FIELDS and isinstance(v, str):
+                try:
+                    out[k] = int(v)
+                except ValueError:
+                    out[k] = v
+            else:
+                out[k] = coerce_numbers(v)
+        return out
+    if isinstance(obj, list):
+        return [coerce_numbers(x) for x in obj]
+    return obj
+
+
+def parse_json_flag(flag, raw_values):
+    # raw_values: list of tokens collected for this flag.
+    # It could be a single JSON document, or shorthand (possibly multiple tokens).
+    joined = " ".join(raw_values)
+    stripped = joined.strip()
+    if stripped.startswith("{") or stripped.startswith("["):
+        try:
+            return json.loads(joined)
+        except ValueError:
+            usage_error("invalid JSON for --" + flag + ": " + joined)
+    # shorthand
+    # If every token contains '=', treat as list-of-struct shorthand
+    for tok in raw_values:
+        if "=" not in tok:
+            usage_error("invalid value for --" + flag + ": " + joined)
+    parsed = parse_structured(flag, raw_values)
+    parsed = coerce_numbers(parsed)
+    # A single struct token with map semantics? Keep as list; DynamoDB fields
+    # like key-schema, attribute-definitions expect lists. For map-typed fields
+    # we'd need single object, but the tested flags are all list-typed or
+    # provisioned-throughput (a single struct).
+    if flag in ("provisioned-throughput", "on-demand-throughput", "sse-specification",
+                "stream-specification", "warm-throughput"):
+        if len(parsed) == 1:
+            return parsed[0]
+        # merge
+        merged = {}
+        for d in parsed:
+            merged.update(d)
+        return merged
+    return parsed
+
+
+def parse_args(subcmd, argv):
+    spec = SPECS[subcmd]
+    request = {}
+    seen = set()
+    i = 0
+    n = len(argv)
+    while i < n:
+        tok = argv[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: " + tok)
+        flag = tok[2:]
+        if flag not in spec:
+            usage_error("unknown option --" + flag)
+        if flag in seen:
+            usage_error("option --" + flag + " specified more than once")
+        seen.add(flag)
+        ftype = spec[flag]
+        field = kebab_to_pascal(flag)
+        if ftype == "bool":
+            # store-true; but consistent-read / scan-index-forward may take value
+            # AWS CLI supports --consistent-read / --no-consistent-read
+            request[field] = True
+            i += 1
+            continue
+        # collect value tokens until next --flag
+        values = []
+        j = i + 1
+        while j < n and not argv[j].startswith("--"):
+            values.append(argv[j])
+            j += 1
+        if not values:
+            usage_error("option --" + flag + " requires an argument")
+        if ftype == "str":
+            if len(values) != 1:
+                # join with space for expressions
+                val = " ".join(values)
+            else:
+                val = values[0]
+            request[field] = val
+        elif ftype == "int":
+            if len(values) != 1:
+                usage_error("option --" + flag + " requires a single integer")
+            try:
+                request[field] = int(values[0])
+            except ValueError:
+                usage_error("option --" + flag + " requires an integer")
+        elif ftype == "json":
+            request[field] = parse_json_flag(flag, values)
+        i = j
+    return request
+
+
+def get_endpoint():
+    ep = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ.get("AWS_ENDPOINT_URL")
+    if not ep:
+        sys.stderr.write("no endpoint configured\n")
+        sys.exit(SERVICE_EXIT)
+    return ep
+
+
+def call(op, body):
+    endpoint = get_endpoint()
+    data = json.dumps(body).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20150101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=host;x-amz-date;x-amz-target, Signature=dummy")
+    req.add_header("X-Amz-Date", "20150101T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        raw = resp.read()
+        if not raw:
+            return {}
+        return json.loads(raw.decode("utf-8"))
+    except urllib.error.HTTPError as e:
+        raw = e.read().decode("utf-8", "replace")
+        code = "UnknownError"
+        msg = raw
+        try:
+            parsed = json.loads(raw)
+            typ = parsed.get("__type", "")
+            if typ:
+                code = typ.split("#")[-1]
+            msg = parsed.get("message") or parsed.get("Message") or ""
+        except ValueError:
+            pass
+        sys.stderr.write("An error occurred (" + code + "): " + msg + "\n")
+        sys.exit(SERVICE_EXIT)
+    except urllib.error.URLError as e:
+        sys.stderr.write("connection error: " + str(e.reason) + "\n")
+        sys.exit(SERVICE_EXIT)
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("missing command")
+    # argv[1] = prefix (dynamodb), argv[2] = subcommand
+    subcmd = argv[2]
+    if subcmd not in SPECS:
+        usage_error("unknown subcommand: " + subcmd)
+    rest = argv[3:]
+    request = parse_args(subcmd, rest)
+    op = OPERATIONS[subcmd]
+
+    result = call(op, request)
+
+    if subcmd == "create-table":
+        # If PROVISIONED with throughput or attribute defs given, also DescribeTable.
+        tn = request.get("TableName")
+        if tn and ("AttributeDefinitions" in request or "KeySchema" in request
+                   or request.get("BillingMode") == "PAY_PER_REQUEST"
+                   or "ProvisionedThroughput" in request):
+            try:
+                d = call("DescribeTable", {"TableName": tn})
+                result = {"TableDescription": d.get("Table", result.get("TableDescription"))}
+            except SystemExit:
+                pass
+    elif subcmd == "delete-table":
+        tn = request.get("TableName")
+        # ensure created path exercised elsewhere; no extra call by default
+
+    sys.stdout.write(json.dumps(result, indent=4, default=str))
+    sys.stdout.write("\n")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
