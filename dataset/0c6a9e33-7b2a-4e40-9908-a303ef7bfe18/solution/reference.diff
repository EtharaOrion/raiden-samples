+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+USAGE_EXIT = 252
+SERVICE_EXIT = 254
+
+
+def get_endpoint():
+    ep = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ.get("AWS_ENDPOINT_URL")
+    if not ep:
+        ep = os.environ["AWS_ENDPOINT_URL"]
+    return ep
+
+
+def call(op, payload):
+    endpoint = get_endpoint()
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20200101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=host;x-amz-date, Signature=dummy")
+    req.add_header("X-Amz-Date", "20200101T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        if body:
+            return json.loads(body)
+        return {}
+    except urllib.error.HTTPError as e:
+        body = e.read().decode("utf-8")
+        code = "UnknownError"
+        msg = body
+        try:
+            j = json.loads(body)
+            t = j.get("__type", j.get("code", "UnknownError"))
+            code = t.split("#")[-1]
+            msg = j.get("message", j.get("Message", ""))
+        except Exception:
+            pass
+        sys.stderr.write("An error occurred (%s): %s\n" % (code, msg))
+        sys.exit(SERVICE_EXIT)
+    except urllib.error.URLError as e:
+        sys.stderr.write("Connection error: %s\n" % str(e))
+        sys.exit(SERVICE_EXIT)
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: %s\n" % msg)
+    sys.exit(USAGE_EXIT)
+
+
+# Flag specs: map flag name -> (field, kind)
+# kind: 'str', 'json', 'int', 'bool', 'attrdefs', 'keyschema', 'provthr'
+
+def kebab_to_pascal(flag):
+    parts = flag[2:].split("-")
+    return "".join(p[:1].upper() + p[1:] for p in parts)
+
+
+CREATE_TABLE_FLAGS = {
+    "--attribute-definitions": "attrdefs",
+    "--billing-mode": "str",
+    "--deletion-protection-enabled": "boolopt",
+    "--global-secondary-indexes": "json",
+    "--global-table-settings-replication-mode": "str",
+    "--global-table-source-arn": "str",
+    "--key-schema": "keyschema",
+    "--local-secondary-indexes": "json",
+    "--on-demand-throughput": "json",
+    "--provisioned-throughput": "provthr",
+    "--resource-policy": "str",
+    "--sse-specification": "json",
+    "--stream-specification": "json",
+    "--table-class": "str",
+    "--table-name": "str",
+    "--tags": "json",
+    "--warm-throughput": "json",
+}
+
+DELETE_ITEM_FLAGS = {
+    "--condition-expression": "str",
+    "--conditional-operator": "str",
+    "--expected": "json",
+    "--expression-attribute-names": "json",
+    "--expression-attribute-values": "json",
+    "--key": "json",
+    "--return-consumed-capacity": "str",
+    "--return-item-collection-metrics": "str",
+    "--return-values": "str",
+    "--return-values-on-condition-check-failure": "str",
+    "--table-name": "str",
+}
+
+DELETE_TABLE_FLAGS = {
+    "--table-name": "str",
+}
+
+GET_ITEM_FLAGS = {
+    "--attributes-to-get": "json",
+    "--consistent-read": "boolopt",
+    "--expression-attribute-names": "json",
+    "--key": "json",
+    "--projection-expression": "str",
+    "--return-consumed-capacity": "str",
+    "--table-name": "str",
+}
+
+LIST_TABLES_FLAGS = {
+    "--exclusive-start-table-name": "str",
+    "--limit": "int",
+}
+
+UPDATE_ITEM_FLAGS = {
+    "--attribute-updates": "json",
+    "--condition-expression": "str",
+    "--conditional-operator": "str",
+    "--expected": "json",
+    "--expression-attribute-names": "json",
+    "--expression-attribute-values": "json",
+    "--key": "json",
+    "--return-consumed-capacity": "str",
+    "--return-item-collection-metrics": "str",
+    "--return-values": "str",
+    "--return-values-on-condition-check-failure": "str",
+    "--table-name": "str",
+    "--update-expression": "str",
+}
+
+
+def parse_attrdefs(values):
+    result = []
+    for v in values:
+        pairs = dict(p.split("=", 1) for p in v.split(","))
+        result.append({
+            "AttributeName": pairs.get("AttributeName"),
+            "AttributeType": pairs.get("AttributeType"),
+        })
+    return result
+
+
+def parse_keyschema(values):
+    result = []
+    for v in values:
+        pairs = dict(p.split("=", 1) for p in v.split(","))
+        result.append({
+            "AttributeName": pairs.get("AttributeName"),
+            "KeyType": pairs.get("KeyType"),
+        })
+    return result
+
+
+def parse_provthr(value):
+    pairs = dict(p.split("=", 1) for p in value.split(","))
+    out = {}
+    if "ReadCapacityUnits" in pairs:
+        out["ReadCapacityUnits"] = int(pairs["ReadCapacityUnits"])
+    if "WriteCapacityUnits" in pairs:
+        out["WriteCapacityUnits"] = int(pairs["WriteCapacityUnits"])
+    return out
+
+
+def parse_flags(args, spec):
+    """Parse args according to spec. Returns dict field->value."""
+    result = {}
+    seen = set()
+    i = 0
+    n = len(args)
+    while i < n:
+        tok = args[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: %s" % tok)
+        if tok not in spec:
+            usage_error("unknown flag: %s" % tok)
+        if tok in seen:
+            usage_error("duplicate flag: %s" % tok)
+        kind = spec[tok]
+        field = kebab_to_pascal(tok)
+        if kind == "boolopt":
+            result[field] = True
+            seen.add(tok)
+            i += 1
+            continue
+        if kind in ("attrdefs", "keyschema"):
+            # consume one or more non-flag values
+            vals = []
+            i += 1
+            while i < n and not args[i].startswith("--"):
+                vals.append(args[i])
+                i += 1
+            if not vals:
+                usage_error("missing value for %s" % tok)
+            if kind == "attrdefs":
+                try:
+                    result[field] = parse_attrdefs(vals)
+                except Exception:
+                    usage_error("invalid value for %s" % tok)
+            else:
+                try:
+                    result[field] = parse_keyschema(vals)
+                except Exception:
+                    usage_error("invalid value for %s" % tok)
+            seen.add(tok)
+            continue
+        # single-value flags
+        if i + 1 >= n:
+            usage_error("missing value for %s" % tok)
+        val = args[i + 1]
+        i += 2
+        if val == "":
+            usage_error("empty value for %s" % tok)
+        if kind == "str":
+            result[field] = val
+        elif kind == "int":
+            try:
+                result[field] = int(val)
+            except Exception:
+                usage_error("invalid integer for %s" % tok)
+        elif kind == "json":
+            try:
+                result[field] = json.loads(val)
+            except Exception:
+                usage_error("invalid JSON for %s" % tok)
+        elif kind == "provthr":
+            try:
+                result[field] = parse_provthr(val)
+            except Exception:
+                usage_error("invalid value for %s" % tok)
+        else:
+            usage_error("unknown kind")
+        seen.add(tok)
+    return result
+
+
+def require(params, field, flag):
+    if field not in params:
+        usage_error("missing required flag: %s" % flag)
+
+
+def cmd_create_table(args):
+    p = parse_flags(args, CREATE_TABLE_FLAGS)
+    require(p, "TableName", "--table-name")
+    resp = call("CreateTable", p)
+    print(json.dumps(resp, indent=4, sort_keys=True))
+    return 0
+
+
+def cmd_delete_table(args):
+    p = parse_flags(args, DELETE_TABLE_FLAGS)
+    require(p, "TableName", "--table-name")
+    resp = call("DeleteTable", p)
+    print(json.dumps(resp, indent=4, sort_keys=True))
+    return 0
+
+
+def cmd_get_item(args):
+    p = parse_flags(args, GET_ITEM_FLAGS)
+    require(p, "TableName", "--table-name")
+    require(p, "Key", "--key")
+    resp = call("GetItem", p)
+    print(json.dumps(resp, indent=4, sort_keys=True))
+    return 0
+
+
+def cmd_delete_item(args):
+    p = parse_flags(args, DELETE_ITEM_FLAGS)
+    require(p, "TableName", "--table-name")
+    require(p, "Key", "--key")
+    resp = call("DeleteItem", p)
+    print(json.dumps(resp, indent=4, sort_keys=True))
+    return 0
+
+
+def cmd_update_item(args):
+    p = parse_flags(args, UPDATE_ITEM_FLAGS)
+    require(p, "TableName", "--table-name")
+    require(p, "Key", "--key")
+    resp = call("UpdateItem", p)
+    print(json.dumps(resp, indent=4, sort_keys=True))
+    return 0
+
+
+def cmd_list_tables(args):
+    p = parse_flags(args, LIST_TABLES_FLAGS)
+    resp = call("ListTables", p)
+    print(json.dumps(resp, indent=4, sort_keys=True))
+    return 0
+
+
+DISPATCH = {
+    "create-table": cmd_create_table,
+    "delete-table": cmd_delete_table,
+    "get-item": cmd_get_item,
+    "delete-item": cmd_delete_item,
+    "update-item": cmd_update_item,
+    "list-tables": cmd_list_tables,
+}
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("not enough arguments")
+    sub = argv[2]
+    handler = DISPATCH.get(sub)
+    if handler is None:
+        usage_error("unknown subcommand: %s" % sub)
+    rest = argv[3:]
+    return handler(rest)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
