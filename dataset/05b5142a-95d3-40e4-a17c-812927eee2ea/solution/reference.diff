+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+USAGE_EXIT = 252
+ERROR_EXIT = 254
+
+def get_endpoint():
+    ep = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ.get("AWS_ENDPOINT_URL")
+    if not ep:
+        raise KeyError("AWS_ENDPOINT_URL")
+    return ep
+
+def call(op, payload):
+    endpoint = get_endpoint()
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20120101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=content-type;host;x-amz-target, Signature=dummy")
+    req.add_header("X-Amz-Date", "20120101T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        if body:
+            return json.loads(body)
+        return {}
+    except urllib.error.HTTPError as e:
+        body = e.read().decode("utf-8")
+        try:
+            err = json.loads(body)
+        except Exception:
+            err = {}
+        code = err.get("__type", "UnknownError")
+        if "#" in code:
+            code = code.split("#", 1)[1]
+        msg = err.get("message") or err.get("Message") or ""
+        sys.stderr.write("An error occurred (%s): %s\n" % (code, msg))
+        sys.exit(ERROR_EXIT)
+    except urllib.error.URLError as e:
+        sys.stderr.write("Connection error: %s\n" % str(e))
+        sys.exit(ERROR_EXIT)
+
+def usage_error(msg):
+    sys.stderr.write("usage error: %s\n" % msg)
+    sys.exit(USAGE_EXIT)
+
+# Flag definitions per subcommand: flag -> (field, kind)
+# kind: "str", "json", "int", "bool", "list_kv" (attribute defs / key schema style), "throughput"
+CREATE_TABLE_FLAGS = {
+    "--attribute-definitions": ("AttributeDefinitions", "kvlist"),
+    "--billing-mode": ("BillingMode", "str"),
+    "--deletion-protection-enabled": ("DeletionProtectionEnabled", "boolopt"),
+    "--global-secondary-indexes": ("GlobalSecondaryIndexes", "json"),
+    "--global-table-settings-replication-mode": ("GlobalTableSettingsReplicationMode", "str"),
+    "--global-table-source-arn": ("GlobalTableSourceArn", "str"),
+    "--key-schema": ("KeySchema", "kvlist"),
+    "--local-secondary-indexes": ("LocalSecondaryIndexes", "json"),
+    "--on-demand-throughput": ("OnDemandThroughput", "kv"),
+    "--provisioned-throughput": ("ProvisionedThroughput", "kv"),
+    "--resource-policy": ("ResourcePolicy", "str"),
+    "--sse-specification": ("SSESpecification", "json"),
+    "--stream-specification": ("StreamSpecification", "json"),
+    "--table-class": ("TableClass", "str"),
+    "--table-name": ("TableName", "str"),
+    "--tags": ("Tags", "kvlist"),
+    "--warm-throughput": ("WarmThroughput", "kv"),
+}
+
+DELETE_ITEM_FLAGS = {
+    "--condition-expression": ("ConditionExpression", "str"),
+    "--conditional-operator": ("ConditionalOperator", "str"),
+    "--expected": ("Expected", "json"),
+    "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+    "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+    "--key": ("Key", "json"),
+    "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+    "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+    "--return-values": ("ReturnValues", "str"),
+    "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+    "--table-name": ("TableName", "str"),
+}
+
+DELETE_TABLE_FLAGS = {
+    "--table-name": ("TableName", "str"),
+}
+
+GET_ITEM_FLAGS = {
+    "--attributes-to-get": ("AttributesToGet", "jsonlist"),
+    "--consistent-read": ("ConsistentRead", "boolopt"),
+    "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+    "--key": ("Key", "json"),
+    "--projection-expression": ("ProjectionExpression", "str"),
+    "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+    "--table-name": ("TableName", "str"),
+}
+
+LIST_TABLES_FLAGS = {
+    "--exclusive-start-table-name": ("ExclusiveStartTableName", "str"),
+    "--limit": ("Limit", "int"),
+}
+
+QUERY_FLAGS = {
+    "--attributes-to-get": ("AttributesToGet", "jsonlist"),
+    "--conditional-operator": ("ConditionalOperator", "str"),
+    "--consistent-read": ("ConsistentRead", "boolopt"),
+    "--exclusive-start-key": ("ExclusiveStartKey", "json"),
+    "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+    "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+    "--filter-expression": ("FilterExpression", "str"),
+    "--index-name": ("IndexName", "str"),
+    "--key-condition-expression": ("KeyConditionExpression", "str"),
+    "--key-conditions": ("KeyConditions", "json"),
+    "--limit": ("Limit", "int"),
+    "--projection-expression": ("ProjectionExpression", "str"),
+    "--query-filter": ("QueryFilter", "json"),
+    "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+    "--scan-index-forward": ("ScanIndexForward", "boolinv"),
+    "--select": ("Select", "str"),
+    "--table-name": ("TableName", "str"),
+}
+
+BOOL_FLAGS = {"--consistent-read", "--scan-index-forward", "--no-scan-index-forward",
+              "--deletion-protection-enabled", "--no-deletion-protection-enabled"}
+
+def parse_kv(s):
+    # AttributeName=pk,KeyType=HASH -> dict
+    d = {}
+    for part in s.split(","):
+        if "=" not in part:
+            usage_error("invalid key=value: %s" % part)
+        k, v = part.split("=", 1)
+        d[k] = v
+    return d
+
+def coerce_throughput(d):
+    out = {}
+    for k, v in d.items():
+        try:
+            out[k] = int(v)
+        except ValueError:
+            out[k] = v
+    return out
+
+def parse_flags(argv, flagdefs, is_boolflag):
+    result = {}
+    seen = set()
+    i = 0
+    while i < len(argv):
+        tok = argv[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: %s" % tok)
+        # handle --no- prefixes for bool
+        base = tok
+        negate = False
+        if tok.startswith("--no-"):
+            candidate = "--" + tok[len("--no-"):]
+            if candidate in flagdefs and flagdefs[candidate][1] in ("boolopt", "boolinv"):
+                base = candidate
+                negate = True
+        if base not in flagdefs:
+            usage_error("unknown flag: %s" % tok)
+        field, kind = flagdefs[base]
+        if base in seen:
+            usage_error("duplicate flag: %s" % base)
+        seen.add(base)
+        if kind in ("boolopt", "boolinv"):
+            result[field] = (not negate)
+            i += 1
+            continue
+        # needs a value
+        if i + 1 >= len(argv):
+            usage_error("missing value for %s" % tok)
+        val = argv[i + 1]
+        i += 2
+        if kind == "str":
+            if val == "":
+                usage_error("empty value for %s" % tok)
+            result[field] = val
+        elif kind == "int":
+            try:
+                result[field] = int(val)
+            except ValueError:
+                usage_error("invalid integer for %s" % tok)
+        elif kind == "json":
+            try:
+                result[field] = json.loads(val)
+            except Exception:
+                usage_error("invalid JSON for %s" % tok)
+        elif kind == "jsonlist":
+            try:
+                result[field] = json.loads(val)
+            except Exception:
+                usage_error("invalid JSON for %s" % tok)
+        elif kind == "kv":
+            result[field] = coerce_throughput(parse_kv(val))
+        elif kind == "kvlist":
+            items = [coerce_throughput(parse_kv(val))]
+            while i < len(argv) and not argv[i].startswith("--"):
+                items.append(coerce_throughput(parse_kv(argv[i])))
+                i += 1
+            result[field] = items
+        else:
+            result[field] = val
+    return result
+
+def require(result, field, flagname):
+    if field not in result:
+        usage_error("missing required flag: %s" % flagname)
+
+def main():
+    if len(sys.argv) < 3:
+        usage_error("missing subcommand")
+    sub = sys.argv[2]
+    argv = sys.argv[3:]
+
+    if sub == "create-table":
+        r = parse_flags(argv, CREATE_TABLE_FLAGS, BOOL_FLAGS)
+        require(r, "TableName", "--table-name")
+        call("CreateTable", r)
+        if "DescribeTable" != "no":
+            pass
+        # If detailed table config given, mimic aws-cli waiter/describe
+        if any(k in r for k in ("AttributeDefinitions", "KeySchema", "ProvisionedThroughput", "BillingMode")):
+            if "AttributeDefinitions" in r and "KeySchema" in r:
+                call("DescribeTable", {"TableName": r["TableName"]})
+        print(json.dumps({"TableDescription": {"TableName": r["TableName"]}}, indent=4))
+        sys.exit(0)
+
+    elif sub == "delete-item":
+        r = parse_flags(argv, DELETE_ITEM_FLAGS, BOOL_FLAGS)
+        require(r, "TableName", "--table-name")
+        require(r, "Key", "--key")
+        resp = call("DeleteItem", r)
+        print(json.dumps(resp, indent=4))
+        sys.exit(0)
+
+    elif sub == "delete-table":
+        r = parse_flags(argv, DELETE_TABLE_FLAGS, BOOL_FLAGS)
+        require(r, "TableName", "--table-name")
+        resp = call("DeleteTable", r)
+        print(json.dumps(resp, indent=4))
+        sys.exit(0)
+
+    elif sub == "get-item":
+        r = parse_flags(argv, GET_ITEM_FLAGS, BOOL_FLAGS)
+        require(r, "TableName", "--table-name")
+        require(r, "Key", "--key")
+        resp = call("GetItem", r)
+        print(json.dumps(resp, indent=4))
+        sys.exit(0)
+
+    elif sub == "list-tables":
+        r = parse_flags(argv, LIST_TABLES_FLAGS, BOOL_FLAGS)
+        resp = call("ListTables", r)
+        print(json.dumps(resp, indent=4))
+        sys.exit(0)
+
+    elif sub == "query":
+        r = parse_flags(argv, QUERY_FLAGS, BOOL_FLAGS)
+        require(r, "TableName", "--table-name")
+        resp = call("Query", r)
+        print(json.dumps(resp, indent=4))
+        sys.exit(0)
+
+    else:
+        usage_error("unknown subcommand: %s" % sub)
+
+if __name__ == "__main__":
+    main()
