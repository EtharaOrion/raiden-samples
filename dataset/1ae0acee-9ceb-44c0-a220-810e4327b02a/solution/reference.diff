+#!/usr/bin/env python3
+import sys
+import os
+import hashlib
+import hmac
+import datetime
+import urllib.parse
+import http.client
+import xml.etree.ElementTree as ET
+
+S3_NS = 'http://s3.amazonaws.com/doc/2006-03-01/'
+EMPTY_SHA256 = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
+
+
+class ClientError(Exception):
+    def __init__(self, code, message, status=400):
+        self.code = code
+        self.message = message
+        self.status = status
+        super().__init__(message)
+
+    def __str__(self):
+        return ("An error occurred (%s) when calling the operation: %s"
+                % (self.code, self.message))
+
+
+def get_config():
+    ak = os.environ.get('AWS_ACCESS_KEY_ID', 'testing')
+    sk = os.environ.get('AWS_SECRET_ACCESS_KEY', 'testing')
+    st = os.environ.get('AWS_SESSION_TOKEN')
+    region = os.environ.get('AWS_REGION') or os.environ.get('AWS_DEFAULT_REGION') or 'us-east-1'
+    endpoint = os.environ.get('AWS_ENDPOINT_URL_S3') or os.environ.get('AWS_ENDPOINT_URL') or 'http://localhost:4566'
+    return ak, sk, st, region, endpoint
+
+
+def uri_encode_segment(seg):
+    return urllib.parse.quote(seg, safe='-_.~')
+
+
+def encode_path(path):
+    parts = path.split('/')
+    return '/'.join(uri_encode_segment(p) for p in parts)
+
+
+def sigv4_headers(method, endpoint, canonical_path, query, body, extra_headers=None):
+    ak, sk, st, region, _ = get_config()
+    parsed = urllib.parse.urlparse(endpoint)
+    host = parsed.netloc
+    now = datetime.datetime.now(datetime.timezone.utc)
+    amzdate = now.strftime('%Y%m%dT%H%M%SZ')
+    datestamp = now.strftime('%Y%m%d')
+
+    payload_hash = EMPTY_SHA256 if not body else hashlib.sha256(body).hexdigest()
+
+    headers = {
+        'host': host,
+        'x-amz-content-sha256': payload_hash,
+        'x-amz-date': amzdate,
+    }
+    if st:
+        headers['x-amz-security-token'] = st
+    if extra_headers:
+        for k, v in extra_headers.items():
+            headers[k.lower()] = v
+
+    canonical_uri = encode_path(canonical_path)
+    if not canonical_uri.startswith('/'):
+        canonical_uri = '/' + canonical_uri
+
+    if query:
+        items = []
+        for k in sorted(query.keys()):
+            items.append((urllib.parse.quote(k, safe='-_.~'),
+                          urllib.parse.quote(str(query[k]), safe='-_.~')))
+        canonical_qs = '&'.join('%s=%s' % (k, v) for k, v in items)
+    else:
+        canonical_qs = ''
+
+    signed_names = sorted(headers.keys())
+    canonical_headers = ''.join('%s:%s\n' % (n, headers[n]) for n in signed_names)
+    signed_headers = ';'.join(signed_names)
+
+    canonical_request = '\n'.join([
+        method, canonical_uri, canonical_qs, canonical_headers,
+        signed_headers, payload_hash])
+
+    scope = '%s/%s/s3/aws4_request' % (datestamp, region)
+    string_to_sign = '\n'.join([
+        'AWS4-HMAC-SHA256', amzdate, scope,
+        hashlib.sha256(canonical_request.encode('utf-8')).hexdigest()])
+
+    def _hmac(key, msg):
+        return hmac.new(key, msg.encode('utf-8'), hashlib.sha256).digest()
+
+    kdate = _hmac(('AWS4' + sk).encode('utf-8'), datestamp)
+    kregion = _hmac(kdate, region)
+    kservice = _hmac(kregion, 's3')
+    ksigning = _hmac(kservice, 'aws4_request')
+    signature = hmac.new(ksigning, string_to_sign.encode('utf-8'), hashlib.sha256).hexdigest()
+
+    authorization = ('AWS4-HMAC-SHA256 Credential=%s/%s, SignedHeaders=%s, Signature=%s'
+                     % (ak, scope, signed_headers, signature))
+    out = dict(headers)
+    out['Authorization'] = authorization
+    return out
+
+
+def make_request(method, bucket=None, key=None, query=None, body=None, extra_headers=None):
+    ak, sk, st, region, endpoint = get_config()
+    parsed = urllib.parse.urlparse(endpoint)
+    path = '/'
+    if bucket:
+        path = '/' + bucket
+        if key:
+            path += '/' + key
+    headers = sigv4_headers(method, endpoint, path, query, body, extra_headers)
+
+    if query:
+        qs = urllib.parse.urlencode(query)
+        url_path = encode_path(path) + '?' + qs
+    else:
+        url_path = encode_path(path)
+
+    if parsed.scheme == 'https':
+        conn = http.client.HTTPSConnection(parsed.netloc, timeout=60)
+    else:
+        conn = http.client.HTTPConnection(parsed.netloc, timeout=60)
+
+    send_headers = dict(headers)
+    try:
+        conn.request(method, url_path, body=body, headers=send_headers)
+        resp = conn.getresponse()
+        data = resp.read()
+        status = resp.status
+    except Exception as e:
+        raise ClientError('EndpointConnectionError', str(e), 0)
+    finally:
+        try:
+            conn.close()
+        except Exception:
+            pass
+
+    if status >= 300:
+        code, msg = parse_error(data, status)
+        raise ClientError(code, msg, status)
+    return status, data
+
+
+def parse_error(data, status):
+    code = 'Unknown'
+    msg = 'Unknown error'
+    if data:
+        try:
+            root = ET.fromstring(data)
+            c = root.find('.//Code')
+            m = root.find('.//Message')
+            if c is not None and c.text:
+                code = c.text
+            if m is not None and m.text:
+                msg = m.text
+        except Exception:
+            pass
+    if code == 'Unknown':
+        if status == 404:
+            code = 'NoSuchBucket'
+            msg = 'The specified bucket does not exist'
+        elif status == 403:
+            code = 'AccessDenied'
+            msg = 'Access Denied'
+    return code, msg
+
+
+def strip_ns(tag):
+    if '}' in tag:
+        return tag.split('}', 1)[1]
+    return tag
+
+
+def find_bucket_key(s3path):
+    if s3path.startswith('s3://'):
+        s3path = s3path[5:]
+    parts = s3path.split('/', 1)
+    bucket = parts[0]
+    key = parts[1] if len(parts) > 1 else ''
+    return bucket, key
+
+
+def split_s3_bucket_key(path):
+    if path.startswith('s3://'):
+        p = path[5:]
+    else:
+        p = path
+    return find_bucket_key(p)
+
+
+def is_s3express_bucket(bucket):
+    return bucket.endswith('--x-s3')
+
+
+# ---------------- S3 operations ----------------
+
+def create_bucket(bucket):
+    ak, sk, st, region, endpoint = get_config()
+    body = None
+    if region != 'us-east-1':
+        body = ('<?xml version="1.0" encoding="UTF-8"?>'
+                '<CreateBucketConfiguration xmlns="%s">'
+                '<LocationConstraint>%s</LocationConstraint>'
+                '</CreateBucketConfiguration>' % (S3_NS, region)).encode('utf-8')
+    make_request('PUT', bucket=bucket, body=body)
+
+
+def delete_bucket(bucket):
+    make_request('DELETE', bucket=bucket)
+
+
+def put_object(bucket, key, body, extra_headers=None):
+    make_request('PUT', bucket=bucket, key=key, body=body, extra_headers=extra_headers)
+
+
+def get_object(bucket, key):
+    status, data = make_request('GET', bucket=bucket, key=key)
+    return data
+
+
+def delete_object(bucket, key):
+    make_request('DELETE', bucket=bucket, key=key)
+
+
+def list_objects_v2(bucket, prefix='', delimiter=None):
+    results = []
+    prefixes = []
+    token = None
+    while True:
+        query = {'list-type': '2'}
+        if prefix:
+            query['prefix'] = prefix
+        if delimiter:
+            query['delimiter'] = delimiter
+        if token:
+            query['continuation-token'] = token
+        status, data = make_request('GET', bucket=bucket, query=query)
+        root = ET.fromstring(data)
+        truncated = False
+        next_token = None
+        for child in root:
+            tag = strip_ns(child.tag)
+            if tag == 'Contents':
+                obj = {}
+                for c in child:
+                    ct = strip_ns(c.tag)
+                    obj[ct] = c.text
+                results.append(obj)
+            elif tag == 'CommonPrefixes':
+                for c in child:
+                    if strip_ns(c.tag) == 'Prefix':
+                        prefixes.append(c.text)
+            elif tag == 'IsTruncated':
+                truncated = (child.text == 'true')
+            elif tag == 'NextContinuationToken':
+                next_token = child.text
+        if truncated and next_token:
+            token = next_token
+        else:
+            break
+    return results, prefixes
+
+
+# ---------------- Command implementations ----------------
+
+USAGE_ERR = 252
+
+
+def err_print(msg):
+    sys.stderr.write(msg)
+    if not msg.endswith('\n'):
+        sys.stderr.write('\n')
+
+
+def reject_unknown(extra):
+    """aws-cli 2.28.23: unrecognized options exit 252 'Unknown options: ...'."""
+    unknown = [a for a in extra if a.startswith('-')]
+    if unknown:
+        err_print('Unknown options: %s' % ','.join(unknown))
+        return True
+    return False
+
+
+def cmd_mb(args):
+    import argparse
+    p = argparse.ArgumentParser(prog='aws s3 mb', add_help=False)
+    p.add_argument('path')
+    p.add_argument('--region')
+    p.add_argument('--endpoint-url')
+    ns, extra = p.parse_known_args(args)
+    if reject_unknown(extra):
+        return USAGE_ERR
+
+    path = ns.path
+    if not path.startswith('s3://'):
+        err_print('Error: Invalid argument type')
+        return USAGE_ERR
+    bucket, _k = split_s3_bucket_key(path)
+    if is_s3express_bucket(bucket):
+        err_print('Cannot use mb command with a directory bucket.')
+        return USAGE_ERR
+    if ns.region:
+        os.environ['AWS_REGION'] = ns.region
+        os.environ['AWS_DEFAULT_REGION'] = ns.region
+    try:
+        create_bucket(bucket)
+        sys.stdout.write('make_bucket: %s\n' % bucket)
+        return 0
+    except ClientError as e:
+        err_print('make_bucket failed: %s %s' % (path, e))
+        return 1
+
+
+def cmd_rb(args):
+    import argparse
+    p = argparse.ArgumentParser(prog='aws s3 rb', add_help=False)
+    p.add_argument('path')
+    p.add_argument('--force', action='store_true')
+    p.add_argument('--region')
+    p.add_argument('--endpoint-url')
+    ns, extra = p.parse_known_args(args)
+    if reject_unknown(extra):
+        return USAGE_ERR
+
+    path = ns.path
+    if not path.startswith('s3://'):
+        err_print('Error: Invalid argument type')
+        return USAGE_ERR
+    bucket, key = split_s3_bucket_key(path)
+    if key:
+        err_print('Please specify a valid bucket name only. E.g. s3://%s' % bucket)
+        return USAGE_ERR
+
+    if ns.region:
+        os.environ['AWS_REGION'] = ns.region
+        os.environ['AWS_DEFAULT_REGION'] = ns.region
+
+    if ns.force:
+        try:
+            objs, _pref = list_objects_v2(bucket, '')
+        except ClientError as e:
+            err_print('remove_bucket failed: %s %s' % (path, e))
+            return 255
+        for obj in objs:
+            k = obj.get('Key')
+            try:
+                delete_object(bucket, k)
+                sys.stdout.write('delete: s3://%s/%s\n' % (bucket, k))
+            except ClientError as e:
+                err_print('delete failed: s3://%s/%s %s' % (bucket, k, e))
+                return 255
+
+    try:
+        delete_bucket(bucket)
+        sys.stdout.write('remove_bucket: %s\n' % bucket)
+        return 0
+    except ClientError as e:
+        err_print('remove_bucket failed: %s %s' % (path, e))
+        return 1
+
+
+TRANSFER_FLAGS_VALUE = [
+    '--copy-props', '--checksum-algorithm', '--checksum-mode', '--content-type',
+    '--content-encoding', '--content-disposition', '--content-language',
+    '--cache-control', '--expires', '--metadata', '--metadata-directive',
+    '--acl', '--grants', '--expected-size', '--page-size', '--sse',
+    '--sse-c', '--sse-c-key', '--sse-kms-key-id', '--sse-c-copy-source',
+    '--sse-c-copy-source-key', '--website-redirect',
+    '--storage-class', '--region', '--endpoint-url', '--source-region',
+]
+TRANSFER_FLAGS_BOOL = [
+    '--quiet', '--only-show-errors', '--no-progress', '--no-guess-mime-type',
+    '--follow-symlinks', '--no-follow-symlinks', '--recursive', '--dryrun',
+    '--force-glacier-transfer', '--ignore-glacier-warnings',
+    '--size-only', '--exact-timestamps', '--delete', '--no-verify-ssl',
+]
+
+
+def transfer_put_headers(ns):
+    """Build extra PUT headers from parsed transfer flags (aws-cli 2.28.23)."""
+    extra = {}
+    wr = getattr(ns, 'website_redirect', None)
+    if wr:
+        extra['x-amz-website-redirect-location'] = wr
+    rp = getattr(ns, 'request_payer', None)
+    if rp:
+        extra['x-amz-request-payer'] = rp
+    return extra or None
+
+
+def build_transfer_parser(prog):
+    import argparse
+    p = argparse.ArgumentParser(prog=prog, add_help=False)
+    p.add_argument('paths', nargs='*')
+    for f in TRANSFER_FLAGS_VALUE:
+        p.add_argument(f, dest=f.lstrip('-').replace('-', '_'))
+    for f in TRANSFER_FLAGS_BOOL:
+        p.add_argument(f, dest=f.lstrip('-').replace('-', '_'), action='store_true')
+    # --request-payer is a bare flag (nargs='?' const='requester') per aws-cli 2.28.23
+    p.add_argument('--request-payer', dest='request_payer', nargs='?',
+                   const='requester', default=None, choices=['requester'])
+    p.add_argument('--exclude', action='append', default=[])
+    p.add_argument('--include', action='append', default=[])
+    return p
+
+
+def cmd_mv(args):
+    p = build_transfer_parser('aws s3 mv')
+    ns, unknown = p.parse_known_args(args)
+    paths = ns.paths
+    if len(paths) != 2:
+        err_print('aws: error: the following arguments are required: paths')
+        return USAGE_ERR
+    src, dst = paths[0], paths[1]
+
+    if ns.region:
+        os.environ['AWS_REGION'] = ns.region
+        os.environ['AWS_DEFAULT_REGION'] = ns.region
+
+    src_is_s3 = src.startswith('s3://')
+    dst_is_s3 = dst.startswith('s3://')
+
+    # same source/dest error
+    if src_is_s3 and dst_is_s3:
+        sb, sk = find_bucket_key(src)
+        db, dk = find_bucket_key(dst)
+        if sb == db and sk == dk and sk:
+            err_print('Cannot mv a file onto itself.')
+            return USAGE_ERR
+        # dest ends with / -> keep basename
+        if dk == '' or dst.endswith('/'):
+            base = sk.split('/')[-1]
+            dk = dk + base
+            if not dk:
+                err_print('Cannot mv a file onto itself.')
+                return USAGE_ERR
+            dst = 's3://%s/%s' % (db, dk)
+        # same after resolution
+        if sb == db and sk == dk:
+            err_print('Cannot mv a file onto itself.')
+            return USAGE_ERR
+
+    dry = ns.dryrun
+
+    try:
+        if not src_is_s3 and dst_is_s3:
+            # upload
+            db, dk = find_bucket_key(dst)
+            if dk == '' or dst.endswith('/'):
+                dk = dk + os.path.basename(src)
+            if dry:
+                sys.stdout.write('(dryrun) move: %s to s3://%s/%s\n' % (src, db, dk))
+                return 0
+            if src == '-':
+                data = sys.stdin.buffer.read()
+            else:
+                with open(src, 'rb') as f:
+                    data = f.read()
+            put_object(db, dk, data, extra_headers=transfer_put_headers(ns))
+            if src != '-':
+                try:
+                    os.remove(src)
+                except OSError:
+                    pass
+            sys.stdout.write('move: %s to s3://%s/%s\n' % (src, db, dk))
+            return 0
+        elif src_is_s3 and not dst_is_s3:
+            sb, sk = find_bucket_key(src)
+            outpath = dst
+            if os.path.isdir(dst) or dst.endswith('/'):
+                outpath = os.path.join(dst, sk.split('/')[-1])
+            if dry:
+                sys.stdout.write('(dryrun) move: s3://%s/%s to %s\n' % (sb, sk, outpath))
+                return 0
+            data = get_object(sb, sk)
+            with open(outpath, 'wb') as f:
+                f.write(data)
+            delete_object(sb, sk)
+            sys.stdout.write('move: s3://%s/%s to %s\n' % (sb, sk, outpath))
+            return 0
+        elif src_is_s3 and dst_is_s3:
+            sb, sk = find_bucket_key(src)
+            db, dk = find_bucket_key(dst)
+            if dry:
+                sys.stdout.write('(dryrun) move: s3://%s/%s to s3://%s/%s\n' % (sb, sk, db, dk))
+                return 0
+            data = get_object(sb, sk)
+            put_object(db, dk, data, extra_headers=transfer_put_headers(ns))
+            delete_object(sb, sk)
+            sys.stdout.write('move: s3://%s/%s to s3://%s/%s\n' % (sb, sk, db, dk))
+            return 0
+        else:
+            err_print('Error: Invalid argument type')
+            return USAGE_ERR
+    except ClientError as e:
+        if not src_is_s3:
+            err_print('move failed: %s to %s %s' % (src, dst, e))
+        elif not dst_is_s3:
+            err_print('move failed: %s to %s %s' % (src, dst, e))
+        else:
+            err_print('move failed: %s to %s %s' % (src, dst, e))
+        return 1
+    except FileNotFoundError:
+        err_print('move failed: %s to %s The user-provided path %s does not exist.' % (src, dst, src))
+        return 255
+
+
+def cmd_rm(args):
+    p = build_transfer_parser('aws s3 rm')
+    ns, unknown = p.parse_known_args(args)
+    if reject_unknown(unknown):
+        return USAGE_ERR
+    paths = ns.paths
+    if len(paths) != 1:
+        err_print('aws: error: the following arguments are required: paths')
+        return USAGE_ERR
+    path = paths[0]
+    if not path.startswith('s3://'):
+        err_print('Error: Invalid argument type')
+        return USAGE_ERR
+
+    if ns.region:
+        os.environ['AWS_REGION'] = ns.region
+        os.environ['AWS_DEFAULT_REGION'] = ns.region
+
+    bucket, key = find_bucket_key(path)
+    dry = ns.dryrun
+
+    if ns.recursive:
+        try:
+            objs, _pref = list_objects_v2(bucket, key)
+        except ClientError as e:
+            err_print('delete failed: %s %s' % (path, e))
+            return 1
+        rc = 0
+        for obj in objs:
+            k = obj.get('Key')
+            if dry:
+                sys.stdout.write('(dryrun) delete: s3://%s/%s\n' % (bucket, k))
+                continue
+            try:
+                delete_object(bucket, k)
+                sys.stdout.write('delete: s3://%s/%s\n' % (bucket, k))
+            except ClientError as e:
+                err_print('delete failed: s3://%s/%s %s' % (bucket, k, e))
+                rc = 1
+        return rc
+    else:
+        if dry:
+            sys.stdout.write('(dryrun) delete: s3://%s/%s\n' % (bucket, key))
+            return 0
+        try:
+            delete_object(bucket, key)
+            sys.stdout.write('delete: s3://%s/%s\n' % (bucket, key))
+            return 0
+        except ClientError as e:
+            err_print('delete failed: s3://%s/%s %s' % (bucket, key, e))
+            return 1
+
+
+def cmd_sync(args):
+    p = build_transfer_parser('aws s3 sync')
+    ns, unknown = p.parse_known_args(args)
+    paths = ns.paths
+    if len(paths) != 2:
+        err_print('aws: error: the following arguments are required: paths')
+        return USAGE_ERR
+    src, dst = paths[0], paths[1]
+
+    # sync does not accept --recursive
+    if '--recursive' in args:
+        err_print('aws: error: unrecognized arguments: --recursive')
+        return USAGE_ERR
+
+    if ns.region:
+        os.environ['AWS_REGION'] = ns.region
+        os.environ['AWS_DEFAULT_REGION'] = ns.region
+
+    src_is_s3 = src.startswith('s3://')
+    dst_is_s3 = dst.startswith('s3://')
+    dry = ns.dryrun
+
+    try:
+        if not src_is_s3 and dst_is_s3:
+            db, dprefix = find_bucket_key(dst)
+            # aws-cli always treats the s3 dest as a prefix (with or without a
+            # trailing slash); it never rejects a dir->object sync.
+            existing = {}
+            try:
+                objs, _pref = list_objects_v2(db, dprefix)
+                for o in objs:
+                    existing[o.get('Key')] = o
+            except ClientError as e:
+                err_print('sync failed: %s' % e)
+                return 255
+            if not os.path.isdir(src):
+                err_print('The user-provided path %s does not exist.' % src)
+                return 255
+            rc = 0
+            for root, _dirs, files in os.walk(src):
+                for fn in files:
+                    full = os.path.join(root, fn)
+                    rel = os.path.relpath(full, src).replace(os.sep, '/')
+                    remotekey = (dprefix.rstrip('/') + '/' + rel) if dprefix else rel
+                    size = os.path.getsize(full)
+                    need = True
+                    ex = existing.get(remotekey)
+                    if ex is not None:
+                        try:
+                            if int(ex.get('Size', -1)) == size:
+                                need = False
+                        except Exception:
+                            pass
+                    if not need:
+                        continue
+                    if dry:
+                        sys.stdout.write('(dryrun) upload: %s to s3://%s/%s\n' % (full, db, remotekey))
+                        continue
+                    try:
+                        with open(full, 'rb') as f:
+                            data = f.read()
+                        put_object(db, remotekey, data, extra_headers=transfer_put_headers(ns))
+                        sys.stdout.write('upload: %s to s3://%s/%s\n' % (full, db, remotekey))
+                    except ClientError as e:
+                        err_print('upload failed: %s to s3://%s/%s %s' % (full, db, remotekey, e))
+                        rc = 1
+            return rc
+        elif src_is_s3 and not dst_is_s3:
+            sb, sprefix = find_bucket_key(src)
+            try:
+                objs, _pref = list_objects_v2(sb, sprefix)
+            except ClientError as e:
+                err_print('sync failed: %s' % e)
+                return 255
+            if not os.path.isdir(dst):
+                try:
+                    os.makedirs(dst, exist_ok=True)
+                except OSError:
+                    pass
+            rc = 0
+            for o in objs:
+                k = o.get('Key')
+                rel = k[len(sprefix):] if sprefix and k.startswith(sprefix) else k
+                rel = rel.lstrip('/')
+                outpath = os.path.join(dst, rel)
+                if dry:
+                    sys.stdout.write('(dryrun) download: s3://%s/%s to %s\n' % (sb, k, outpath))
+                    continue
+                try:
+                    data = get_object(sb, k)
+                    d = os.path.dirname(outpath)
+                    if d:
+                        os.makedirs(d, exist_ok=True)
+                    with open(outpath, 'wb') as f:
+                        f.write(data)
+                    sys.stdout.write('download: s3://%s/%s to %s\n' % (sb, k, outpath))
+                except ClientError as e:
+                    err_print('download failed: s3://%s/%s to %s %s' % (sb, k, outpath, e))
+                    rc = 1
+            return rc
+        elif src_is_s3 and dst_is_s3:
+            sb, sprefix = find_bucket_key(src)
+            db, dprefix = find_bucket_key(dst)
+            try:
+                sobjs, _p = list_objects_v2(sb, sprefix)
+            except ClientError as e:
+                err_print('sync failed: %s' % e)
+                return 255
+            existing = {}
+            try:
+                dobjs, _p2 = list_objects_v2(db, dprefix)
+                for o in dobjs:
+                    existing[o.get('Key')] = o
+            except ClientError:
+                pass
+            rc = 0
+            for o in sobjs:
+                k = o.get('Key')
+                rel = k[len(sprefix):] if sprefix and k.startswith(sprefix) else k
+                rel = rel.lstrip('/')
+                destkey = (dprefix.rstrip('/') + '/' + rel) if dprefix else rel
+                if dry:
+                    sys.stdout.write('(dryrun) copy: s3://%s/%s to s3://%s/%s\n' % (sb, k, db, destkey))
+                    continue
+                try:
+                    data = get_object(sb, k)
+                    put_object(db, destkey, data)
+                    sys.stdout.write('copy: s3://%s/%s to s3://%s/%s\n' % (sb, k, db, destkey))
+                except ClientError as e:
+                    err_print('copy failed: s3://%s/%s to s3://%s/%s %s' % (sb, k, db, destkey, e))
+                    rc = 1
+            return rc
+        else:
+            err_print('Error: Invalid argument type')
+            return USAGE_ERR
+    except ClientError as e:
+        err_print('sync failed: %s' % e)
+        return 255
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 2:
+        err_print('usage: aws s3 <command>')
+        return USAGE_ERR
+    if argv[1] != 's3':
+        err_print("aws: error: argument command: Invalid choice: '%s'" % argv[1])
+        return USAGE_ERR
+    if len(argv) < 3:
+        err_print('usage: aws s3 <command>')
+        return USAGE_ERR
+    sub = argv[2]
+    rest = argv[3:]
+    if sub == 'mb':
+        return cmd_mb(rest)
+    elif sub == 'rb':
+        return cmd_rb(rest)
+    elif sub == 'mv':
+        return cmd_mv(rest)
+    elif sub == 'rm':
+        return cmd_rm(rest)
+    elif sub == 'sync':
+        return cmd_sync(rest)
+    else:
+        err_print("aws: error: argument subcommand: Invalid choice: '%s'" % sub)
+        return USAGE_ERR
+
+
+if __name__ == '__main__':
+    try:
+        sys.exit(main())
+    except BrokenPipeError:
+        sys.exit(0)
+    except KeyboardInterrupt:
+        sys.exit(130)
+    except ClientError as e:
+        err_print(str(e))
+        sys.exit(1)
