@@ -0,0 +1,220 @@
+import sys
+import os
+import json
+import urllib.request
+import urllib.error
+
+
+class UsageError(Exception):
+    pass
+
+
+# subcommand -> {flag: type}
+# type: 'str', 'json', 'int', 'bool'
+SPECS = {
+    "delete-item": {
+        "--condition-expression": "str",
+        "--conditional-operator": "str",
+        "--expected": "json",
+        "--expression-attribute-names": "json",
+        "--expression-attribute-values": "json",
+        "--key": "json",
+        "--return-consumed-capacity": "str",
+        "--return-item-collection-metrics": "str",
+        "--return-values": "str",
+        "--return-values-on-condition-check-failure": "str",
+        "--table-name": "str",
+    },
+    "delete-table": {
+        "--table-name": "str",
+    },
+    "get-item": {
+        "--attributes-to-get": "json",
+        "--consistent-read": "bool",
+        "--expression-attribute-names": "json",
+        "--key": "json",
+        "--projection-expression": "str",
+        "--return-consumed-capacity": "str",
+        "--table-name": "str",
+    },
+    "list-tables": {
+        "--exclusive-start-table-name": "str",
+        "--limit": "int",
+    },
+    "query": {
+        "--attributes-to-get": "json",
+        "--conditional-operator": "str",
+        "--consistent-read": "bool",
+        "--exclusive-start-key": "json",
+        "--expression-attribute-names": "json",
+        "--expression-attribute-values": "json",
+        "--filter-expression": "str",
+        "--index-name": "str",
+        "--key-condition-expression": "str",
+        "--key-conditions": "json",
+        "--limit": "int",
+        "--projection-expression": "str",
+        "--query-filter": "json",
+        "--return-consumed-capacity": "str",
+        "--scan-index-forward": "bool",
+        "--select": "str",
+        "--table-name": "str",
+    },
+    "update-item": {
+        "--attribute-updates": "json",
+        "--condition-expression": "str",
+        "--conditional-operator": "str",
+        "--expected": "json",
+        "--expression-attribute-names": "json",
+        "--expression-attribute-values": "json",
+        "--key": "json",
+        "--return-consumed-capacity": "str",
+        "--return-item-collection-metrics": "str",
+        "--return-values": "str",
+        "--return-values-on-condition-check-failure": "str",
+        "--table-name": "str",
+        "--update-expression": "str",
+    },
+}
+
+# subcommand -> DynamoDB target op
+OPS = {
+    "delete-item": "DeleteItem",
+    "delete-table": "DeleteTable",
+    "get-item": "GetItem",
+    "list-tables": "ListTables",
+    "query": "Query",
+    "update-item": "UpdateItem",
+}
+
+
+def flag_to_field(flag):
+    name = flag[2:]  # strip --
+    parts = name.split("-")
+    return "".join(p[:1].upper() + p[1:] for p in parts)
+
+
+def parse_args(spec, argv):
+    result = {}
+    seen = set()
+    i = 0
+    n = len(argv)
+    while i < n:
+        tok = argv[i]
+        if not tok.startswith("--"):
+            raise UsageError("unexpected argument: %s" % tok)
+        if tok not in spec:
+            raise UsageError("unknown flag: %s" % tok)
+        if tok in seen:
+            raise UsageError("duplicate flag: %s" % tok)
+        seen.add(tok)
+        typ = spec[tok]
+        if typ == "bool":
+            # store-true style flag (also allow explicit value forms upstream)
+            result[tok] = True
+            i += 1
+            continue
+        # requires a value
+        if i + 1 >= n:
+            raise UsageError("flag %s requires a value" % tok)
+        val = argv[i + 1]
+        if typ == "str":
+            if val == "":
+                raise UsageError("flag %s requires a non-empty value" % tok)
+            result[tok] = val
+        elif typ == "int":
+            try:
+                result[tok] = int(val)
+            except ValueError:
+                raise UsageError("flag %s requires an integer" % tok)
+        elif typ == "json":
+            try:
+                result[tok] = json.loads(val)
+            except (ValueError, json.JSONDecodeError):
+                raise UsageError("flag %s requires valid JSON" % tok)
+        i += 2
+    return result
+
+
+def build_request(spec, parsed):
+    body = {}
+    for flag, val in parsed.items():
+        field = flag_to_field(flag)
+        body[field] = val
+    return body
+
+
+def call_ddb(op, body):
+    endpoint = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ["AWS_ENDPOINT_URL"]
+    data = json.dumps(body).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810.%s" % op)
+    req.add_header(
+        "Authorization",
+        "AWS4-HMAC-SHA256 Credential=dummy/20120810/us-east-1/dynamodb/aws4_request, "
+        "SignedHeaders=host;x-amz-target, Signature=dummy",
+    )
+    try:
+        resp = urllib.request.urlopen(req)
+        raw = resp.read()
+        if raw:
+            return json.loads(raw.decode("utf-8"))
+        return {}
+    except urllib.error.HTTPError as e:
+        raw = e.read()
+        try:
+            parsed = json.loads(raw.decode("utf-8"))
+        except Exception:
+            parsed = {"message": raw.decode("utf-8", "replace")}
+        code = parsed.get("__type") or parsed.get("code") or "ServiceError"
+        if "#" in code:
+            code = code.split("#", 1)[1]
+        msg = parsed.get("message") or parsed.get("Message") or ""
+        raise ServiceError(code, msg)
+
+
+class ServiceError(Exception):
+    def __init__(self, code, message):
+        super().__init__(message)
+        self.code = code
+        self.message = message
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        sys.stderr.write("usage: main.py <prefix> <command> [args...]\n")
+        return 252
+    subcommand = argv[2]
+    if subcommand not in SPECS:
+        sys.stderr.write("unknown command: %s\n" % subcommand)
+        return 252
+
+    spec = SPECS[subcommand]
+    try:
+        parsed = parse_args(spec, argv[3:])
+    except UsageError as e:
+        sys.stderr.write("usage error: %s\n" % e)
+        return 252
+
+    body = build_request(spec, parsed)
+    op = OPS[subcommand]
+
+    try:
+        result = call_ddb(op, body)
+    except ServiceError as e:
+        sys.stderr.write("%s: %s\n" % (e.code, e.message))
+        return 254
+    except KeyError:
+        sys.stderr.write("endpoint not configured\n")
+        return 254
+
+    out = json.dumps(result, indent=4) if result else ""
+    if out:
+        sys.stdout.write(out + "\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
