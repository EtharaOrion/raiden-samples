+}
+
+UPDATE_ITEM = {
+    "--attribute-updates": ("AttributeUpdates", "json"),
+    "--condition-expression": ("ConditionExpression", "str"),
+    "--conditional-operator": ("ConditionalOperator", "str"),
+    "--expected": ("Expected", "json"),
+    "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+    "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+    "--key": ("Key", "json"),
+    "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+    "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+    "--return-values": ("ReturnValues", "str"),
+    "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+    "--table-name": ("TableName", "str"),
+    "--update-expression": ("UpdateExpression", "str"),
+}
+
+
+def parse_shorthand(s):
+    # Key=Val,Key=Val
+    out = {}
+    for pair in s.split(","):
+        if "=" not in pair:
+            usage("invalid shorthand: %s" % s)
+        k, v = pair.split("=", 1)
+        out[k.strip()] = v.strip()
+    return out
+
+
+def parse_attrdefs(values):
+    # list of AttributeName=x,AttributeType=y
+    out = []
+    for v in values:
+        d = parse_shorthand(v)
+        if "AttributeName" not in d or "AttributeType" not in d:
+            usage("invalid attribute-definitions")
+        out.append({"AttributeName": d["AttributeName"], "AttributeType": d["AttributeType"]})
+    return out
+
+
+def parse_keyschema(values):
+    out = []
+    for v in values:
+        d = parse_shorthand(v)
+        if "AttributeName" not in d or "KeyType" not in d:
+            usage("invalid key-schema")
+        out.append({"AttributeName": d["AttributeName"], "KeyType": d["KeyType"]})
+    return out
+
+
+def parse_json(s):
+    try:
+        return json.loads(s)
+    except Exception:
+        usage("invalid JSON: %s" % s)
+
+
+def parse_args(spec, args):
+    result = {}
+    seen = set()
+    i = 0
+    n = len(args)
+    while i < n:
+        tok = args[i]
+        if not tok.startswith("--"):
+            usage("unexpected argument: %s" % tok)
+        if tok not in spec:
+            usage("unknown flag: %s" % tok)
+        field, typ = spec[tok]
+        if typ == "bool":
+            result[field] = True
+            seen.add(tok)
+            i += 1
+            continue
+        # need a value (or multiple for list types)
+        if typ in ("attrdefs", "keyschema", "list"):
+            vals = []
+            i += 1
+            while i < n and not args[i].startswith("--"):
+                vals.append(args[i])
+                i += 1
+            if not vals:
+                usage("flag %s requires a value" % tok)
+            if tok in seen:
+                usage("duplicate flag: %s" % tok)
+            seen.add(tok)
+            if typ == "attrdefs":
+                result[field] = parse_attrdefs(vals)
+            elif typ == "keyschema":
+                result[field] = parse_keyschema(vals)
+            else:
+                result[field] = vals
+            continue
+        # single value flags
+        i += 1
+        if i >= n:
+            usage("flag %s requires a value" % tok)
+        val = args[i]
+        i += 1
+        if tok in seen:
+            usage("duplicate flag: %s" % tok)
+        seen.add(tok)
+        if typ == "str":
+            if val == "":
+                usage("flag %s requires a non-empty value" % tok)
+            result[field] = val
+        elif typ == "int":
+            try:
+                result[field] = int(val)
+            except ValueError:
+                usage("flag %s requires an integer" % tok)
+        elif typ == "bool_val":
+            if val.lower() == "true":
+                result[field] = True
+            elif val.lower() == "false":
+                result[field] = False
+            else:
+                usage("flag %s requires true/false" % tok)
+        elif typ == "json":
+            result[field] = parse_json(val)
+        elif typ in ("shorthand",):
+            result[field] = parse_shorthand(val)
+        elif typ == "shorthand_int":
+            d = parse_shorthand(val)
+            conv = {}
+            for k, vv in d.items():
+                try:
+                    conv[k] = int(vv)
+                except ValueError:
+                    conv[k] = vv
+            result[field] = conv
+        else:
+            result[field] = val
+    return result
+
+
+def require(payload, field, flag):
+    if field not in payload:
+        usage("missing required flag: %s" % flag)
+
+
+def do_create_table(args):
+    p = parse_args(CREATE_TABLE, args)
+    require(p, "TableName", "--table-name")
+    describe = "AttributeDefinitions" in p or "KeySchema" in p or "BillingMode" in p or "ProvisionedThroughput" in p
+    if "AttributeDefinitions" not in p:
+        p["AttributeDefinitions"] = [{"AttributeName": "id", "AttributeType": "S"}]
+    if "KeySchema" not in p:
+        p["KeySchema"] = [{"AttributeName": "id", "KeyType": "HASH"}]
+    if "BillingMode" not in p and "ProvisionedThroughput" not in p:
+        p["BillingMode"] = "PAY_PER_REQUEST"
+    if "ProvisionedThroughput" not in p and p.get("BillingMode") != "PAY_PER_REQUEST":
+        p["ProvisionedThroughput"] = {"ReadCapacityUnits": 5, "WriteCapacityUnits": 5}
+    out = call("CreateTable", p)
+    if describe:
+        call("DescribeTable", {"TableName": p["TableName"]})
+    print(json.dumps(out, indent=4))
+
+
+def do_delete_table(args):
+    p = parse_args(DELETE_TABLE, args)
+    require(p, "TableName", "--table-name")
+    out = call("DeleteTable", p)
+    print(json.dumps(out, indent=4))
+
+
+def do_delete_item(args):
+    p = parse_args(DELETE_ITEM, args)
+    require(p, "TableName", "--table-name")
+    require(p, "Key", "--key")
+    out = call("DeleteItem", p)
+    print(json.dumps(out, indent=4))
+
+
+def do_get_item(args):
+    p = parse_args(GET_ITEM, args)
+    require(p, "TableName", "--table-name")
+    require(p, "Key", "--key")
+    out = call("GetItem", p)
+    print(json.dumps(out, indent=4))
+
+
+def do_list_tables(args):
+    p = parse_args(LIST_TABLES, args)
+    out = call("ListTables", p)
+    print(json.dumps(out, indent=4))
+
+
+def do_query(args):
+    p = parse_args(QUERY, args)
+    require(p, "TableName", "--table-name")
+    out = call("Query", p)
+    print(json.dumps(out, indent=4))
+
+
+def do_update_item(args):
+    p = parse_args(UPDATE_ITEM, args)
+    require(p, "TableName", "--table-name")
+    require(p, "Key", "--key")
+    out = call("UpdateItem", p)
+    print(json.dumps(out, indent=4))
+
+
+DISPATCH = {
+    "create-table": do_create_table,
+    "delete-table": do_delete_table,
+    "delete-item": do_delete_item,
+    "get-item": do_get_item,
+    "list-tables": do_list_tables,
+    "query": do_query,
+    "update-item": do_update_item,
+}
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage("missing subcommand")
+    sub = argv[2]
+    handler = DISPATCH.get(sub)
+    if handler is None:
+        usage("unknown subcommand: %s" % sub)
+    handler(argv[3:])
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
