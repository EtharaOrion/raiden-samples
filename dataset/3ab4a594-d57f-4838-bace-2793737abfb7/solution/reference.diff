+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+USAGE_EXIT = 252
+SERVICE_EXIT = 254
+
+# Flag specs: name -> (field, type)
+# type: 'str', 'json', 'bool', 'int', 'strlist'
+
+CREATE_TABLE = {
+    "--attribute-definitions": ("AttributeDefinitions", "json"),
+    "--billing-mode": ("BillingMode", "str"),
+    "--deletion-protection-enabled": ("DeletionProtectionEnabled", "bool"),
+    "--no-deletion-protection-enabled": ("DeletionProtectionEnabled", "boolfalse"),
+    "--global-secondary-indexes": ("GlobalSecondaryIndexes", "json"),
+    "--global-table-settings-replication-mode": ("GlobalTableSettingsReplicationMode", "str"),
+    "--global-table-source-arn": ("GlobalTableSourceArn", "str"),
+    "--key-schema": ("KeySchema", "json"),
+    "--local-secondary-indexes": ("LocalSecondaryIndexes", "json"),
+    "--on-demand-throughput": ("OnDemandThroughput", "json"),
+    "--provisioned-throughput": ("ProvisionedThroughput", "json"),
+    "--resource-policy": ("ResourcePolicy", "str"),
+    "--sse-specification": ("SSESpecification", "json"),
+    "--stream-specification": ("StreamSpecification", "json"),
+    "--table-class": ("TableClass", "str"),
+    "--table-name": ("TableName", "str"),
+    "--tags": ("Tags", "json"),
+    "--warm-throughput": ("WarmThroughput", "json"),
+}
+
+DELETE_ITEM = {
+    "--condition-expression": ("ConditionExpression", "str"),
+    "--conditional-operator": ("ConditionalOperator", "str"),
+    "--expected": ("Expected", "json"),
+    "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+    "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+    "--key": ("Key", "json"),
+    "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+    "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+    "--return-values": ("ReturnValues", "str"),
+    "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+    "--table-name": ("TableName", "str"),
+}
+
+GET_ITEM = {
+    "--attributes-to-get": ("AttributesToGet", "json"),
+    "--consistent-read": ("ConsistentRead", "bool"),
+    "--no-consistent-read": ("ConsistentRead", "boolfalse"),
+    "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+    "--key": ("Key", "json"),
+    "--projection-expression": ("ProjectionExpression", "str"),
+    "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+    "--table-name": ("TableName", "str"),
+}
+
+LIST_TABLES = {
+    "--exclusive-start-table-name": ("ExclusiveStartTableName", "str"),
+    "--limit": ("Limit", "int"),
+}
+
+PUT_ITEM = {
+    "--condition-expression": ("ConditionExpression", "str"),
+    "--conditional-operator": ("ConditionalOperator", "str"),
+    "--expected": ("Expected", "json"),
+    "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+    "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+    "--item": ("Item", "json"),
+    "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+    "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+    "--return-values": ("ReturnValues", "str"),
+    "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+    "--table-name": ("TableName", "str"),
+}
+
+QUERY = {
+    "--attributes-to-get": ("AttributesToGet", "json"),
+    "--conditional-operator": ("ConditionalOperator", "str"),
+    "--consistent-read": ("ConsistentRead", "bool"),
+    "--no-consistent-read": ("ConsistentRead", "boolfalse"),
+    "--exclusive-start-key": ("ExclusiveStartKey", "json"),
+    "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+    "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+    "--filter-expression": ("FilterExpression", "str"),
+    "--index-name": ("IndexName", "str"),
+    "--key-condition-expression": ("KeyConditionExpression", "str"),
+    "--key-conditions": ("KeyConditions", "json"),
+    "--limit": ("Limit", "int"),
+    "--projection-expression": ("ProjectionExpression", "str"),
+    "--query-filter": ("QueryFilter", "json"),
+    "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+    "--scan-index-forward": ("ScanIndexForward", "bool"),
+    "--no-scan-index-forward": ("ScanIndexForward", "boolfalse"),
+    "--select": ("Select", "str"),
+    "--table-name": ("TableName", "str"),
+}
+
+UPDATE_ITEM = {
+    "--attribute-updates": ("AttributeUpdates", "json"),
+    "--condition-expression": ("ConditionExpression", "str"),
+    "--conditional-operator": ("ConditionalOperator", "str"),
+    "--expected": ("Expected", "json"),
+    "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+    "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+    "--key": ("Key", "json"),
+    "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+    "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+    "--return-values": ("ReturnValues", "str"),
+    "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+    "--table-name": ("TableName", "str"),
+    "--update-expression": ("UpdateExpression", "str"),
+}
+
+SUBCOMMANDS = {
+    "create-table": ("CreateTable", CREATE_TABLE),
+    "delete-item": ("DeleteItem", DELETE_ITEM),
+    "get-item": ("GetItem", GET_ITEM),
+    "list-tables": ("ListTables", LIST_TABLES),
+    "put-item": ("PutItem", PUT_ITEM),
+    "query": ("Query", QUERY),
+    "update-item": ("UpdateItem", UPDATE_ITEM),
+}
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: " + msg + "\n")
+    sys.exit(USAGE_EXIT)
+
+
+def parse_shorthand_list(value):
+    # Parse "AttributeName=pk,AttributeType=S" style entries.
+    result = {}
+    for pair in value.split(","):
+        if "=" not in pair:
+            raise ValueError("bad shorthand: " + pair)
+        k, v = pair.split("=", 1)
+        result[k] = v
+    return result
+
+
+def coerce_number(v):
+    try:
+        if v.isdigit() or (v.startswith("-") and v[1:].isdigit()):
+            return int(v)
+        return float(v)
+    except Exception:
+        return v
+
+
+def parse_value(spec_type, raw_values, flag):
+    if spec_type == "bool":
+        return True
+    if spec_type == "boolfalse":
+        return False
+    if len(raw_values) == 0:
+        usage_error("flag " + flag + " requires an argument")
+    if spec_type == "str":
+        return raw_values[0]
+    if spec_type == "int":
+        try:
+            return int(raw_values[0])
+        except ValueError:
+            usage_error("flag " + flag + " requires an integer")
+    if spec_type == "json":
+        # Try JSON first, then shorthand.
+        val = raw_values[0]
+        s = val.strip()
+        if s.startswith("{") or s.startswith("["):
+            try:
+                return json.loads(val)
+            except Exception:
+                usage_error("invalid JSON for " + flag)
+        # shorthand: may be multiple values (list of structures)
+        try:
+            if len(raw_values) > 1:
+                out = []
+                for rv in raw_values:
+                    out.append(_shorthand_to_struct(rv))
+                return out
+            struct = _shorthand_to_struct(val)
+            # Certain fields are lists of structures
+            if flag in ("--attribute-definitions", "--key-schema"):
+                return [struct]
+            return struct
+        except Exception:
+            usage_error("invalid value for " + flag)
+
+
+def _shorthand_to_struct(value):
+    d = parse_shorthand_list(value)
+    out = {}
+    for k, v in d.items():
+        # numeric coercion for capacity fields
+        if k in ("ReadCapacityUnits", "WriteCapacityUnits", "MaxReadRequestUnits",
+                 "MaxWriteRequestUnits"):
+            out[k] = coerce_number(v)
+        else:
+            out[k] = v
+    return out
+
+
+def parse_args(spec, args):
+    # Returns dict of field -> value.
+    result = {}
+    i = 0
+    n = len(args)
+    while i < n:
+        tok = args[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected positional argument: " + tok)
+        if "=" in tok and tok.split("=", 1)[0] in spec:
+            flag, inline = tok.split("=", 1)
+            field, stype = spec[flag]
+            if stype in ("bool", "boolfalse"):
+                usage_error("flag " + flag + " takes no argument")
+            val = parse_value(stype, [inline], flag)
+            result[field] = val
+            i += 1
+            continue
+        if tok not in spec:
+            usage_error("unknown flag: " + tok)
+        field, stype = spec[tok]
+        if stype in ("bool", "boolfalse"):
+            result[field] = parse_value(stype, [], tok)
+            i += 1
+            continue
+        # collect following non-flag tokens as values
+        vals = []
+        j = i + 1
+        while j < n and not args[j].startswith("--"):
+            vals.append(args[j])
+            j += 1
+        if not vals:
+            usage_error("flag " + tok + " requires an argument")
+        val = parse_value(stype, vals, tok)
+        result[field] = val
+        i = j
+    return result
+
+
+def get_endpoint():
+    ep = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ.get("AWS_ENDPOINT_URL")
+    if not ep:
+        sys.stderr.write("no endpoint configured\n")
+        sys.exit(SERVICE_EXIT)
+    return ep
+
+
+def call(op, payload):
+    endpoint = get_endpoint()
+    body = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=body, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20120101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=host;x-amz-target, Signature=dummy")
+    try:
+        resp = urllib.request.urlopen(req)
+        data = resp.read()
+        if not data:
+            return {}
+        return json.loads(data.decode("utf-8"))
+    except urllib.error.HTTPError as e:
+        errbody = e.read().decode("utf-8", "replace")
+        code = "UnknownError"
+        message = errbody
+        try:
+            parsed = json.loads(errbody)
+            raw = parsed.get("__type", "UnknownError")
+            code = raw.split("#")[-1]
+            message = parsed.get("message", parsed.get("Message", ""))
+        except Exception:
+            pass
+        sys.stderr.write("An error occurred (" + code + "): " + str(message) + "\n")
+        sys.exit(SERVICE_EXIT)
+    except urllib.error.URLError as e:
+        sys.stderr.write("connection error: " + str(e) + "\n")
+        sys.exit(SERVICE_EXIT)
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("missing command")
+    subcommand = argv[2]
+    if subcommand not in SUBCOMMANDS:
+        usage_error("unknown command: " + subcommand)
+    op, spec = SUBCOMMANDS[subcommand]
+    args = argv[3:]
+    params = parse_args(spec, args)
+
+    if subcommand == "create-table":
+        result = call(op, params)
+        # If key schema / attribute defs supplied, also DescribeTable.
+        if "AttributeDefinitions" in params or "KeySchema" in params:
+            tn = params.get("TableName")
+            if tn:
+                call("DescribeTable", {"TableName": tn})
+        print(json.dumps(result, indent=4, default=str))
+    else:
+        result = call(op, params)
+        print(json.dumps(result, indent=4, default=str))
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
