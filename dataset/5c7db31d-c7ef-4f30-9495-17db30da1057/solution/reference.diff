+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+USAGE_EXIT = 252
+SERVICE_EXIT = 254
+
+# Flag specs: name -> type ('str','int','bool','json')
+SPECS = {
+    "create-table": {
+        "attribute-definitions": "list",
+        "billing-mode": "str",
+        "deletion-protection-enabled": "bool",
+        "global-secondary-indexes": "json",
+        "global-table-settings-replication-mode": "str",
+        "global-table-source-arn": "str",
+        "key-schema": "list",
+        "local-secondary-indexes": "json",
+        "on-demand-throughput": "json",
+        "provisioned-throughput": "map",
+        "resource-policy": "str",
+        "sse-specification": "json",
+        "stream-specification": "json",
+        "table-class": "str",
+        "table-name": "str",
+        "tags": "json",
+        "warm-throughput": "json",
+    },
+    "delete-item": {
+        "condition-expression": "str",
+        "conditional-operator": "str",
+        "expected": "json",
+        "expression-attribute-names": "json",
+        "expression-attribute-values": "json",
+        "key": "json",
+        "return-consumed-capacity": "str",
+        "return-item-collection-metrics": "str",
+        "return-values": "str",
+        "return-values-on-condition-check-failure": "str",
+        "table-name": "str",
+    },
+    "delete-table": {
+        "table-name": "str",
+    },
+    "get-item": {
+        "attributes-to-get": "json",
+        "consistent-read": "bool",
+        "expression-attribute-names": "json",
+        "key": "json",
+        "projection-expression": "str",
+        "return-consumed-capacity": "str",
+        "table-name": "str",
+    },
+    "list-tables": {
+        "exclusive-start-table-name": "str",
+        "limit": "int",
+    },
+    "query": {
+        "attributes-to-get": "json",
+        "conditional-operator": "str",
+        "consistent-read": "bool",
+        "exclusive-start-key": "json",
+        "expression-attribute-names": "json",
+        "expression-attribute-values": "json",
+        "filter-expression": "str",
+        "index-name": "str",
+        "key-condition-expression": "str",
+        "key-conditions": "json",
+        "limit": "int",
+        "projection-expression": "str",
+        "query-filter": "json",
+        "return-consumed-capacity": "str",
+        "scan-index-forward": "bool",
+        "select": "str",
+        "table-name": "str",
+    },
+    "update-item": {
+        "attribute-updates": "json",
+        "condition-expression": "str",
+        "conditional-operator": "str",
+        "expected": "json",
+        "expression-attribute-names": "json",
+        "expression-attribute-values": "json",
+        "key": "json",
+        "return-consumed-capacity": "str",
+        "return-item-collection-metrics": "str",
+        "return-values": "str",
+        "return-values-on-condition-check-failure": "str",
+        "table-name": "str",
+    },
+}
+
+# subcommand -> DynamoDB operation
+OPS = {
+    "create-table": "CreateTable",
+    "delete-item": "DeleteItem",
+    "delete-table": "DeleteTable",
+    "get-item": "GetItem",
+    "list-tables": "ListTables",
+    "query": "Query",
+    "update-item": "UpdateItem",
+}
+
+
+def kebab_to_pascal(name):
+    parts = name.split("-")
+    return "".join(p[:1].upper() + p[1:] for p in parts)
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: " + msg + "\n")
+    sys.exit(USAGE_EXIT)
+
+
+def parse_bool_flag(spec):
+    return spec == "bool"
+
+
+def parse_shorthand_list(values, kind):
+    # values is a list of tokens like "AttributeName=pk,AttributeType=S"
+    result = []
+    for tok in values:
+        entry = {}
+        for pair in tok.split(","):
+            if "=" not in pair:
+                usage_error("invalid shorthand: " + tok)
+            k, v = pair.split("=", 1)
+            entry[k] = v
+        result.append(entry)
+    return result
+
+
+def parse_shorthand_map(value):
+    entry = {}
+    for pair in value.split(","):
+        if "=" not in pair:
+            usage_error("invalid shorthand: " + value)
+        k, v = pair.split("=", 1)
+        try:
+            entry[k] = int(v)
+        except ValueError:
+            entry[k] = v
+    return entry
+
+
+def coerce_provisioned(m):
+    out = {}
+    for k, v in m.items():
+        try:
+            out[k] = int(v)
+        except (ValueError, TypeError):
+            out[k] = v
+    return out
+
+
+def parse_args(subcmd, args):
+    spec = SPECS[subcmd]
+    request = {}
+    seen = set()
+    i = 0
+    n = len(args)
+    while i < n:
+        a = args[i]
+        if not a.startswith("--"):
+            usage_error("unexpected argument: " + a)
+        flag = a[2:]
+        if flag not in spec:
+            usage_error("unknown flag: " + a)
+        if flag in seen:
+            usage_error("duplicate flag: " + a)
+        seen.add(flag)
+        ftype = spec[flag]
+        field = kebab_to_pascal(flag)
+
+        if ftype == "bool":
+            request[field] = True
+            i += 1
+            continue
+
+        # collect values until next --flag
+        vals = []
+        i += 1
+        while i < n and not args[i].startswith("--"):
+            vals.append(args[i])
+            i += 1
+
+        if ftype in ("list",):
+            if not vals:
+                usage_error("flag requires a value: " + a)
+            request[field] = parse_shorthand_list(vals, flag)
+        elif ftype == "map":
+            if not vals:
+                usage_error("flag requires a value: " + a)
+            request[field] = parse_shorthand_map(vals[0])
+        elif ftype == "int":
+            if not vals:
+                usage_error("flag requires a value: " + a)
+            try:
+                request[field] = int(vals[0])
+            except ValueError:
+                usage_error("invalid integer: " + vals[0])
+        elif ftype == "json":
+            if not vals:
+                usage_error("flag requires a value: " + a)
+            joined = " ".join(vals)
+            try:
+                request[field] = json.loads(joined)
+            except Exception:
+                usage_error("invalid JSON for " + a + ": " + joined)
+        else:  # str
+            if not vals:
+                usage_error("flag requires a value: " + a)
+            request[field] = " ".join(vals)
+    return request
+
+
+def get_endpoint():
+    ep = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ.get("AWS_ENDPOINT_URL")
+    if not ep:
+        sys.stderr.write("No endpoint configured\n")
+        sys.exit(SERVICE_EXIT)
+    return ep
+
+
+def call(op, payload):
+    endpoint = get_endpoint()
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header(
+        "Authorization",
+        "AWS4-HMAC-SHA256 Credential=dummy/20200101/us-east-1/dynamodb/aws4_request, "
+        "SignedHeaders=host;x-amz-target, Signature=dummy",
+    )
+    req.add_header("X-Amz-Date", "20200101T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        if body:
+            return json.loads(body)
+        return {}
+    except urllib.error.HTTPError as e:
+        raw = e.read().decode("utf-8")
+        code = "UnknownError"
+        msg = raw
+        try:
+            j = json.loads(raw)
+            typ = j.get("__type", "")
+            if typ:
+                code = typ.split("#")[-1]
+            msg = j.get("message") or j.get("Message") or raw
+        except Exception:
+            pass
+        sys.stderr.write(code + ": " + str(msg) + "\n")
+        sys.exit(SERVICE_EXIT)
+    except urllib.error.URLError as e:
+        sys.stderr.write("ConnectionError: " + str(e) + "\n")
+        sys.exit(SERVICE_EXIT)
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("missing subcommand")
+    subcmd = argv[2]
+    if subcmd not in SPECS:
+        usage_error("unknown subcommand: " + subcmd)
+
+    args = argv[3:]
+    request = parse_args(subcmd, args)
+
+    # Fix up provisioned throughput numeric coercion
+    if "ProvisionedThroughput" in request and isinstance(request["ProvisionedThroughput"], dict):
+        request["ProvisionedThroughput"] = coerce_provisioned(request["ProvisionedThroughput"])
+
+    op = OPS[subcmd]
+
+    result = call(op, request)
+    sys.stdout.write(json.dumps(result, indent=None) + "\n")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
