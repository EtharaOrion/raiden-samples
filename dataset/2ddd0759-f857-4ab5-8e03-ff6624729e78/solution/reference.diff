+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+USAGE_EXIT = 252
+SERVICE_EXIT = 254
+
+# Flag specs per subcommand: flag -> (field, type)
+# type: 'str', 'json', 'int', 'bool'
+SPECS = {
+    "delete-item": {
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--key": ("Key", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "delete-table": {
+        "--table-name": ("TableName", "str"),
+    },
+    "get-item": {
+        "--attributes-to-get": ("AttributesToGet", "json"),
+        "--consistent-read": ("ConsistentRead", "bool"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--key": ("Key", "json"),
+        "--projection-expression": ("ProjectionExpression", "str"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "list-tables": {
+        "--exclusive-start-table-name": ("ExclusiveStartTableName", "str"),
+        "--limit": ("Limit", "int"),
+    },
+    "put-item": {
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--item": ("Item", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "update-item": {
+        "--attribute-updates": ("AttributeUpdates", "json"),
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--key": ("Key", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+        "--update-expression": ("UpdateExpression", "str"),
+    },
+}
+
+OP_MAP = {
+    "delete-item": "DeleteItem",
+    "delete-table": "DeleteTable",
+    "get-item": "GetItem",
+    "list-tables": "ListTables",
+    "put-item": "PutItem",
+    "update-item": "UpdateItem",
+}
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: %s\n" % msg)
+    sys.exit(USAGE_EXIT)
+
+
+def parse_args(spec, argv):
+    result = {}
+    seen = set()
+    i = 0
+    n = len(argv)
+    while i < n:
+        tok = argv[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: %s" % tok)
+        if tok not in spec:
+            usage_error("unknown option: %s" % tok)
+        field, typ = spec[tok]
+        if tok in seen:
+            usage_error("duplicate option: %s" % tok)
+        seen.add(tok)
+        if typ == "bool":
+            result[field] = True
+            i += 1
+            continue
+        if i + 1 >= n:
+            usage_error("option %s requires a value" % tok)
+        val = argv[i + 1]
+        i += 2
+        if val == "" and typ == "str":
+            usage_error("option %s requires a non-empty value" % tok)
+        if typ == "str":
+            result[field] = val
+        elif typ == "int":
+            try:
+                result[field] = int(val)
+            except ValueError:
+                usage_error("option %s requires an integer" % tok)
+        elif typ == "json":
+            try:
+                result[field] = json.loads(val)
+            except (ValueError, json.JSONDecodeError):
+                usage_error("option %s requires valid JSON" % tok)
+    return result
+
+
+def get_endpoint():
+    ep = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ.get("AWS_ENDPOINT_URL")
+    if not ep:
+        sys.stderr.write("No endpoint configured\n")
+        sys.exit(SERVICE_EXIT)
+    return ep
+
+
+def call(op, payload):
+    endpoint = get_endpoint()
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810.%s" % op)
+    req.add_header(
+        "Authorization",
+        "AWS4-HMAC-SHA256 Credential=dummy/20120810/us-east-1/dynamodb/aws4_request, "
+        "SignedHeaders=content-type;host;x-amz-target, Signature=dummy",
+    )
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        return 0, body
+    except urllib.error.HTTPError as e:
+        body = e.read().decode("utf-8")
+        code = "UnknownError"
+        try:
+            j = json.loads(body)
+            t = j.get("__type") or j.get("code") or ""
+            if t:
+                code = t.split("#")[-1]
+            msg = j.get("message") or j.get("Message") or ""
+        except (ValueError, json.JSONDecodeError):
+            msg = body
+        sys.stderr.write("%s: %s\n" % (code, msg))
+        return SERVICE_EXIT, None
+    except urllib.error.URLError as e:
+        sys.stderr.write("connection error: %s\n" % e)
+        return SERVICE_EXIT, None
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("missing command")
+    sub = argv[2]
+    if sub not in SPECS:
+        usage_error("unknown command: %s" % sub)
+    spec = SPECS[sub]
+    params = parse_args(spec, argv[3:])
+    op = OP_MAP[sub]
+
+    rc, body = call(op, params)
+    if rc != 0:
+        sys.exit(rc)
+    if body and body.strip() and body.strip() != "{}":
+        try:
+            parsed = json.loads(body)
+            if parsed:
+                sys.stdout.write(json.dumps(parsed, indent=4) + "\n")
+        except (ValueError, json.JSONDecodeError):
+            sys.stdout.write(body + "\n")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
