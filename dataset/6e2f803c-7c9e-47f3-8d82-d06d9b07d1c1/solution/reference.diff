+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+
+def endpoint():
+    return os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ["AWS_ENDPOINT_URL"]
+
+
+def call(op, payload):
+    url = endpoint()
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(url, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20200101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=host;x-amz-date;x-amz-target, Signature=dummy")
+    req.add_header("X-Amz-Date", "20200101T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        if body:
+            return json.loads(body)
+        return {}
+    except urllib.error.HTTPError as e:
+        body = e.read().decode("utf-8")
+        code = "UnknownError"
+        msg = body
+        try:
+            j = json.loads(body)
+            t = j.get("__type", "")
+            if "#" in t:
+                code = t.split("#", 1)[1]
+            elif t:
+                code = t
+            msg = j.get("message") or j.get("Message") or ""
+        except Exception:
+            pass
+        raise ServiceError(code, msg)
+
+
+class ServiceError(Exception):
+    def __init__(self, code, message):
+        self.code = code
+        self.message = message
+        super().__init__(code + ": " + message)
+
+
+class UsageError(Exception):
+    pass
+
+
+# Flag specs: flag -> (field, type)
+# type: 'str', 'json', 'int', 'bool', 'list-json' (list of key=val -> structured)
+FLAG_SPECS = {
+    "create-table": {
+        "--attribute-definitions": ("AttributeDefinitions", "attrdefs"),
+        "--billing-mode": ("BillingMode", "str"),
+        "--deletion-protection-enabled": ("DeletionProtectionEnabled", "boolflag"),
+        "--global-secondary-indexes": ("GlobalSecondaryIndexes", "json"),
+        "--global-table-settings-replication-mode": ("GlobalTableSettingsReplicationMode", "str"),
+        "--global-table-source-arn": ("GlobalTableSourceArn", "str"),
+        "--key-schema": ("KeySchema", "keyschema"),
+        "--local-secondary-indexes": ("LocalSecondaryIndexes", "json"),
+        "--on-demand-throughput": ("OnDemandThroughput", "shorthand"),
+        "--provisioned-throughput": ("ProvisionedThroughput", "shorthand"),
+        "--resource-policy": ("ResourcePolicy", "str"),
+        "--sse-specification": ("SSESpecification", "shorthand"),
+        "--stream-specification": ("StreamSpecification", "shorthand"),
+        "--table-class": ("TableClass", "str"),
+        "--table-name": ("TableName", "str"),
+        "--tags": ("Tags", "json"),
+        "--warm-throughput": ("WarmThroughput", "shorthand"),
+    },
+    "delete-item": {
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--key": ("Key", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "delete-table": {
+        "--table-name": ("TableName", "str"),
+    },
+    "get-item": {
+        "--attributes-to-get": ("AttributesToGet", "list"),
+        "--consistent-read": ("ConsistentRead", "boolflag"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--key": ("Key", "json"),
+        "--projection-expression": ("ProjectionExpression", "str"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "list-tables": {
+        "--exclusive-start-table-name": ("ExclusiveStartTableName", "str"),
+        "--limit": ("Limit", "int"),
+    },
+    "update-item": {
+        "--attribute-updates": ("AttributeUpdates", "json"),
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--key": ("Key", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+        "--update-expression": ("UpdateExpression", "str"),
+    },
+}
+
+OP_NAMES = {
+    "create-table": "CreateTable",
+    "delete-item": "DeleteItem",
+    "delete-table": "DeleteTable",
+    "get-item": "GetItem",
+    "list-tables": "ListTables",
+    "update-item": "UpdateItem",
+}
+
+
+def parse_shorthand(s):
+    # key=val,key=val -> dict with numeric coercion for capacity units
+    result = {}
+    for part in s.split(","):
+        if "=" not in part:
+            raise UsageError("invalid shorthand: " + part)
+        k, v = part.split("=", 1)
+        try:
+            result[k] = int(v)
+        except ValueError:
+            if v in ("true", "false"):
+                result[k] = (v == "true")
+            else:
+                result[k] = v
+    return result
+
+
+def parse_attrdefs(values):
+    out = []
+    for v in values:
+        d = {}
+        for part in v.split(","):
+            if "=" not in part:
+                raise UsageError("invalid: " + part)
+            k, val = part.split("=", 1)
+            d[k] = val
+        out.append(d)
+    return out
+
+
+def parse_json(s):
+    try:
+        return json.loads(s)
+    except Exception:
+        raise UsageError("invalid JSON: " + s)
+
+
+def parse_args(sub, args):
+    specs = FLAG_SPECS[sub]
+    result = {}
+    seen = set()
+    i = 0
+    # collect multi-valued for attrdefs/keyschema/list
+    while i < len(args):
+        tok = args[i]
+        if not tok.startswith("--"):
+            raise UsageError("unexpected argument: " + tok)
+        if tok not in specs:
+            raise UsageError("unknown option: " + tok)
+        field, typ = specs[tok]
+        if tok in seen:
+            raise UsageError("duplicate option: " + tok)
+        seen.add(tok)
+        if typ == "boolflag":
+            result[field] = True
+            i += 1
+            continue
+        # gather values until next --flag
+        vals = []
+        i += 1
+        while i < len(args) and not args[i].startswith("--"):
+            vals.append(args[i])
+            i += 1
+        if not vals:
+            raise UsageError("expected argument for " + tok)
+        if typ == "str":
+            if len(vals) != 1:
+                raise UsageError("expected one value for " + tok)
+            result[field] = vals[0]
+        elif typ == "int":
+            if len(vals) != 1:
+                raise UsageError("expected one value for " + tok)
+            try:
+                result[field] = int(vals[0])
+            except ValueError:
+                raise UsageError("expected integer for " + tok)
+        elif typ == "json":
+            if len(vals) != 1:
+                raise UsageError("expected one value for " + tok)
+            result[field] = parse_json(vals[0])
+        elif typ == "shorthand":
+            if len(vals) != 1:
+                raise UsageError("expected one value for " + tok)
+            v = vals[0].strip()
+            if v.startswith("{"):
+                result[field] = parse_json(v)
+            else:
+                result[field] = parse_shorthand(v)
+        elif typ == "attrdefs":
+            result[field] = parse_attrdefs(vals)
+        elif typ == "keyschema":
+            result[field] = parse_attrdefs(vals)
+        elif typ == "list":
+            result[field] = vals
+        else:
+            result[field] = vals[0]
+    return result
+
+
+def require(result, field, flagname):
+    if field not in result:
+        raise UsageError("missing required option: " + flagname)
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        sys.stderr.write("usage: main.py <prefix> <command> [args...]\n")
+        sys.exit(252)
+    sub = argv[2]
+    if sub not in FLAG_SPECS:
+        sys.stderr.write("unknown command: " + str(sub) + "\n")
+        sys.exit(252)
+    args = argv[3:]
+    try:
+        params = parse_args(sub, args)
+    except UsageError as e:
+        sys.stderr.write("usage error: " + str(e) + "\n")
+        sys.exit(252)
+
+    try:
+        if sub == "create-table":
+            require(params, "TableName", "--table-name")
+            if not params.get("TableName"):
+                raise UsageError("empty table name")
+            call("CreateTable", params)
+            if "AttributeDefinitions" in params or "KeySchema" in params or "BillingMode" in params:
+                out = call("DescribeTable", {"TableName": params["TableName"]})
+                print(json.dumps(out, indent=2))
+            sys.exit(0)
+        elif sub == "delete-table":
+            require(params, "TableName", "--table-name")
+            if not params.get("TableName"):
+                raise UsageError("empty table name")
+            out = call("DeleteTable", params)
+            print(json.dumps(out, indent=2))
+            sys.exit(0)
+        elif sub == "delete-item":
+            require(params, "TableName", "--table-name")
+            require(params, "Key", "--key")
+            if not params.get("TableName"):
+                raise UsageError("empty table name")
+            out = call("DeleteItem", params)
+            if out:
+                print(json.dumps(out, indent=2))
+            sys.exit(0)
+        elif sub == "get-item":
+            require(params, "TableName", "--table-name")
+            require(params, "Key", "--key")
+            if not params.get("TableName"):
+                raise UsageError("empty table name")
+            out = call("GetItem", params)
+            print(json.dumps(out, indent=2))
+            sys.exit(0)
+        elif sub == "update-item":
+            require(params, "TableName", "--table-name")
+            require(params, "Key", "--key")
+            if not params.get("TableName"):
+                raise UsageError("empty table name")
+            out = call("UpdateItem", params)
+            if out:
+                print(json.dumps(out, indent=2))
+            sys.exit(0)
+        elif sub == "list-tables":
+            out = call("ListTables", params)
+            print(json.dumps(out, indent=2))
+            sys.exit(0)
+    except UsageError as e:
+        sys.stderr.write("usage error: " + str(e) + "\n")
+        sys.exit(252)
+    except ServiceError as e:
+        sys.stderr.write(e.code + "\n")
+        sys.exit(254)
+    except KeyError as e:
+        sys.stderr.write("configuration error: " + str(e) + "\n")
+        sys.exit(252)
+
+
+if __name__ == "__main__":
+    main()
