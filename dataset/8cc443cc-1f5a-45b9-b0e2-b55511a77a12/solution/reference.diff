+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+USAGE_EXIT = 252
+SERVICE_EXIT = 254
+
+# Flag specifications per subcommand.
+# type: 'str', 'int', 'json', 'bool'
+SPECS = {
+    "create-table": {
+        "target": "CreateTable",
+        "flags": {
+            "--attribute-definitions": ("AttributeDefinitions", "json_or_shorthand_list"),
+            "--billing-mode": ("BillingMode", "str"),
+            "--deletion-protection-enabled": ("DeletionProtectionEnabled", "bool"),
+            "--no-deletion-protection-enabled": ("DeletionProtectionEnabled", "bool_false"),
+            "--global-secondary-indexes": ("GlobalSecondaryIndexes", "json"),
+            "--global-table-settings-replication-mode": ("GlobalTableSettingsReplicationMode", "str"),
+            "--global-table-source-arn": ("GlobalTableSourceArn", "str"),
+            "--key-schema": ("KeySchema", "json_or_shorthand_list"),
+            "--local-secondary-indexes": ("LocalSecondaryIndexes", "json"),
+            "--on-demand-throughput": ("OnDemandThroughput", "json_or_shorthand"),
+            "--provisioned-throughput": ("ProvisionedThroughput", "json_or_shorthand"),
+            "--resource-policy": ("ResourcePolicy", "str"),
+            "--sse-specification": ("SSESpecification", "json_or_shorthand"),
+            "--stream-specification": ("StreamSpecification", "json_or_shorthand"),
+            "--table-class": ("TableClass", "str"),
+            "--table-name": ("TableName", "str"),
+            "--tags": ("Tags", "json"),
+            "--warm-throughput": ("WarmThroughput", "json_or_shorthand"),
+        },
+    },
+    "delete-item": {
+        "target": "DeleteItem",
+        "flags": {
+            "--condition-expression": ("ConditionExpression", "str"),
+            "--conditional-operator": ("ConditionalOperator", "str"),
+            "--expected": ("Expected", "json"),
+            "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "--key": ("Key", "json"),
+            "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+            "--return-values": ("ReturnValues", "str"),
+            "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+            "--table-name": ("TableName", "str"),
+        },
+    },
+    "get-item": {
+        "target": "GetItem",
+        "flags": {
+            "--attributes-to-get": ("AttributesToGet", "json_or_list"),
+            "--consistent-read": ("ConsistentRead", "bool"),
+            "--no-consistent-read": ("ConsistentRead", "bool_false"),
+            "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "--key": ("Key", "json"),
+            "--projection-expression": ("ProjectionExpression", "str"),
+            "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "--table-name": ("TableName", "str"),
+        },
+    },
+    "list-tables": {
+        "target": "ListTables",
+        "flags": {
+            "--exclusive-start-table-name": ("ExclusiveStartTableName", "str"),
+            "--limit": ("Limit", "int"),
+        },
+    },
+    "put-item": {
+        "target": "PutItem",
+        "flags": {
+            "--condition-expression": ("ConditionExpression", "str"),
+            "--conditional-operator": ("ConditionalOperator", "str"),
+            "--expected": ("Expected", "json"),
+            "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "--item": ("Item", "json"),
+            "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+            "--return-values": ("ReturnValues", "str"),
+            "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+            "--table-name": ("TableName", "str"),
+        },
