+}
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: " + msg + "\n")
+    sys.exit(USAGE_EXIT)
+
+
+def get_endpoint():
+    ep = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ.get("AWS_ENDPOINT_URL")
+    if not ep:
+        usage_error("no endpoint configured")
+    return ep
+
+
+def call(target, payload):
+    endpoint = get_endpoint()
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + target)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20200101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=content-type;host;x-amz-target, Signature=dummy")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        if body:
+            return json.loads(body)
+        return {}
+    except urllib.error.HTTPError as e:
+        raw = e.read().decode("utf-8")
+        code = "UnknownError"
+        message = raw
+        try:
+            parsed = json.loads(raw)
+            typ = parsed.get("__type", "")
+            if typ:
+                code = typ.split("#")[-1]
+            message = parsed.get("message", parsed.get("Message", ""))
+        except Exception:
+            pass
+        sys.stderr.write("\n" + "An error occurred (" + code + ") : " + str(message) + "\n")
+        sys.exit(SERVICE_EXIT)
+    except urllib.error.URLError as e:
+        sys.stderr.write("Could not connect to the endpoint URL: " + str(e) + "\n")
+        sys.exit(SERVICE_EXIT)
+
+
+def parse_shorthand_struct(s):
+    # Key=Value,Key=Value  -> dict, numeric-like stays string but we try int
+    result = {}
+    for part in s.split(","):
+        if "=" not in part:
+            raise ValueError("bad shorthand: " + part)
+        k, v = part.split("=", 1)
+        if v.isdigit():
+            result[k] = int(v)
+        elif v.lower() == "true":
+            result[k] = True
+        elif v.lower() == "false":
+            result[k] = False
+        else:
+            result[k] = v
+    return result
+
+
+def parse_value(vtype, values):
+    if vtype == "str":
+        return values[0]
+    if vtype == "int":
+        try:
+            return int(values[0])
+        except ValueError:
+            raise ValueError("expected integer")
+    if vtype == "bool":
+        return True
+    if vtype == "bool_false":
+        return False
+    if vtype == "json":
+        return json.loads(values[0])
+    if vtype == "json_or_list":
+        raw = values[0]
+        raw_stripped = raw.strip()
+        if len(values) > 1:
+            return list(values)
+        if raw_stripped.startswith("[") or raw_stripped.startswith("{"):
+            return json.loads(raw)
+        return [raw]
+    if vtype == "json_or_shorthand":
+        raw = values[0].strip()
+        if raw.startswith("{") or raw.startswith("["):
+            return json.loads(raw)
+        return parse_shorthand_struct(values[0])
+    if vtype == "json_or_shorthand_list":
+        raw = values[0].strip()
+        if raw.startswith("[") or raw.startswith("{"):
+            return json.loads(raw)
+        # shorthand list: each value is a struct
+        return [parse_shorthand_struct(v) for v in values]
+    raise ValueError("unknown type")
+
+
+def parse_args(subcmd, args):
+    spec = SPECS[subcmd]
+    flags = spec["flags"]
+    request = {}
+    seen_fields = set()
+    i = 0
+    n = len(args)
+    while i < n:
+        tok = args[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: " + tok)
+        if tok not in flags:
+            usage_error("unknown option: " + tok)
+        field, vtype = flags[tok]
+        if vtype in ("bool", "bool_false"):
+            values = []
+            i += 1
+        else:
+            # gather values until next flag
+            values = []
+            i += 1
+            while i < n and not args[i].startswith("--"):
+                values.append(args[i])
+                i += 1
+            if not values:
+                usage_error("option " + tok + " requires an argument")
+        if field in seen_fields:
+            usage_error("duplicate option for field: " + field)
+        seen_fields.add(field)
+        try:
+            request[field] = parse_value(vtype, values)
+        except ValueError as e:
+            usage_error(str(e))
+        except json.JSONDecodeError as e:
+            usage_error("invalid JSON for " + tok + ": " + str(e))
+    return request
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("missing command")
+    subcmd = argv[2]
+    if subcmd not in SPECS:
+        usage_error("unknown subcommand: " + subcmd)
+    args = argv[3:]
+    request = parse_args(subcmd, args)
+    target = SPECS[subcmd]["target"]
+    result = call(target, request)
+    sys.stdout.write(json.dumps(result, indent=4))
+    sys.stdout.write("\n")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
