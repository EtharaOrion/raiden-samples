+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+TARGET_PREFIX = "DynamoDB_20120810."
+
+# flag spec: name -> type
+# types: "str", "json", "int", "bool", "flag"(store_true)
+SPECS = {
+    "delete-item": {
+        "op": "DeleteItem",
+        "flags": {
+            "--condition-expression": ("ConditionExpression", "str"),
+            "--conditional-operator": ("ConditionalOperator", "str"),
+            "--expected": ("Expected", "json"),
+            "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "--key": ("Key", "json"),
+            "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+            "--return-values": ("ReturnValues", "str"),
+            "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+            "--table-name": ("TableName", "str"),
+        },
+    },
+    "get-item": {
+        "op": "GetItem",
+        "flags": {
+            "--attributes-to-get": ("AttributesToGet", "json"),
+            "--consistent-read": ("ConsistentRead", "flag"),
+            "--no-consistent-read": ("ConsistentRead", "flag_false"),
+            "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "--key": ("Key", "json"),
+            "--projection-expression": ("ProjectionExpression", "str"),
+            "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "--table-name": ("TableName", "str"),
+        },
+    },
+    "list-tables": {
+        "op": "ListTables",
+        "flags": {
+            "--exclusive-start-table-name": ("ExclusiveStartTableName", "str"),
+            "--limit": ("Limit", "int"),
+        },
+    },
+    "put-item": {
+        "op": "PutItem",
+        "flags": {
+            "--condition-expression": ("ConditionExpression", "str"),
+            "--conditional-operator": ("ConditionalOperator", "str"),
+            "--expected": ("Expected", "json"),
+            "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "--item": ("Item", "json"),
+            "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+            "--return-values": ("ReturnValues", "str"),
+            "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+            "--table-name": ("TableName", "str"),
+        },
+    },
+    "query": {
+        "op": "Query",
+        "flags": {
+            "--attributes-to-get": ("AttributesToGet", "json"),
+            "--conditional-operator": ("ConditionalOperator", "str"),
+            "--consistent-read": ("ConsistentRead", "flag"),
+            "--no-consistent-read": ("ConsistentRead", "flag_false"),
+            "--exclusive-start-key": ("ExclusiveStartKey", "json"),
+            "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "--filter-expression": ("FilterExpression", "str"),
+            "--index-name": ("IndexName", "str"),
+            "--key-condition-expression": ("KeyConditionExpression", "str"),
+            "--key-conditions": ("KeyConditions", "json"),
+            "--limit": ("Limit", "int"),
+            "--projection-expression": ("ProjectionExpression", "str"),
+            "--query-filter": ("QueryFilter", "json"),
+            "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "--scan-index-forward": ("ScanIndexForward", "flag"),
+            "--no-scan-index-forward": ("ScanIndexForward", "flag_false"),
+            "--select": ("Select", "str"),
+            "--table-name": ("TableName", "str"),
+        },
+    },
+    "update-item": {
+        "op": "UpdateItem",
+        "flags": {
+            "--attribute-updates": ("AttributeUpdates", "json"),
+            "--condition-expression": ("ConditionExpression", "str"),
+            "--conditional-operator": ("ConditionalOperator", "str"),
+            "--expected": ("Expected", "json"),
+            "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+            "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+            "--key": ("Key", "json"),
+            "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+            "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+            "--return-values": ("ReturnValues", "str"),
+            "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+            "--table-name": ("TableName", "str"),
+            "--update-expression": ("UpdateExpression", "str"),
+        },
+    },
+}
+
+USAGE_EXIT = 252
+ERROR_EXIT = 254
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: " + msg + "\n")
+    sys.exit(USAGE_EXIT)
+
+
+def get_endpoint():
+    ep = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ.get("AWS_ENDPOINT_URL")
+    if not ep:
+        usage_error("no endpoint configured")
+    return ep
+
+
+def call(op, body):
+    endpoint = get_endpoint()
+    data = json.dumps(body).encode("utf-8")
+    req = urllib.request.Request(endpoint, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", TARGET_PREFIX + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20200101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=content-type;host;x-amz-target, Signature=dummy")
+    req.add_header("X-Amz-Date", "20200101T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        raw = resp.read()
+        if raw:
+            return json.loads(raw.decode("utf-8"))
+        return {}
+    except urllib.error.HTTPError as e:
+        raw = e.read().decode("utf-8", "replace")
+        code = None
+        try:
+            parsed = json.loads(raw)
+            t = parsed.get("__type") or parsed.get("Message") or ""
+            code = t.split("#")[-1] if "#" in t else t
+            msg = parsed.get("message") or parsed.get("Message") or raw
+        except Exception:
+            code = "ServiceError"
+            msg = raw
+        sys.stderr.write("An error occurred (" + str(code) + "): " + str(msg) + "\n")
+        sys.exit(ERROR_EXIT)
+    except urllib.error.URLError as e:
+        sys.stderr.write("Could not connect to the endpoint URL: " + str(e) + "\n")
+        sys.exit(ERROR_EXIT)
+
+
+def parse_args(spec, args):
+    flags = spec["flags"]
+    result = {}
+    seen = set()
+    i = 0
+    n = len(args)
+    while i < n:
+        tok = args[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: " + tok)
+        if "=" in tok:
+            name, val = tok.split("=", 1)
+            has_inline = True
+        else:
+            name = tok
+            val = None
+            has_inline = False
+        if name not in flags:
+            usage_error("unknown option: " + name)
+        field, typ = flags[name]
+        if typ in ("flag", "flag_false"):
+            if has_inline:
+                usage_error("option " + name + " takes no value")
+            result[field] = (typ == "flag")
+            seen.add(name)
+            i += 1
+            continue
+        if not has_inline:
+            if i + 1 >= n:
+                usage_error("option " + name + " requires a value")
+            val = args[i + 1]
+            i += 2
+        else:
+            i += 1
+        if name in seen:
+            usage_error("duplicate option: " + name)
+        seen.add(name)
+        if typ == "str":
+            if val == "":
+                usage_error("option " + name + " requires a non-empty value")
+            result[field] = val
+        elif typ == "int":
+            try:
+                result[field] = int(val)
+            except ValueError:
+                usage_error("option " + name + " requires an integer")
+        elif typ == "json":
+            try:
+                result[field] = json.loads(val)
+            except ValueError:
+                usage_error("option " + name + " requires valid JSON")
+        else:
+            result[field] = val
+    return result
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("missing command")
+    subcmd = argv[2]
+    if subcmd not in SPECS:
+        usage_error("unknown subcommand: " + subcmd)
+    spec = SPECS[subcmd]
+    params = parse_args(spec, argv[3:])
+    result = call(spec["op"], params)
+    sys.stdout.write(json.dumps(result, indent=4) + "\n")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
