+++ b/submission/main.py
@@ -0,0 +1,236 @@
+import sys
+import os
+import json
+import urllib.request
+import urllib.error
+
+USAGE_EXIT = 252
+SERVICE_EXIT = 254
+
+# flag -> (field_name, type) where type in {"str","json","int","bool"}
+SPECS = {
+    "delete-item": {
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--key": ("Key", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "delete-table": {
+        "--table-name": ("TableName", "str"),
+    },
+    "get-item": {
+        "--attributes-to-get": ("AttributesToGet", "json"),
+        "--consistent-read": ("ConsistentRead", "bool"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--key": ("Key", "json"),
+        "--projection-expression": ("ProjectionExpression", "str"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "list-tables": {
+        "--exclusive-start-table-name": ("ExclusiveStartTableName", "str"),
+        "--limit": ("Limit", "int"),
+    },
+    "query": {
+        "--attributes-to-get": ("AttributesToGet", "json"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--consistent-read": ("ConsistentRead", "bool"),
+        "--exclusive-start-key": ("ExclusiveStartKey", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--filter-expression": ("FilterExpression", "str"),
+        "--index-name": ("IndexName", "str"),
+        "--key-condition-expression": ("KeyConditionExpression", "str"),
+        "--key-conditions": ("KeyConditions", "json"),
+        "--limit": ("Limit", "int"),
+        "--projection-expression": ("ProjectionExpression", "str"),
+        "--query-filter": ("QueryFilter", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--scan-index-forward": ("ScanIndexForward", "bool"),
+        "--select": ("Select", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "update-item": {
+        "--attribute-updates": ("AttributeUpdates", "json"),
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--key": ("Key", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+        "--update-expression": ("UpdateExpression", "str"),
+    },
+}
+
+# bool flags that don't take an argument (store_true / store_false pairs)
+# In botocore these use --flag / --no-flag style. We support both.
+BOOL_FLAGS = {
+    "--consistent-read": True,
+    "--scan-index-forward": True,
+    "--no-consistent-read": False,
+    "--no-scan-index-forward": False,
+}
+
+OP = {
+    "delete-item": "DeleteItem",
+    "delete-table": "DeleteTable",
+    "get-item": "GetItem",
+    "list-tables": "ListTables",
+    "query": "Query",
+    "update-item": "UpdateItem",
+}
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: " + msg + "\n")
+    sys.exit(USAGE_EXIT)
+
+
+def parse_args(spec, argv):
+    params = {}
+    seen = set()
+    i = 0
+    n = len(argv)
+    while i < n:
+        tok = argv[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: " + tok)
+        # handle --key=value form
+        if "=" in tok:
+            flag, val = tok.split("=", 1)
+            has_inline = True
+        else:
+            flag = tok
+            val = None
+            has_inline = False
+
+        # bool no-arg flags
+        if flag in BOOL_FLAGS:
+            field_map = None
+            base = flag[5:] if flag.startswith("--no-") else flag[2:]
+            base_flag = "--" + base
+            if base_flag not in spec:
+                usage_error("unknown flag: " + flag)
+            field, _ = spec[base_flag]
+            if field in seen:
+                usage_error("duplicate flag: " + flag)
+            seen.add(field)
+            params[field] = BOOL_FLAGS[flag]
+            i += 1
+            continue
+
+        if flag not in spec:
+            usage_error("unknown flag: " + flag)
+
+        field, ftype = spec[flag]
+        if field in seen:
+            usage_error("duplicate flag: " + flag)
+        seen.add(field)
+
+        if ftype == "bool":
+            # value optional; botocore accepts as store_true
+            params[field] = True
+            i += 1
+            continue
+
+        if has_inline:
+            raw = val
+            i += 1
+        else:
+            if i + 1 >= n:
+                usage_error("missing value for " + flag)
+            raw = argv[i + 1]
+            i += 2
+
+        if raw == "":
+            usage_error("empty value for " + flag)
+
+        if ftype == "str":
+            params[field] = raw
+        elif ftype == "int":
+            try:
+                params[field] = int(raw)
+            except ValueError:
+                usage_error("invalid integer for " + flag)
+        elif ftype == "json":
+            try:
+                params[field] = json.loads(raw)
+            except ValueError:
+                usage_error("invalid JSON for " + flag)
+        else:
+            usage_error("internal type error")
+
+    return params
+
+
+def get_endpoint():
+    ep = os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ.get("AWS_ENDPOINT_URL")
+    if not ep:
+        sys.stderr.write("No endpoint configured\n")
+        sys.exit(SERVICE_EXIT)
+    return ep
+
+
+def call(op, payload):
+    ep = get_endpoint()
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(ep, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20120810/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=content-type;host;x-amz-target, Signature=dummy")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        if body:
+            return json.loads(body)
+        return {}
+    except urllib.error.HTTPError as e:
+        body = e.read().decode("utf-8")
+        code = "UnknownError"
+        message = body
+        try:
+            j = json.loads(body)
+            raw = j.get("__type") or j.get("code") or "UnknownError"
+            code = raw.split("#")[-1]
+            message = j.get("message") or j.get("Message") or ""
+        except ValueError:
+            pass
+        sys.stderr.write("An error occurred (" + code + "): " + message + "\n")
+        sys.exit(SERVICE_EXIT)
+    except urllib.error.URLError as e:
+        sys.stderr.write("Connection error: " + str(e.reason) + "\n")
+        sys.exit(SERVICE_EXIT)
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("missing command")
+    sub = argv[2]
+    if sub not in SPECS:
+        usage_error("unknown subcommand: " + sub)
+
+    spec = SPECS[sub]
+    params = parse_args(spec, argv[3:])
+
+    result = call(OP[sub], params)
+    sys.stdout.write(json.dumps(result, indent=2) + "\n")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
