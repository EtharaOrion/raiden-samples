@@ -0,0 +1,306 @@
+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+USAGE_EXIT = 252
+SERVICE_EXIT = 254
+
+
+def endpoint():
+    return os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ["AWS_ENDPOINT_URL"]
+
+
+def call(op, payload):
+    url = endpoint()
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(url, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20200101/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=host;x-amz-date;x-amz-target, Signature=dummy")
+    req.add_header("X-Amz-Date", "20200101T000000Z")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        if body:
+            return json.loads(body)
+        return {}
+    except urllib.error.HTTPError as e:
+        raise ServiceError(e)
+
+
+class ServiceError(Exception):
+    def __init__(self, httperr):
+        self.httperr = httperr
+        try:
+            body = httperr.read().decode("utf-8")
+            self.data = json.loads(body)
+        except Exception:
+            self.data = {}
+        typ = self.data.get("__type", "UnknownError")
+        self.code = typ.split("#")[-1]
+        self.message = self.data.get("message") or self.data.get("Message") or ""
+        super().__init__(self.code)
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: " + msg + "\n")
+    sys.exit(USAGE_EXIT)
+
+
+# Flag -> whether it takes a value (True) or is a store_true flag (False)
+STORE_TRUE = {
+    "--consistent-read",
+    "--deletion-protection-enabled",
+}
+
+# Flags whose values are JSON documents
+JSON_FLAGS = {
+    "--attribute-definitions", "--key-schema", "--provisioned-throughput",
+    "--global-secondary-indexes", "--local-secondary-indexes",
+    "--on-demand-throughput", "--sse-specification", "--stream-specification",
+    "--tags", "--warm-throughput", "--key", "--item", "--expected",
+    "--expression-attribute-names", "--expression-attribute-values",
+    "--attributes-to-get", "--attribute-updates", "--resource-policy",
+}
+
+# Flags with structured shorthand-only (list of maps) parsing
+SHORTHAND_LIST = {
+    "--attribute-definitions", "--key-schema", "--tags",
+}
+SHORTHAND_MAP = {
+    "--provisioned-throughput",
+}
+
+
+SUBCOMMAND_FLAGS = {
+    "create-table": [
+        "--attribute-definitions", "--billing-mode", "--deletion-protection-enabled",
+        "--global-secondary-indexes", "--global-table-settings-replication-mode",
+        "--global-table-source-arn", "--key-schema", "--local-secondary-indexes",
+        "--on-demand-throughput", "--provisioned-throughput", "--resource-policy",
+        "--sse-specification", "--stream-specification", "--table-class",
+        "--table-name", "--tags", "--warm-throughput",
+    ],
+    "delete-item": [
+        "--condition-expression", "--conditional-operator", "--expected",
+        "--expression-attribute-names", "--expression-attribute-values", "--key",
+        "--return-consumed-capacity", "--return-item-collection-metrics",
+        "--return-values", "--return-values-on-condition-check-failure", "--table-name",
+    ],
+    "delete-table": ["--table-name"],
+    "get-item": [
+        "--attributes-to-get", "--consistent-read", "--expression-attribute-names",
+        "--key", "--projection-expression", "--return-consumed-capacity", "--table-name",
+    ],
+    "list-tables": ["--exclusive-start-table-name", "--limit"],
+    "put-item": [
+        "--condition-expression", "--conditional-operator", "--expected",
+        "--expression-attribute-names", "--expression-attribute-values", "--item",
+        "--return-consumed-capacity", "--return-item-collection-metrics",
+        "--return-values", "--return-values-on-condition-check-failure", "--table-name",
+    ],
+}
+
+
+def to_pascal(flag):
+    parts = flag[2:].split("-")
+    return "".join(p[:1].upper() + p[1:] for p in parts)
+
+
+def parse_shorthand_list(value):
+    # e.g. AttributeName=pk,AttributeType=S AttributeName=sk,AttributeType=N
+    items = []
+    for chunk in value.split(" "):
+        chunk = chunk.strip()
+        if not chunk:
+            continue
+        d = {}
+        for kv in chunk.split(","):
+            if "=" not in kv:
+                raise ValueError("invalid shorthand")
+            k, v = kv.split("=", 1)
+            d[k] = v
+        items.append(d)
+    return items
+
+
+def parse_shorthand_map(value):
+    d = {}
+    for kv in value.split(","):
+        if "=" not in kv:
+            raise ValueError("invalid shorthand")
+        k, v = kv.split("=", 1)
+        try:
+            d[k] = int(v)
+        except ValueError:
+            d[k] = v
+    return d
+
+
+def parse_args(subcmd, argv):
+    allowed = set(SUBCOMMAND_FLAGS[subcmd])
+    seen = {}
+    i = 0
+    while i < len(argv):
+        tok = argv[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: " + tok)
+        if tok not in allowed:
+            usage_error("unknown flag: " + tok)
+        if tok in seen:
+            usage_error("duplicate flag: " + tok)
+        if tok in STORE_TRUE:
+            seen[tok] = True
+            i += 1
+            continue
+        if i + 1 >= len(argv):
+            usage_error("missing value for " + tok)
+        val = argv[i + 1]
+        seen[tok] = val
+        i += 2
+    return seen
+
+
+def build_request(subcmd, args):
+    req = {}
+    for flag, val in args.items():
+        field = to_pascal(flag)
+        if flag in STORE_TRUE:
+            req[field] = True
+            continue
+        if flag in SHORTHAND_LIST:
+            # try shorthand first, else JSON
+            s = val.strip()
+            if s.startswith("[") or s.startswith("{"):
+                try:
+                    req[field] = json.loads(val)
+                except Exception:
+                    usage_error("invalid JSON for " + flag)
+            else:
+                try:
+                    req[field] = parse_shorthand_list(val)
+                except Exception:
+                    usage_error("invalid value for " + flag)
+            continue
+        if flag in SHORTHAND_MAP:
+            s = val.strip()
+            if s.startswith("{"):
+                try:
+                    req[field] = json.loads(val)
+                except Exception:
+                    usage_error("invalid JSON for " + flag)
+            else:
+                try:
+                    req[field] = parse_shorthand_map(val)
+                except Exception:
+                    usage_error("invalid value for " + flag)
+            continue
+        if flag in JSON_FLAGS:
+            try:
+                req[field] = json.loads(val)
+            except Exception:
+                usage_error("invalid JSON for " + flag)
+            continue
+        if flag == "--limit":
+            try:
+                req[field] = int(val)
+            except ValueError:
+                usage_error("invalid integer for " + flag)
+            continue
+        req[field] = val
+    return req
+
+
+def require(args, flag):
+    if flag not in args:
+        usage_error("the following arguments are required: " + flag)
+
+
+def emit(result):
+    if result:
+        sys.stdout.write(json.dumps(result, indent=4) + "\n")
+
+
+def cmd_create_table(args):
+    require(args, "--table-name")
+    req = build_request("create-table", args)
+    result = call("CreateTable", req)
+    # If key schema was given, describe to reflect real behaviour
+    if "KeySchema" in req and "AttributeDefinitions" in req:
+        try:
+            call("DescribeTable", {"TableName": req["TableName"]})
+        except ServiceError:
+            pass
+    emit(result)
+
+
+def cmd_delete_table(args):
+    require(args, "--table-name")
+    req = build_request("delete-table", args)
+    result = call("DeleteTable", req)
+    emit(result)
+
+
+def cmd_put_item(args):
+    require(args, "--table-name")
+    require(args, "--item")
+    req = build_request("put-item", args)
+    result = call("PutItem", req)
+    emit(result)
+
+
+def cmd_get_item(args):
+    require(args, "--table-name")
+    require(args, "--key")
+    req = build_request("get-item", args)
+    result = call("GetItem", req)
+    emit(result)
+
+
+def cmd_delete_item(args):
+    require(args, "--table-name")
+    require(args, "--key")
+    req = build_request("delete-item", args)
+    result = call("DeleteItem", req)
+    emit(result)
+
+
+def cmd_list_tables(args):
+    req = build_request("list-tables", args)
+    result = call("ListTables", req)
+    emit(result)
+
+
+DISPATCH = {
+    "create-table": cmd_create_table,
+    "delete-table": cmd_delete_table,
+    "put-item": cmd_put_item,
+    "get-item": cmd_get_item,
+    "delete-item": cmd_delete_item,
+    "list-tables": cmd_list_tables,
+}
+
+
+def main():
+    argv = sys.argv
+    if len(argv) < 3:
+        usage_error("missing command")
+    subcmd = argv[2]
+    if subcmd not in DISPATCH:
+        usage_error("unknown command: " + subcmd)
+    args = parse_args(subcmd, argv[3:])
+    try:
+        DISPATCH[subcmd](args)
+    except ServiceError as e:
+        sys.stderr.write("An error occurred (" + e.code + "): " + e.message + "\n")
+        sys.exit(SERVICE_EXIT)
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
