+func doGet(args []string) {
+	spec := newFlagSpec()
+	spec.value("namespace", "output", "selector")
+	spec.bool_("all-namespaces", "watch")
+	spec.alias("n", "namespace")
+	spec.alias("o", "output")
+	spec.alias("l", "selector")
+	spec.alias("A", "all-namespaces")
+	spec.alias("w", "watch")
+	pos, flags, _ := spec.parse(args)
+	if len(pos) < 1 {
+		usageError("resource type required")
+	}
+	rtype := pos[0]
+	kind := resolveKind(rtype)
+	if _, ok := resolveResource(kind); !ok {
+		generalError(fmt.Sprintf("the server doesn't have a resource type %q: NotFound", rtype))
+	}
+	names := pos[1:]
+	c := newClient()
+	output := flags["output"]
+	allNs := flags["all-namespaces"] == "true"
+	var items []any
+	if len(names) > 0 {
+		for _, n := range names {
+			obj, status := c.tryGet(kind, flags["namespace"], n)
+			if status >= 400 {
+				apiError(status, "not found")
+			}
+			items = append(items, obj)
+		}
+	} else {
+		list := c.list(kind, flags["namespace"], allNs, flags["selector"])
+		items, _ = list["items"].([]any)
+	}
+	switch {
+	case output == "json":
+		if len(names) == 1 {
+			data, _ := json.MarshalIndent(items[0], "", "  ")
+			fmt.Println(string(data))
+		} else {
+			listObj := map[string]any{"apiVersion": "v1", "kind": "List", "items": items}
+			data, _ := json.MarshalIndent(listObj, "", "  ")
+			fmt.Println(string(data))
+		}
+	case output == "yaml":
+		if len(names) == 1 {
+			fmt.Print(emitYAML(items[0]))
+		} else {
+			listObj := map[string]any{"apiVersion": "v1", "kind": "List", "items": items}
+			fmt.Print(emitYAML(listObj))
+		}
+	case output == "name":
+		for _, it := range items {
+			m, _ := it.(map[string]any)
+			fmt.Printf("%s/%s\n", resourcePrefix(kind), manifestName(m))
+		}
+	case strings.HasPrefix(output, "jsonpath"):
+		expr := ""
+		if idx := strings.Index(output, "="); idx > 0 {
+			expr = output[idx+1:]
+		}
+		expr = strings.TrimPrefix(expr, "{")
+		expr = strings.TrimSuffix(expr, "}")
+		for _, it := range items {
+			fmt.Println(evalJsonpath(it, expr))
+		}
+	default:
+		printTable(kind, items, allNs)
+	}
+}
+
+func evalJsonpath(v any, path string) string {
+	cur := v
+	path = strings.TrimPrefix(path, ".")
+	for _, seg := range strings.Split(path, ".") {
+		if seg == "" {
+			continue
+		}
+		if m, ok := cur.(map[string]any); ok {
+			cur = m[seg]
+		} else {
+			return ""
+		}
+	}
+	if cur == nil {
+		return ""
+	}
+	if s, ok := cur.(string); ok {
+		return s
+	}
+	b, _ := json.Marshal(cur)
+	return string(b)
+}
+
+func printTable(kind string, items []any, allNs bool) {
+	if kind == "Pod" {
+		if allNs {
+			fmt.Println("NAMESPACE  NAME  READY  STATUS  RESTARTS  AGE")
+		} else {
+			fmt.Println("NAME  READY  STATUS  RESTARTS  AGE")
+		}
+		for _, it := range items {
+			m, _ := it.(map[string]any)
+			name := manifestName(m)
+			ns := manifestNS(m, "")
+			status := "Running"
+			restarts := "0"
+			if s, ok := m["status"].(map[string]any); ok {
+				if p, ok := s["phase"].(string); ok {
+					status = p
+				}
+			}
+			age := ageOf(m)
+			if allNs {
+				fmt.Printf("%s  %s  1/1  %s  %s  %s\n", ns, name, status, restarts, age)
+			} else {
+				fmt.Printf("%s  1/1  %s  %s  %s\n", name, status, restarts, age)
+			}
+		}
+		return
+	}
+	if allNs {
+		fmt.Println("NAMESPACE  NAME  AGE")
+	} else {
+		fmt.Println("NAME  AGE")
+	}
+	for _, it := range items {
+		m, _ := it.(map[string]any)
+		name := manifestName(m)
+		age := ageOf(m)
+		if allNs {
+			ns := manifestNS(m, "")
+			fmt.Printf("%s  %s  %s\n", ns, name, age)
+		} else {
+			fmt.Printf("%s  %s\n", name, age)
+		}
+	}
+}
+
+func ageOf(m map[string]any) string {
+	meta, _ := m["metadata"].(map[string]any)
+	if meta == nil {
+		return "<unknown>"
+	}
+	ts, _ := meta["creationTimestamp"].(string)
+	if ts == "" {
+		return "<unknown>"
+	}
+	t, err := time.Parse(time.RFC3339, ts)
+	if err != nil {
+		return "<unknown>"
+	}
+	d := time.Since(t)
+	if d < time.Minute {
+		return fmt.Sprintf("%ds", int(d.Seconds()))
+	}
+	if d < time.Hour {
+		return fmt.Sprintf("%dm", int(d.Minutes()))
+	}
+	if d < 24*time.Hour {
+		return fmt.Sprintf("%dh", int(d.Hours()))
+	}
+	return fmt.Sprintf("%dd", int(d.Hours()/24))
+}
+
+func doDescribe(args []string) {
+	spec := newFlagSpec()
+	spec.value("namespace", "selector", "filename")
+	spec.bool_("show-events", "all-namespaces")
+	spec.alias("n", "namespace")
+	spec.alias("l", "selector")
+	spec.alias("A", "all-namespaces")
+	spec.alias("f", "filename")
+	pos, flags, _ := spec.parse(args)
+	if len(pos) < 1 {
+		usageError("resource type required")
+	}
+	rtype := pos[0]
+	kind := resolveKind(rtype)
+	if _, ok := resolveResource(kind); !ok {
+		generalError(fmt.Sprintf("unknown resource type %q", rtype))
+	}
+	c := newClient()
+	var items []any
+	if len(pos) > 1 {
+		for _, n := range pos[1:] {
+			obj, status := c.tryGet(kind, flags["namespace"], n)
+			if status >= 400 {
+				apiError(status, "not found")
+			}
+			items = append(items, obj)
+		}
+	} else {
+		list := c.list(kind, flags["namespace"], flags["all-namespaces"] == "true", flags["selector"])
+		items, _ = list["items"].([]any)
+	}
+	for _, it := range items {
+		describeOne(it.(map[string]any))
+	}
+}
+
+func describeOne(m map[string]any) {
+	name := manifestName(m)
+	ns := manifestNS(m, "")
+	meta, _ := m["metadata"].(map[string]any)
+	labels := "<none>"
+	annos := "<none>"
+	if meta != nil {
+		if lm, ok := meta["labels"].(map[string]any); ok && len(lm) > 0 {
+			labels = mapToKV(lm)
+		}
+		if am, ok := meta["annotations"].(map[string]any); ok && len(am) > 0 {
+			annos = mapToKV(am)
+		}
+	}
+	status := "Active"
+	if s, ok := m["status"].(map[string]any); ok {
+		if p, ok := s["phase"].(string); ok {
+			status = p
+		}
+	}
+	fmt.Printf("Name:         %s\n", name)
+	fmt.Printf("Namespace:    %s\n", ns)
+	fmt.Printf("Labels:       %s\n", labels)
+	fmt.Printf("Annotations:  %s\n", annos)
+	fmt.Printf("Status:       %s\n", status)
+	fmt.Printf("Events:       <none>\n")
+}
+
+func mapToKV(m map[string]any) string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	parts := []string{}
+	for _, k := range keys {
+		v, _ := m[k].(string)
+		parts = append(parts, k+"="+v)
+	}
+	return strings.Join(parts, ",")
+}
+
+func doPatch(args []string) {
+	spec := newFlagSpec()
+	spec.value("namespace", "patch", "type", "dry-run")
+	spec.alias("n", "namespace")
+	spec.alias("p", "patch")
+	pos, flags, _ := spec.parse(args)
+	if len(pos) < 2 {
+		usageError("TYPE and NAME are required")
+	}
+	patchBody := flags["patch"]
+	if patchBody == "" {
+		usageError("--patch is required")
+	}
+	ptype := flags["type"]
+	if ptype == "" {
+		ptype = "merge"
+	}
+	ct := ""
+	switch ptype {
+	case "merge":
+		ct = "application/merge-patch+json"
+	case "strategic":
+		ct = "application/strategic-merge-patch+json"
+	case "json":
+		ct = "application/json-patch+json"
+	default:
+		usageError(fmt.Sprintf("unknown patch type %q", ptype))
+	}
+	var tmp any
+	if err := json.Unmarshal([]byte(patchBody), &tmp); err != nil {
+		usageError("unable to parse patch")
+	}
+	dryRun := flags["dry-run"]
+	if dryRun == "true" {
+		dryRun = "client"
+	}
+	kind := resolveKind(pos[0])
+	name := pos[1]
+	rlabel := resourcePrefix(kind)
+	if dryRun == "client" {
+		fmt.Printf("%s/%s patched (dry run)\n", rlabel, name)
+		return
+	}
+	c := newClient()
+	status, _ := c.patch(kind, flags["namespace"], name, ct, []byte(patchBody), dryRun)
+	if status >= 400 {
+		apiError(status, "patch failed")
+	}
+	suffix := ""
+	if dryRun == "server" {
+		suffix = " (dry run)"
+	}
+	fmt.Printf("%s/%s patched%s\n", rlabel, name, suffix)
+}
+
+func doLabel(args []string) {
+	spec := newFlagSpec()
+	spec.value("namespace", "selector")
+	spec.bool_("overwrite", "all")
+	spec.alias("n", "namespace")
+	spec.alias("l", "selector")
+	pos, flags, _ := spec.parse(args)
+	if len(pos) < 1 {
+		usageError("resource type required")
+	}
+	kind := resolveKind(pos[0])
+	if _, ok := resolveResource(kind); !ok {
+		generalError(fmt.Sprintf("unknown resource type %q", pos[0]))
+	}
+	names := []string{}
+	labels := map[string]*string{}
+	for _, a := range pos[1:] {
+		if strings.Contains(a, "=") {
+			idx := strings.Index(a, "=")
+			k := a[:idx]
+			v := a[idx+1:]
+			labels[k] = &v
+		} else if strings.HasSuffix(a, "-") {
+			k := a[:len(a)-1]
+			labels[k] = nil
+		} else {
+			names = append(names, a)
+		}
+	}
+	if len(labels) == 0 {
+		generalError("at least one label spec required")
+	}
+	if len(names) == 0 && flags["selector"] == "" {
+		generalError("resource name or --selector required")
+	}
+	c := newClient()
+	targets := names
+	if len(targets) == 0 {
+		list := c.list(kind, flags["namespace"], false, flags["selector"])
+		items, _ := list["items"].([]any)
+		for _, it := range items {
+			m, _ := it.(map[string]any)
+			targets = append(targets, manifestName(m))
+		}
+	}
+	rlabel := resourcePrefix(kind)
+	for _, nm := range targets {
+		if flags["overwrite"] != "true" {
+			obj := c.get(kind, flags["namespace"], nm)
+			meta, _ := obj["metadata"].(map[string]any)
+			existing := map[string]any{}
+			if meta != nil {
+				if lm, ok := meta["labels"].(map[string]any); ok {
+					existing = lm
+				}
+			}
+			for k, v := range labels {
+				if v == nil {
+					continue
+				}
+				if ev, ok := existing[k]; ok {
+					if es, _ := ev.(string); es != *v {
+						generalError(fmt.Sprintf("'%s' already has a value (%s), and --overwrite is false", k, es))
+					}
+				}
+			}
+		}
+		patchLabels := map[string]any{}
+		for k, v := range labels {
+			if v == nil {
+				patchLabels[k] = nil
+			} else {
+				patchLabels[k] = *v
+			}
+		}
+		patch := map[string]any{"metadata": map[string]any{"labels": patchLabels}}
+		data, _ := json.Marshal(patch)
+		status, _ := c.patch(kind, flags["namespace"], nm, "application/merge-patch+json", data, "")
+		if status >= 400 {
+			apiError(status, "label failed")
+		}
+		fmt.Printf("%s/%s labeled\n", rlabel, nm)
+	}
+}
+
+func doScale(args []string) {
+	spec := newFlagSpec()
+	spec.value("namespace", "replicas", "current-replicas", "resource-version")
+	spec.alias("n", "namespace")
+	pos, flags, _ := spec.parse(args)
+	if len(pos) < 2 {
+		usageError("TYPE and NAME are required")
+	}
+	rtype := pos[0]
+	kind := resolveKind(rtype)
+	switch kind {
+	case "Deployment", "StatefulSet", "ReplicaSet":
+	default:
+		generalError(fmt.Sprintf("cannot scale resource type %q: Invalid", rtype))
+	}
+	rs := flags["replicas"]
+	if rs == "" {
+		usageError("--replicas is required")
+	}
+	n, err := strconv.Atoi(rs)
+	if err != nil {
+		usageError("invalid --replicas value")
+	}
+	patch := map[string]any{"spec": map[string]any{"replicas": n}}
+	data, _ := json.Marshal(patch)
+	c := newClient()
+	status, _ := c.patch(kind, flags["namespace"], pos[1], "application/merge-patch+json", data, "")
+	if status >= 400 {
+		apiError(status, "scale failed")
+	}
+	fmt.Printf("%s/%s scaled\n", resourcePrefix(kind), pos[1])
+}
+
+func main() {
+	if len(os.Args) < 2 {
+		generalError("you must specify a command")
+	}
+	verb := os.Args[1]
+	args := os.Args[2:]
+	switch verb {
+	case "apply":
+		doApply(args)
+	case "create":
+		doCreate(args)
+	case "delete":
+		doDelete(args)
+	case "get":
+		doGet(args)
+	case "describe":
+		doDescribe(args)
+	case "patch":
+		doPatch(args)
+	case "label":
+		doLabel(args)
+	case "scale":
+		doScale(args)
+	default:
+		generalError(fmt.Sprintf("unknown command %q", verb))
+	}
+}
