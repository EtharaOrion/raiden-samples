+func createIngress(args []string) {
+	opts := parseCreateFlags(args, []string{"rule", "class"}, nil)
+	rules := []any{}
+	for _, r := range opts.Opts["rule"] {
+		host := ""
+		pathPart := r
+		if idx := strings.Index(r, "/"); idx >= 0 {
+			host = r[:idx]
+			pathPart = r[idx:]
+		}
+		pth := pathPart
+		svc := ""
+		port := 80
+		if idx := strings.Index(pathPart, "="); idx > 0 {
+			pth = pathPart[:idx]
+			svcPort := pathPart[idx+1:]
+			if pidx := strings.Index(svcPort, ":"); pidx > 0 {
+				svc = svcPort[:pidx]
+				port, _ = strconv.Atoi(svcPort[pidx+1:])
+			} else {
+				svc = svcPort
+			}
+		}
+		rule := map[string]any{}
+		if host != "" {
+			rule["host"] = host
+		}
+		rule["http"] = map[string]any{
+			"paths": []any{
+				map[string]any{
+					"path":     pth,
+					"pathType": "Prefix",
+					"backend": map[string]any{
+						"service": map[string]any{
+							"name": svc,
+							"port": map[string]any{"number": port},
+						},
+					},
+				},
+			},
+		}
+		rules = append(rules, rule)
+	}
+	spec := map[string]any{"rules": rules}
+	if cls := firstOrDefault(opts.Opts["class"], ""); cls != "" {
+		spec["ingressClassName"] = cls
+	}
+	body := map[string]any{
+		"apiVersion": "networking.k8s.io/v1",
+		"kind":       "Ingress",
+		"metadata":   map[string]any{"name": opts.Name},
+		"spec":       spec,
+	}
+	submitCreate("Ingress", body, opts)
+}
