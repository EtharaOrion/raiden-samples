+
+type yamlLine struct {
+	indent  int
+	content string
+	raw     string
+}
+
+func parseYAMLAll(src string) ([]any, error) {
+	docs := []any{}
+	rawLines := strings.Split(src, "\n")
+	var cur []yamlLine
+	flush := func() {
+		if len(cur) == 0 {
+			docs = append(docs, nil)
+			return
+		}
+		v, err := parseYAMLBlock(cur, 0, 0)
+		if err != nil {
+			docs = append(docs, nil)
+			return
+		}
+		if v == nil {
+			docs = append(docs, nil)
+		} else {
+			docs = append(docs, v)
+		}
+		cur = nil
+	}
+	for _, ln := range rawLines {
+		trimmed := strings.TrimRight(ln, "\r")
+		stripped := strings.TrimLeft(trimmed, " \t")
+		if strings.HasPrefix(strings.TrimSpace(trimmed), "---") {
+			flush()
+			continue
+		}
+		if strings.HasPrefix(strings.TrimSpace(trimmed), "...") {
+			flush()
+			continue
+		}
+		if stripped == "" {
+			continue
+		}
+		if strings.HasPrefix(stripped, "#") {
+			continue
+		}
+		indent := 0
+		for _, c := range trimmed {
+			if c == ' ' {
+				indent++
+			} else if c == '\t' {
+				indent += 8
+			} else {
+				break
+			}
+		}
+		content := stripComment(stripped)
+		if content == "" {
+			continue
+		}
+		cur = append(cur, yamlLine{indent: indent, content: content, raw: trimmed})
+	}
+	flush()
+	if len(docs) > 0 && docs[len(docs)-1] == nil && len(rawLines) > 0 {
+	}
+	out := []any{}
+	for _, d := range docs {
+		if d != nil {
+			out = append(out, d)
+		}
+	}
+	return out, nil
+}
+
+func stripComment(s string) string {
+	inSingle, inDouble := false, false
+	depth := 0
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == '\'' && !inDouble:
+			inSingle = !inSingle
+		case c == '"' && !inSingle:
+			inDouble = !inDouble
+		case (c == '{' || c == '[') && !inSingle && !inDouble:
+			depth++
+		case (c == '}' || c == ']') && !inSingle && !inDouble:
+			depth--
+		case c == '#' && !inSingle && !inDouble && depth == 0:
+			if i == 0 || s[i-1] == ' ' || s[i-1] == '\t' {
+				return strings.TrimRight(s[:i], " \t")
+			}
+		}
+	}
+	return s
+}
+
+func parseYAMLBlock(lines []yamlLine, start int, minIndent int) (any, error) {
+	if start >= len(lines) {
+		return nil, nil
+	}
+	firstIndent := lines[start].indent
+	if firstIndent < minIndent {
+		return nil, nil
+	}
+	if strings.HasPrefix(lines[start].content, "- ") || lines[start].content == "-" {
+		return parseYAMLBlockList(lines, start, firstIndent)
+	}
+	return parseYAMLBlockMap(lines, start, firstIndent)
+}
+
+func parseYAMLBlockList(lines []yamlLine, start int, indent int) ([]any, error) {
+	items := []any{}
+	i := start
+	for i < len(lines) {
+		if lines[i].indent < indent {
+			break
+		}
+		if lines[i].indent > indent {
+			i++
+			continue
+		}
+		c := lines[i].content
+		if !strings.HasPrefix(c, "- ") && c != "-" {
+			break
+		}
+		var rest string
+		if c == "-" {
+			rest = ""
+		} else {
+			rest = strings.TrimLeft(c[2:], " \t")
+		}
+		if rest == "" {
+			child, next := consumeChild(lines, i+1, indent)
+			items = append(items, child)
+			i = next
+		} else if kv, ok := splitKeyValue(rest); ok {
+			m := map[string]any{}
+			if kv.value == "" {
+				child, next := consumeChild(lines, i+1, indent+2)
+				m[kv.key] = child
+				i = next
+			} else {
+				v, err := parseScalarOrFlow(kv.value)
+				if err != nil {
+					return nil, err
+				}
+				m[kv.key] = v
+				i++
+			}
+			for i < len(lines) && lines[i].indent > indent {
+				if lines[i].indent == indent+2 {
+					mkv, ok := splitKeyValue(lines[i].content)
+					if !ok {
+						i++
+						continue
+					}
+					if mkv.value == "" {
+						child, next := consumeChild(lines, i+1, indent+2)
+						m[mkv.key] = child
+						i = next
+					} else {
+						vv, err := parseScalarOrFlow(mkv.value)
+						if err != nil {
+							return nil, err
+						}
+						m[mkv.key] = vv
+						i++
+					}
+				} else {
+					i++
+				}
+			}
+			items = append(items, m)
+		} else {
+			v, err := parseScalarOrFlow(rest)
+			if err != nil {
+				return nil, err
+			}
+			items = append(items, v)
+			i++
+		}
+	}
+	return items, nil
+}
+
+func consumeChild(lines []yamlLine, start int, parentIndent int) (any, int) {
+	if start >= len(lines) {
+		return nil, start
+	}
+	if lines[start].indent == parentIndent && (strings.HasPrefix(lines[start].content, "- ") || lines[start].content == "-") {
+		childIndent := parentIndent
+		sub := []yamlLine{}
+		i := start
+		for i < len(lines) && lines[i].indent >= childIndent {
+			if lines[i].indent == parentIndent && !strings.HasPrefix(lines[i].content, "- ") && lines[i].content != "-" {
+				break
+			}
+			sub = append(sub, lines[i])
+			i++
+		}
+		v, _ := parseYAMLBlock(sub, 0, childIndent)
+		return v, i
+	}
+	if lines[start].indent <= parentIndent {
+		return nil, start
+	}
+	childIndent := lines[start].indent
+	sub := []yamlLine{}
+	i := start
+	for i < len(lines) && lines[i].indent >= childIndent {
+		sub = append(sub, lines[i])
+		i++
+	}
+	v, _ := parseYAMLBlock(sub, 0, childIndent)
+	return v, i
+}
+
+type kvPair struct {
+	key   string
+	value string
+}
+
+func splitKeyValue(s string) (kvPair, bool) {
+	inSingle, inDouble := false, false
+	depth := 0
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == '\'' && !inDouble:
+			inSingle = !inSingle
+		case c == '"' && !inSingle:
+			inDouble = !inDouble
+		case (c == '{' || c == '[') && !inSingle && !inDouble:
+			depth++
+		case (c == '}' || c == ']') && !inSingle && !inDouble:
+			depth--
+		case c == ':' && !inSingle && !inDouble && depth == 0:
+			if i+1 >= len(s) || s[i+1] == ' ' || s[i+1] == '\t' {
+				k := strings.TrimSpace(s[:i])
+				v := ""
+				if i+1 < len(s) {
+					v = strings.TrimSpace(s[i+1:])
+				}
+				k = unquote(k)
+				return kvPair{key: k, value: v}, true
+			}
+			if i == len(s)-1 {
+				return kvPair{key: unquote(strings.TrimSpace(s[:i])), value: ""}, true
+			}
+		}
+	}
+	return kvPair{}, false
+}
+
+func parseYAMLBlockMap(lines []yamlLine, start int, indent int) (map[string]any, error) {
+	m := map[string]any{}
+	i := start
+	for i < len(lines) {
+		if lines[i].indent < indent {
+			break
+		}
+		if lines[i].indent > indent {
+			i++
+			continue
+		}
+		kv, ok := splitKeyValue(lines[i].content)
+		if !ok {
+			i++
+			continue
+		}
+		if kv.value == "" {
+			child, next := consumeChild(lines, i+1, indent)
+			m[kv.key] = child
+			i = next
+		} else if strings.HasPrefix(kv.value, "|") || strings.HasPrefix(kv.value, ">") {
+			literal := strings.HasPrefix(kv.value, "|")
+			i++
+			blk := []string{}
+			for i < len(lines) && lines[i].indent > indent {
+				blk = append(blk, strings.Repeat(" ", lines[i].indent-indent-2)+lines[i].content)
+				i++
+			}
+			if literal {
+				m[kv.key] = strings.Join(blk, "\n") + "\n"
+			} else {
+				m[kv.key] = strings.Join(blk, " ")
+			}
+		} else {
+			v, err := parseScalarOrFlow(kv.value)
+			if err != nil {
+				return nil, err
+			}
+			m[kv.key] = v
+			i++
+		}
+	}
+	return m, nil
+}
+
+func unquote(s string) string {
+	if len(s) >= 2 {
+		if s[0] == '"' && s[len(s)-1] == '"' {
+			out, err := strconv.Unquote(s)
+			if err == nil {
+				return out
+			}
+			return s[1 : len(s)-1]
+		}
+		if s[0] == '\'' && s[len(s)-1] == '\'' {
+			return strings.ReplaceAll(s[1:len(s)-1], "''", "'")
+		}
+	}
+	return s
+}
+
+func parseScalarOrFlow(s string) (any, error) {
+	s = strings.TrimSpace(s)
+	if s == "" || s == "~" || s == "null" || s == "Null" || s == "NULL" {
+		return nil, nil
+	}
+	if strings.HasPrefix(s, "{") {
+		v, _, err := parseFlow(s, 0)
+		return v, err
+	}
+	if strings.HasPrefix(s, "[") {
+		v, _, err := parseFlow(s, 0)
+		return v, err
+	}
+	return parseScalar(s), nil
+}
+
+func parseScalar(s string) any {
+	if len(s) >= 2 && (s[0] == '"' || s[0] == '\'') {
+		return unquote(s)
+	}
+	switch s {
+	case "true", "True", "TRUE", "yes", "Yes":
+		return true
+	case "false", "False", "FALSE", "no", "No":
+		return false
+	}
+	if n, err := strconv.ParseInt(s, 10, 64); err == nil {
+		return n
+	}
+	if f, err := strconv.ParseFloat(s, 64); err == nil {
+		return f
+	}
+	return s
+}
+
+func parseFlow(s string, pos int) (any, int, error) {
+	pos = skipSpace(s, pos)
+	if pos >= len(s) {
+		return nil, pos, fmt.Errorf("unexpected eof")
+	}
+	if s[pos] == '{' {
+		return parseFlowMap(s, pos+1)
+	}
+	if s[pos] == '[' {
+		return parseFlowList(s, pos+1)
+	}
+	return parseFlowScalar(s, pos)
+}
+
+func parseFlowMap(s string, pos int) (map[string]any, int, error) {
+	m := map[string]any{}
+	pos = skipSpace(s, pos)
+	if pos < len(s) && s[pos] == '}' {
+		return m, pos + 1, nil
+	}
+	for pos < len(s) {
+		pos = skipSpace(s, pos)
+		key, next, err := readFlowKey(s, pos)
+		if err != nil {
+			return nil, pos, err
+		}
+		pos = skipSpace(s, next)
+		if pos >= len(s) || s[pos] != ':' {
+			m[key] = nil
+		} else {
+			pos++
+			pos = skipSpace(s, pos)
+			v, next2, err := parseFlow(s, pos)
+			if err != nil {
+				return nil, pos, err
+			}
+			m[key] = v
+			pos = next2
+		}
+		pos = skipSpace(s, pos)
+		if pos < len(s) && s[pos] == ',' {
+			pos++
+			continue
+		}
+		if pos < len(s) && s[pos] == '}' {
+			return m, pos + 1, nil
+		}
+		if pos >= len(s) {
+			return nil, pos, fmt.Errorf("unterminated flow map")
+		}
+	}
+	return nil, pos, fmt.Errorf("unterminated flow map")
+}
+
+func parseFlowList(s string, pos int) ([]any, int, error) {
+	list := []any{}
+	pos = skipSpace(s, pos)
+	if pos < len(s) && s[pos] == ']' {
+		return list, pos + 1, nil
+	}
+	for pos < len(s) {
+		pos = skipSpace(s, pos)
+		v, next, err := parseFlow(s, pos)
+		if err != nil {
+			return nil, pos, err
+		}
+		list = append(list, v)
+		pos = skipSpace(s, next)
+		if pos < len(s) && s[pos] == ',' {
+			pos++
+			continue
+		}
+		if pos < len(s) && s[pos] == ']' {
+			return list, pos + 1, nil
+		}
+		if pos >= len(s) {
+			return nil, pos, fmt.Errorf("unterminated flow list")
+		}
+	}
+	return nil, pos, fmt.Errorf("unterminated flow list")
+}
+
+func readFlowKey(s string, pos int) (string, int, error) {
+	pos = skipSpace(s, pos)
+	if pos >= len(s) {
+		return "", pos, fmt.Errorf("expected key")
+	}
+	if s[pos] == '"' || s[pos] == '\'' {
+		q := s[pos]
+		start := pos
+		pos++
+		for pos < len(s) && s[pos] != q {
+			if s[pos] == '\\' && pos+1 < len(s) {
+				pos += 2
+				continue
+			}
+			pos++
+		}
+		if pos >= len(s) {
+			return "", pos, fmt.Errorf("unterminated string")
+		}
+		key := unquote(s[start : pos+1])
+		return key, pos + 1, nil
+	}
+	start := pos
+	for pos < len(s) && s[pos] != ':' && s[pos] != ',' && s[pos] != '}' && s[pos] != ']' {
+		pos++
+	}
+	return strings.TrimSpace(s[start:pos]), pos, nil
+}
+
+func parseFlowScalar(s string, pos int) (any, int, error) {
+	if pos >= len(s) {
+		return nil, pos, nil
+	}
+	if s[pos] == '"' || s[pos] == '\'' {
+		q := s[pos]
+		start := pos
+		pos++
+		for pos < len(s) && s[pos] != q {
+			if s[pos] == '\\' && pos+1 < len(s) {
+				pos += 2
+				continue
+			}
+			pos++
+		}
+		if pos >= len(s) {
+			return nil, pos, fmt.Errorf("unterminated string")
+		}
+		v := unquote(s[start : pos+1])
+		return v, pos + 1, nil
+	}
+	start := pos
+	for pos < len(s) && s[pos] != ',' && s[pos] != '}' && s[pos] != ']' {
+		pos++
+	}
+	tok := strings.TrimSpace(s[start:pos])
+	return parseScalar(tok), pos, nil
+}
+
+func skipSpace(s string, pos int) int {
+	for pos < len(s) && (s[pos] == ' ' || s[pos] == '\t' || s[pos] == '\n') {
+		pos++
+	}
+	return pos
+}
+
+func emitYAML(v any) string {
+	var b strings.Builder
+	emitYAMLAt(&b, v, 0, false)
+	return b.String()
+}
+
+func emitYAMLAt(b *strings.Builder, v any, indent int, inList bool) {
+	pad := strings.Repeat(" ", indent)
+	switch x := v.(type) {
+	case map[string]any:
+		if len(x) == 0 {
+			b.WriteString("{}\n")
+			return
+		}
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		first := true
+		for _, k := range keys {
+			if first && inList {
+				first = false
+			} else {
+				b.WriteString(pad)
+			}
+			b.WriteString(k)
+			b.WriteString(":")
+			cv := x[k]
+			if isScalar(cv) {
+				b.WriteString(" ")
+				b.WriteString(scalarYAML(cv))
+				b.WriteString("\n")
+			} else {
+				b.WriteString("\n")
+				emitYAMLAt(b, cv, indent+2, false)
+			}
+		}
+	case []any:
+		if len(x) == 0 {
+			b.WriteString("[]\n")
+			return
+		}
+		for _, item := range x {
+			b.WriteString(pad)
+			b.WriteString("- ")
+			if isScalar(item) {
+				b.WriteString(scalarYAML(item))
+				b.WriteString("\n")
+			} else {
+				emitYAMLAt(b, item, indent+2, true)
+			}
+		}
+	default:
+		b.WriteString(pad)
+		b.WriteString(scalarYAML(v))
+		b.WriteString("\n")
+	}
+}
+
+func isScalar(v any) bool {
+	switch v.(type) {
+	case map[string]any, []any:
+		return false
+	}
+	return true
+}
+
+func scalarYAML(v any) string {
+	if v == nil {
+		return "null"
+	}
+	switch x := v.(type) {
+	case string:
+		if needsQuote(x) {
+			return strconv.Quote(x)
+		}
+		return x
+	case bool:
+		if x {
+			return "true"
+		}
+		return "false"
+	case int:
+		return strconv.Itoa(x)
+	case int64:
+		return strconv.FormatInt(x, 10)
+	case float64:
+		return strconv.FormatFloat(x, 'g', -1, 64)
+	}
+	return fmt.Sprintf("%v", v)
+}
+
+func needsQuote(s string) bool {
+	if s == "" {
+		return true
+	}
+	for _, r := range s {
+		if r == ':' || r == '#' || r == '\n' || r == '\'' || r == '"' || r == '{' || r == '}' || r == '[' || r == ']' || r == ',' || r == '&' || r == '*' || r == '!' || r == '|' || r == '>' || r == '%' || r == '@' || r == '`' {
+			return true
+		}
+	}
+	if _, err := strconv.ParseFloat(s, 64); err == nil {
+		return true
+	}
+	switch s {
+	case "true", "false", "null", "yes", "no", "True", "False", "Null", "Yes", "No":
+		return true
+	}
+	if !unicode.IsLetter(rune(s[0])) && s[0] != '/' && s[0] != '_' {
+		return true
+	}
+	return false
+}
+
+type restCfg struct {
+	Server   string
+	CA       []byte
+	Insecure bool
+	Cert     []byte
+	Key      []byte
+	Token    string
+}
+
+func loadKubeconfig() (*restCfg, error) {
+	path := os.Getenv("KUBECONFIG")
+	if path == "" {
+		home, _ := os.UserHomeDir()
+		path = filepath.Join(home, ".kube", "config")
+	}
+	if strings.Contains(path, ":") {
+		path = strings.Split(path, ":")[0]
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read kubeconfig: %w", err)
+	}
+	docs, err := parseYAMLAll(string(data))
+	if err != nil || len(docs) == 0 {
+		return nil, fmt.Errorf("parse kubeconfig")
+	}
+	root, ok := docs[0].(map[string]any)
+	if !ok {
+		return nil, fmt.Errorf("invalid kubeconfig")
+	}
+	currCtx, _ := root["current-context"].(string)
+	contexts, _ := root["contexts"].([]any)
+	clusters, _ := root["clusters"].([]any)
+	users, _ := root["users"].([]any)
+	var ctxName, clusterName, userName string
+	ctxName = currCtx
+	for _, c := range contexts {
+		cm, _ := c.(map[string]any)
+		if cm == nil {
+			continue
+		}
+		if name, _ := cm["name"].(string); name == ctxName {
+			if inner, _ := cm["context"].(map[string]any); inner != nil {
+				clusterName, _ = inner["cluster"].(string)
+				userName, _ = inner["user"].(string)
+			}
+		}
+	}
+	cfg := &restCfg{}
+	for _, c := range clusters {
+		cm, _ := c.(map[string]any)
+		if cm == nil {
+			continue
+		}
+		if name, _ := cm["name"].(string); name == clusterName || clusterName == "" {
+			if inner, _ := cm["cluster"].(map[string]any); inner != nil {
+				cfg.Server, _ = inner["server"].(string)
+				if b, ok := inner["insecure-skip-tls-verify"].(bool); ok {
+					cfg.Insecure = b
+				}
+				if s, ok := inner["certificate-authority-data"].(string); ok {
+					cfg.CA, _ = base64.StdEncoding.DecodeString(s)
+				}
+				if s, ok := inner["certificate-authority"].(string); ok {
+					cfg.CA, _ = os.ReadFile(s)
+				}
+			}
+			break
+		}
+	}
+	for _, u := range users {
+		um, _ := u.(map[string]any)
+		if um == nil {
+			continue
+		}
+		if name, _ := um["name"].(string); name == userName || userName == "" {
+			if inner, _ := um["user"].(map[string]any); inner != nil {
+				if s, ok := inner["client-certificate-data"].(string); ok {
+					cfg.Cert, _ = base64.StdEncoding.DecodeString(s)
+				}
+				if s, ok := inner["client-key-data"].(string); ok {
+					cfg.Key, _ = base64.StdEncoding.DecodeString(s)
+				}
+				if s, ok := inner["client-certificate"].(string); ok {
+					cfg.Cert, _ = os.ReadFile(s)
+				}
+				if s, ok := inner["client-key"].(string); ok {
+					cfg.Key, _ = os.ReadFile(s)
+				}
+				if s, ok := inner["token"].(string); ok {
+					cfg.Token = s
+				}
+			}
+			break
+		}
+	}
+	if cfg.Server == "" {
+		return nil, fmt.Errorf("no server in kubeconfig")
+	}
+	return cfg, nil
+}
+
+func newHTTPClient(cfg *restCfg) (*http.Client, error) {
+	tlsCfg := &tls.Config{InsecureSkipVerify: cfg.Insecure}
+	if len(cfg.CA) > 0 {
+		pool := x509.NewCertPool()
+		pool.AppendCertsFromPEM(cfg.CA)
+		tlsCfg.RootCAs = pool
+	}
+	if len(cfg.Cert) > 0 && len(cfg.Key) > 0 {
+		cert, err := tls.X509KeyPair(cfg.Cert, cfg.Key)
+		if err != nil {
+			return nil, err
+		}
+		tlsCfg.Certificates = []tls.Certificate{cert}
+	}
+	return &http.Client{
+		Timeout:   30 * time.Second,
+		Transport: &http.Transport{TLSClientConfig: tlsCfg},
+	}, nil
+}
+
+type apiClient struct {
+	cfg    *restCfg
+	http   *http.Client
+	server string
+}
+
+func newClient() *apiClient {
+	cfg, err := loadKubeconfig()
+	if err != nil {
+		generalError(err.Error())
+	}
+	hc, err := newHTTPClient(cfg)
+	if err != nil {
+		generalError(err.Error())
+	}
+	return &apiClient{cfg: cfg, http: hc, server: strings.TrimRight(cfg.Server, "/")}
+}
+
+func apiPath(kind, ns, name string) string {
+	info, ok := kindTable[kind]
+	if !ok {
+		return ""
+	}
+	var base string
+	if info.Group == "" {
+		base = "/api/" + info.Version
+	} else {
+		base = "/apis/" + info.Group + "/" + info.Version
+	}
+	if info.Namespaced {
+		if ns == "" {
+			ns = "default"
+		}
+		base += "/namespaces/" + ns
+	}
+	base += "/" + info.Plural
+	if name != "" {
+		base += "/" + name
+	}
+	return base
+}
+
+func apiListPath(kind, ns string, allNs bool) string {
+	info, ok := kindTable[kind]
+	if !ok {
+		return ""
+	}
+	var base string
+	if info.Group == "" {
+		base = "/api/" + info.Version
+	} else {
+		base = "/apis/" + info.Group + "/" + info.Version
+	}
+	if info.Namespaced && !allNs {
+		if ns == "" {
+			ns = "default"
+		}
+		base += "/namespaces/" + ns
+	}
+	base += "/" + info.Plural
+	return base
+}
+
+func (c *apiClient) do(method, path, contentType string, body []byte, query map[string]string) (int, []byte, error) {
+	u := c.server + path
+	if len(query) > 0 {
+		parts := []string{}
+		for k, v := range query {
+			parts = append(parts, k+"="+v)
+		}
+		u += "?" + strings.Join(parts, "&")
+	}
+	var reqBody io.Reader
+	if body != nil {
+		reqBody = bytes.NewReader(body)
+	}
+	req, err := http.NewRequest(method, u, reqBody)
+	if err != nil {
+		return 0, nil, err
+	}
+	if contentType != "" {
+		req.Header.Set("Content-Type", contentType)
+	}
+	req.Header.Set("Accept", "application/json")
+	if c.cfg.Token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.cfg.Token)
+	}
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return 0, nil, err
+	}
+	defer resp.Body.Close()
+	data, err := io.ReadAll(resp.Body)
+	return resp.StatusCode, data, err
+}
+
+func extractMsg(body []byte) string {
+	var status struct {
+		Message string `json:"message"`
+	}
+	if err := json.Unmarshal(body, &status); err == nil && status.Message != "" {
+		return status.Message
+	}
+	return string(body)
+}
+
+func (c *apiClient) get(kind, ns, name string) map[string]any {
+	status, body, err := c.do("GET", apiPath(kind, ns, name), "", nil, nil)
+	if err != nil {
+		generalError(err.Error())
+	}
+	if status >= 400 {
+		apiError(status, extractMsg(body))
+	}
+	var out map[string]any
+	json.Unmarshal(body, &out)
+	return out
+}
