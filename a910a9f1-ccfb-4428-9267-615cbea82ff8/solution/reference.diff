+func createService(args []string) {
+	if len(args) < 1 {
+		usageError("must specify service subtype")
+	}
+	sub := args[0]
+	rest := args[1:]
+	opts := parseCreateFlags(rest, []string{"tcp", "external-name", "node-port"}, nil)
+	typeMap := map[string]string{
+		"clusterip":    "ClusterIP",
+		"nodeport":     "NodePort",
+		"loadbalancer": "LoadBalancer",
+		"externalname": "ExternalName",
+	}
+	stype, ok := typeMap[sub]
+	if !ok {
+		generalError(fmt.Sprintf("unknown service subtype %q", sub))
+	}
+	spec := map[string]any{"type": stype}
+	if sub == "externalname" {
+		spec["externalName"] = firstOrDefault(opts.Opts["external-name"], "")
+	} else {
+		ports := []any{}
+		for _, tcp := range opts.Opts["tcp"] {
+			parts := strings.SplitN(tcp, ":", 2)
+			p, _ := strconv.Atoi(parts[0])
+			tp := p
+			if len(parts) == 2 {
+				tp, _ = strconv.Atoi(parts[1])
+			}
+			ports = append(ports, map[string]any{"port": p, "targetPort": tp, "protocol": "TCP"})
+		}
+		spec["ports"] = ports
+		spec["selector"] = map[string]any{"app": opts.Name}
+	}
+	body := map[string]any{
+		"apiVersion": "v1",
+		"kind":       "Service",
+		"metadata":   map[string]any{"name": opts.Name},
+		"spec":       spec,
+	}
+	submitCreate("Service", body, opts)
+}
