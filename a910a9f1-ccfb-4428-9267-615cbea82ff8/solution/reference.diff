+
+type flagSpec struct {
+	boolFlags  map[string]bool
+	valueFlags map[string]bool
+	aliases    map[string]string
+}
+
+func newFlagSpec() *flagSpec {
+	return &flagSpec{
+		boolFlags:  map[string]bool{},
+		valueFlags: map[string]bool{},
+		aliases:    map[string]string{},
+	}
+}
+
+func (f *flagSpec) bool_(names ...string) {
+	for _, n := range names {
+		f.boolFlags[n] = true
+	}
+}
+
+func (f *flagSpec) value(names ...string) {
+	for _, n := range names {
+		f.valueFlags[n] = true
+	}
+}
+
+func (f *flagSpec) alias(short, long string) {
+	f.aliases[short] = long
+}
+
+func (f *flagSpec) parse(args []string) ([]string, map[string]string, map[string][]string) {
+	pos := []string{}
+	flags := map[string]string{}
+	multi := map[string][]string{}
+	i := 0
+	for i < len(args) {
+		a := args[i]
+		if a == "--" {
+			pos = append(pos, args[i+1:]...)
+			i = len(args)
+			continue
+		}
+		if !strings.HasPrefix(a, "-") || a == "-" {
+			pos = append(pos, a)
+			i++
+			continue
+		}
+		if len(a) > 1 && (a[1] >= '0' && a[1] <= '9') {
+			pos = append(pos, a)
+			i++
+			continue
+		}
+		name := a
+		val := ""
+		hasVal := false
+		if idx := strings.Index(a, "="); idx >= 0 {
+			name = a[:idx]
+			val = a[idx+1:]
+			hasVal = true
+		}
+		key := strings.TrimLeft(name, "-")
+		if long, ok := f.aliases[key]; ok {
+			key = long
+		}
+		if f.boolFlags[key] {
+			if hasVal {
+				flags[key] = val
+			} else {
+				flags[key] = "true"
+			}
+			multi[key] = append(multi[key], flags[key])
+			i++
+			continue
+		}
+		if f.valueFlags[key] {
+			if !hasVal {
+				if i+1 >= len(args) {
+					usageError("flag needs an argument: --" + key)
+				}
+				val = args[i+1]
+				i += 2
+			} else {
+				i++
+			}
+			flags[key] = val
+			multi[key] = append(multi[key], val)
+			continue
+		}
+		usageError("unknown flag: " + name)
+	}
+	return pos, flags, multi
+}
+
+func loadManifests(path string) []map[string]any {
+	if _, err := os.Stat(path); err != nil {
+		notFoundErr(fmt.Sprintf("the path %q does not exist: not found", path))
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		notFoundErr(err.Error())
+	}
+	docs, err := parseYAMLAll(string(data))
+	if err != nil {
+		notFoundErr(err.Error())
+	}
+	out := []map[string]any{}
+	for _, d := range docs {
+		if m, ok := d.(map[string]any); ok && len(m) > 0 {
+			out = append(out, m)
+		}
+	}
+	return out
+}
+
+func manifestNS(m map[string]any, override string) string {
+	if override != "" {
+		return override
+	}
+	meta, _ := m["metadata"].(map[string]any)
+	if meta == nil {
+		return "default"
+	}
+	if ns, ok := meta["namespace"].(string); ok && ns != "" {
+		return ns
+	}
+	return "default"
+}
+
+func manifestName(m map[string]any) string {
+	meta, _ := m["metadata"].(map[string]any)
+	if meta == nil {
+		return ""
+	}
+	name, _ := meta["name"].(string)
+	return name
+}
+
+func manifestKind(m map[string]any) string {
+	k, _ := m["kind"].(string)
+	return k
+}
+
+func doApply(args []string) {
+	spec := newFlagSpec()
+	spec.value("filename", "namespace", "dry-run")
+	spec.bool_("force", "recursive")
+	spec.alias("f", "filename")
+	spec.alias("n", "namespace")
+	spec.alias("R", "recursive")
+	_, flags, _ := spec.parse(args)
+	path, ok := flags["filename"]
+	if !ok || path == "" {
+		generalError("must specify -f")
+	}
+	nsFlag := flags["namespace"]
+	dryRun := flags["dry-run"]
+	if dryRun == "true" {
+		dryRun = "client"
+	}
+	c := newClient()
+	manifests := loadManifests(path)
+	for _, m := range manifests {
+		kind := manifestKind(m)
+		if kind == "" {
+			continue
+		}
+		name := manifestName(m)
+		info, ok := resolveResource(kind)
+		if !ok {
+			generalError(fmt.Sprintf("unknown kind %q", kind))
+		}
+		ns := ""
+		if info.Namespaced {
+			ns = manifestNS(m, nsFlag)
+		}
+		rlabel := resourcePrefix(kind)
+		if dryRun == "client" {
+			fmt.Printf("%s/%s created (dry run)\n", rlabel, name)
+			continue
+		}
+		status, _ := c.create(kind, ns, m, dryRun)
+		switch {
+		case status < 300:
+			suffix := ""
+			if dryRun == "server" {
+				suffix = " (dry run)"
+			}
+			fmt.Printf("%s/%s created%s\n", rlabel, name, suffix)
+		case status == 409:
+			data, _ := json.Marshal(m)
+			pStatus, _ := c.patch(kind, ns, name, "application/merge-patch+json", data, dryRun)
+			if pStatus >= 400 {
+				apiError(pStatus, "patch failed")
+			}
+			suffix := ""
+			if dryRun == "server" {
+				suffix = " (dry run)"
+			}
+			fmt.Printf("%s/%s configured%s\n", rlabel, name, suffix)
+		default:
+			apiError(status, "apply failed")
+		}
+	}
+}
+
+func doCreate(args []string) {
+	for _, a := range args {
+		if a == "-f" || a == "--filename" || strings.HasPrefix(a, "-f=") || strings.HasPrefix(a, "--filename=") {
+			doApplyCreateF(args)
+			return
+		}
+	}
+	if len(args) < 1 {
+		usageError("must specify create type")
+	}
+	sub := args[0]
+	rest := args[1:]
+	switch sub {
+	case "namespace", "ns":
+		createNamespace(rest)
+	case "configmap", "cm":
+		createConfigMap(rest)
+	case "secret":
+		createSecret(rest)
+	case "serviceaccount", "sa":
+		createServiceAccount(rest)
+	case "job":
+		createJob(rest)
+	case "deployment", "deploy":
+		createDeployment(rest)
+	case "service", "svc":
+		createService(rest)
+	case "role":
+		createRole(rest)
+	case "clusterrole":
+		createClusterRole(rest)
+	case "rolebinding":
+		createRoleBinding(rest)
+	case "clusterrolebinding":
+		createClusterRoleBinding(rest)
+	case "resourcequota", "quota":
+		createResourceQuota(rest)
+	case "poddisruptionbudget", "pdb":
+		createPDB(rest)
+	case "priorityclass", "pc":
+		createPriorityClass(rest)
+	case "limitrange":
+		createLimitRange(rest)
+	case "ingress", "ing":
+		createIngress(rest)
+	default:
+		generalError(fmt.Sprintf("unknown create type %q", sub))
+	}
+}
+
+func doApplyCreateF(args []string) {
+	spec := newFlagSpec()
+	spec.value("filename", "namespace", "dry-run")
+	spec.bool_("recursive")
+	spec.alias("f", "filename")
+	spec.alias("n", "namespace")
+	spec.alias("R", "recursive")
+	_, flags, _ := spec.parse(args)
+	path := flags["filename"]
+	if path == "" {
+		generalError("must specify -f")
+	}
+	nsFlag := flags["namespace"]
+	dryRun := flags["dry-run"]
+	if dryRun == "true" {
+		dryRun = "client"
+	}
+	c := newClient()
+	for _, m := range loadManifests(path) {
+		kind := manifestKind(m)
+		name := manifestName(m)
+		info, ok := resolveResource(kind)
+		if !ok {
+			generalError(fmt.Sprintf("unknown kind %q", kind))
+		}
+		ns := ""
+		if info.Namespaced {
+			ns = manifestNS(m, nsFlag)
+		}
+		rlabel := resourcePrefix(kind)
+		if dryRun == "client" {
+			fmt.Printf("%s/%s created (dry run)\n", rlabel, name)
+			continue
+		}
+		status, _ := c.create(kind, ns, m, dryRun)
+		if status >= 400 {
+			apiError(status, "create failed")
+		}
+		suffix := ""
+		if dryRun == "server" {
+			suffix = " (dry run)"
+		}
+		fmt.Printf("%s/%s created%s\n", rlabel, name, suffix)
+	}
+}
+
+type createOpts struct {
+	Name    string
+	NS      string
+	DryRun  string
+	Opts    map[string][]string
+	Args    []string
+}
+
+func parseCreateFlags(args []string, extraVal []string, extraBool []string) createOpts {
+	spec := newFlagSpec()
+	spec.value(append([]string{"namespace", "dry-run"}, extraVal...)...)
+	spec.bool_(extraBool...)
+	spec.alias("n", "namespace")
+	pos, flags, multi := spec.parse(args)
+	if len(pos) < 1 {
+		usageError("NAME is required")
+	}
+	dr := flags["dry-run"]
+	if dr == "true" {
+		dr = "client"
+	}
+	return createOpts{
+		Name:   pos[0],
+		NS:     flags["namespace"],
+		DryRun: dr,
+		Opts:   multi,
+		Args:   pos,
+	}
+}
+
+func submitCreate(kind string, body map[string]any, opts createOpts) {
+	rlabel := resourcePrefix(kind)
+	info, _ := resolveResource(kind)
+	ns := ""
+	if info.Namespaced {
+		ns = opts.NS
+		if ns == "" {
+			ns = "default"
+		}
+	}
+	if opts.DryRun == "client" {
+		fmt.Printf("%s/%s created (dry run)\n", rlabel, opts.Name)
+		return
+	}
+	c := newClient()
+	status, _ := c.create(kind, ns, body, opts.DryRun)
+	if status >= 400 {
+		apiError(status, "create failed")
+	}
+	suffix := ""
+	if opts.DryRun == "server" {
+		suffix = " (dry run)"
+	}
+	fmt.Printf("%s/%s created%s\n", rlabel, opts.Name, suffix)
+}
