+func commaSplit(entries []string) []string {
+	out := []string{}
+	for _, e := range entries {
+		for _, p := range strings.Split(e, ",") {
+			p = strings.TrimSpace(p)
+			if p != "" {
+				out = append(out, p)
+			}
+		}
+	}
+	return out
+}
