+			path = fl[idx+1:]
+		} else {
+			k = filepath.Base(path)
+		}
+		content, err := os.ReadFile(path)
+		if err == nil {
+			data[k] = string(content)
+		}
+	}
+	body := map[string]any{
+		"apiVersion": "v1",
+		"kind":       "ConfigMap",
+		"metadata":   map[string]any{"name": opts.Name},
+		"data":       data,
