+func doDelete(args []string) {
+	spec := newFlagSpec()
+	spec.value("filename", "namespace", "selector", "grace-period")
+	spec.bool_("all", "force", "now", "wait", "ignore-not-found", "all-namespaces")
+	spec.alias("f", "filename")
+	spec.alias("n", "namespace")
+	spec.alias("l", "selector")
+	spec.alias("A", "all-namespaces")
+	pos, flags, _ := spec.parse(args)
+	c := newClient()
+	if path := flags["filename"]; path != "" {
+		for _, m := range loadManifests(path) {
+			kind := manifestKind(m)
+			name := manifestName(m)
+			info, _ := resolveResource(kind)
+			ns := ""
+			if info.Namespaced {
+				ns = manifestNS(m, flags["namespace"])
+			}
+			status, body := c.delete_(kind, ns, name)
+			if status == 404 && flags["ignore-not-found"] == "true" {
+				continue
+			}
+			if status >= 400 {
+				apiError(status, extractMsg(body))
+			}
+			fmt.Printf("%s %q deleted\n", strings.ToLower(kind), name)
+		}
+		return
+	}
+	if len(pos) < 1 {
+		generalError("You must provide one or more resources")
+	}
+	rtype := pos[0]
+	kind := resolveKind(rtype)
+	if _, ok := resolveResource(kind); !ok {
+		generalError(fmt.Sprintf("the server doesn't have a resource type %q: NotFound", rtype))
+	}
+	names := pos[1:]
+	sel := flags["selector"]
+	if sel != "" || flags["all"] == "true" {
+		list := c.list(kind, flags["namespace"], flags["all-namespaces"] == "true", sel)
+		items, _ := list["items"].([]any)
+		for _, it := range items {
+			m, _ := it.(map[string]any)
+			name := manifestName(m)
+			ns := manifestNS(m, flags["namespace"])
+			status, body := c.delete_(kind, ns, name)
+			if status == 404 && flags["ignore-not-found"] == "true" {
+				continue
+			}
+			if status >= 400 {
+				apiError(status, extractMsg(body))
+			}
+			fmt.Printf("%s %q deleted\n", strings.ToLower(kind), name)
+		}
+		return
+	}
+	for _, name := range names {
+		status, body := c.delete_(kind, flags["namespace"], name)
+		if status == 404 && flags["ignore-not-found"] == "true" {
+			continue
+		}
+		if status >= 400 {
+			apiError(status, extractMsg(body))
+		}
+		fmt.Printf("%s %q deleted\n", strings.ToLower(kind), name)
+	}
+}
