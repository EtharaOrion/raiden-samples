+
+func resolveKind(t string) string {
+	lc := strings.ToLower(t)
+	if k, ok := kindAliases[lc]; ok {
+		return k
+	}
+	if t == "" {
+		return ""
+	}
+	return strings.ToUpper(t[:1]) + t[1:]
+}
+
+func resolveResource(kind string) (kindInfo, bool) {
+	info, ok := kindTable[kind]
+	return info, ok
+}
+
+func resourcePrefix(kind string) string {
+	info, ok := kindTable[kind]
+	if !ok {
+		return strings.ToLower(kind)
+	}
+	if info.Group == "" {
+		return strings.ToLower(kind)
+	}
+	return strings.ToLower(kind) + "." + info.Group
+}
+
+func kindPluralLower(kind string) string {
+	if info, ok := kindTable[kind]; ok {
+		return info.Plural
+	}
+	return strings.ToLower(kind) + "s"
+}
+
+func apiError(status int, msg string) {
+	reason := "Error"
+	switch status {
+	case 404:
+		reason = "NotFound"
+	case 409:
+		reason = "AlreadyExists"
+	case 422:
+		reason = "Invalid"
+	case 403:
+		reason = "Forbidden"
+	case 408:
+		reason = "Timeout"
+	case 400:
+		reason = "BadRequest"
+	case 500:
+		reason = "InternalError"
+	case 401:
+		reason = "Unauthorized"
+	case 503:
+		reason = "ServiceUnavailable"
+	}
+	fmt.Fprintf(os.Stderr, "Error from server (%s): %s (%d)\n", reason, msg, status)
+	os.Exit(1)
+}
