+ENDPOINT = os.environ.get("AWS_ENDPOINT_URL_KMS") or os.environ.get("AWS_ENDPOINT_URL") or "http://localhost:4566"
+
+ERR_USAGE = 252
+ERR_SERVICE = 254
+ERR_INTERNAL = 255
+
+GLOBAL_VALUE_FLAGS = {
+    "--output", "--region", "--profile", "--endpoint-url", "--color",
+    "--cli-read-timeout", "--cli-connect-timeout", "--query", "--ca-bundle",
+    "--cli-binary-format",
+}
+GLOBAL_BOOL_FLAGS = {
+    "--no-verify-ssl", "--no-paginate", "--debug", "--no-cli-pager",
+    "--no-sign-request",
+}
+
+
+def eprint(s):
+    sys.stderr.write(s + "\n")
+
+
+def call(op, payload):
+    url = ENDPOINT.rstrip("/") + "/"
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(url, data=data, method="POST")
+    req.add_header("X-Amz-Target", "TrentService." + op)
+    req.add_header("Content-Type", "application/x-amz-json-1.1")
+    req.add_header(
+        "Authorization",
+        "AWS4-HMAC-SHA256 Credential=dummy/20260101/us-east-1/kms/aws4_request, "
+        "SignedHeaders=host;x-amz-date, Signature=dummy",
+    )
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        if body.strip():
+            return 0, json.loads(body)
+        return 0, {}
+    except urllib.error.HTTPError as e:
+        body = e.read().decode("utf-8")
+        try:
+            j = json.loads(body)
+        except Exception:
+            j = {"__type": "UnknownError", "message": body}
+        return ERR_SERVICE, j
+    except Exception as e:
+        return ERR_INTERNAL, {"__type": "InternalError", "message": str(e)}
+
+
+def call_paginated(op, payload, result_key):
+    """Auto-paginate a list operation, aggregating result_key entries."""
+    aggregated = []
+    base = dict(payload)
+    # If the user supplied Limit or Marker, don't auto-paginate.
+    user_marker = "Marker" in base
+    first_resp = None
+    marker = base.get("Marker")
+    while True:
+        p = dict(base)
+        if marker is not None:
+            p["Marker"] = marker
+        elif "Marker" in p:
+            del p["Marker"]
+        code, resp = call(op, p)
+        if code != 0:
+            return code, resp
+        if first_resp is None:
+            first_resp = resp
+        aggregated.extend(resp.get(result_key, []))
+        next_marker = resp.get("NextMarker")
+        truncated = resp.get("Truncated")
+        # Stop if user explicitly paginated, or no more pages.
+        if user_marker:
+            break
+        if truncated and next_marker:
+            marker = next_marker
+            continue
+        break
+    out = dict(first_resp)
+    out[result_key] = aggregated
+    if not user_marker:
+        out["Truncated"] = False
+        out.pop("NextMarker", None)
+    return 0, out
+
+
+def usage_error(msg):
+    eprint(msg)
+    sys.exit(ERR_USAGE)
+
+
+def resolve_blob(val):
+    if val.startswith("fileb://"):
+        path = val[len("fileb://"):]
+        with open(path, "rb") as f:
+            raw = f.read()
+        return base64.b64encode(raw).decode("ascii")
+    if val.startswith("file://"):
+        path = val[len("file://"):]
+        with open(path, "r") as f:
+            return f.read().strip()
+    return val
+
+
+def resolve_text_from_file(val):
+    if val.startswith("file://"):
+        path = val[len("file://"):]
+        with open(path, "r") as f:
+            return f.read()
+    return val
+
+
+class Parser:
+    def __init__(self, argv):
+        self.argv = argv
+
+    def parse(self, spec):
+        result = {}
+        seen = set()
+        argv = self.argv
+        i = 0
+        n = len(argv)
+        while i < n:
+            tok = argv[i]
+            if not tok.startswith("--"):
+                usage_error("Unknown argument: " + tok)
+            if tok in GLOBAL_BOOL_FLAGS:
+                i += 1
+                continue
+            if tok in GLOBAL_VALUE_FLAGS:
+                i += 2
+                continue
+            eqval = None
+            base = tok
+            if "=" in tok:
+                base, eqval = tok.split("=", 1)
+            if base not in spec:
+                usage_error("Unknown options: " + tok)
+            param, typ = spec[base]
+            if base in seen:
+                usage_error("Duplicate flag: " + base)
+            seen.add(base)
+            if typ == "flag":
+                result[param] = True
+                i += 1
+                continue
+            if eqval is not None:
+                val = eqval
+                i += 1
+            else:
+                if i + 1 >= n:
+                    usage_error("Missing value for " + base)
+                val = argv[i + 1]
+                i += 2
+            if typ == "int":
+                try:
+                    result[param] = int(val)
+                except ValueError:
+                    usage_error("Invalid int for " + base)
+            elif typ == "blob":
+                try:
+                    result[param] = resolve_blob(val)
+                except OSError as e:
+                    eprint(str(e))
+                    sys.exit(ERR_INTERNAL)
+            else:
+                result[param] = val
+        return result
+
