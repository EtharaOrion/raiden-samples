+def print_json(obj):
+    sys.stdout.write(json.dumps(obj, indent=4) + "\n")
+
+
+def finish(code, resp, empty_ok=False):
+    if code == 0:
+        if resp:
+            print_json(resp)
+        sys.exit(0)
+    eprint(json.dumps(resp))
+    sys.exit(code)
+
