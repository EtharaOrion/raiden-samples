+def parse_tags(val):
+    val = val.strip()
+    if val.startswith("["):
+        return json.loads(val)
+    tags = []
+    for item in val.split():
+        d = {}
+        for part in item.split(","):
+            if "=" in part:
+                k, v = part.split("=", 1)
+                d[k] = v
+        tags.append(d)
+    return tags
+
