+        m = parsed["Marker"]
+        if m is None or m == "":
+            eprint(json.dumps({
+                "__type": "ValidationException",
+                "message": "Invalid Marker: marker must not be empty",
+            }))
+            sys.exit(ERR_SERVICE)
