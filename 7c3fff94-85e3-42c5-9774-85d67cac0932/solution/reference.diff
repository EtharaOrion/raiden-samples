+def _isofix(o):
+    """Serialise AWS timestamp fields as ISO8601 strings, matching aws-cli v2."""
+    if isinstance(o, dict):
+        r = {}
+        for k, v in o.items():
+            if (k in _QC_TS_FIELDS and isinstance(v, (int, float))
+                    and not isinstance(v, bool)):
+                r[k] = _qc_dt.datetime.fromtimestamp(
+                    v, _qc_dt.timezone.utc).isoformat()
+            else:
+                r[k] = _isofix(v)
+        return r
+    if isinstance(o, list):
+        return [_isofix(x) for x in o]
+    return o
