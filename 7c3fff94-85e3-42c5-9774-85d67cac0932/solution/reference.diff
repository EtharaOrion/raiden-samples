+def read_blob(val):
+    # Handle fileb:// and file:// by reading and base64-encoding contents.
+    import base64
+    if val.startswith("fileb://"):
+        path = val[len("fileb://"):]
+        with open(path, "rb") as f:
+            return base64.b64encode(f.read()).decode("ascii")
+    if val.startswith("file://"):
+        path = val[len("file://"):]
+        with open(path, "rb") as f:
+            return base64.b64encode(f.read()).decode("ascii")
+    return val
+
+
+def read_str_arg(val):
+    if val.startswith("file://"):
+        path = val[len("file://"):]
+        with open(path, "r") as f:
+            return f.read()
+    return val
+
+
+def parse_tags(val):
+    val = read_str_arg(val).strip()
+    if val.startswith("["):
+        return json.loads(val)
+    tags = []
+    for chunk in val.split():
+        d = {}
+        for part in chunk.split(","):
+            if "=" in part:
+                k, v = part.split("=", 1)
+                d[k] = v
+        if d:
+            tags.append(d)
+    return tags
+
+
+def parse_list(val):
+    val = read_str_arg(val).strip()
+    if val.startswith("["):
+        return json.loads(val)
+    return val.split(",")
+
