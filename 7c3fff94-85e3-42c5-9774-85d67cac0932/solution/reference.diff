+def _list_keys_all(params):
+    """aws-cli auto-paginates ListKeys when no explicit paging args are given."""
+    keys = []
+    marker = None
+    while True:
+        q = dict(params)
+        if marker:
+            q["Marker"] = marker
+        code, raw = call("ListKeys", q)
+        if code != 0 or raw is None:
+            return code, raw
+        try:
+            page = json.loads(raw)
+        except Exception:
+            return code, raw
+        keys.extend(page.get("Keys") or [])
+        if page.get("Truncated") and page.get("NextMarker"):
+            marker = page["NextMarker"]
+            continue
+        merged = dict(page)
+        merged["Keys"] = keys
+        merged["Truncated"] = False
+        merged.pop("NextMarker", None)
+        return 0, json.dumps(merged)
+
