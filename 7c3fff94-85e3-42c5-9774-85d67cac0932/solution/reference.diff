+def parse_cmd(argv, spec, required):
+    """spec: flag -> (jsonkey, kind). kind: str,int,blob,tags,tagkeys.
+       Returns params dict. Handles unknown flags, empty-value validation, required flags."""
+    result = {}
+    provided = set()
+    i = 0
+    while i < len(argv):
+        a = argv[i]
+        if not a.startswith("--"):
+            usage_error("Unknown options: %s" % a)
+        if a in spec:
+            jsonkey, kind = spec[a]
+            if i + 1 >= len(argv):
+                usage_error("argument %s: expected one argument" % a)
+            val = argv[i + 1]
+            provided.add(a)
+            try:
+                if kind == "int":
+                    try:
+                        result[jsonkey] = int(val)
+                    except ValueError:
+                        usage_error("Parameter validation failed: Invalid value for %s" % a)
+                elif kind == "blob":
+                    result[jsonkey] = read_blob(val)
+                elif kind == "tags":
+                    result[jsonkey] = parse_tags(val)
+                elif kind == "tagkeys":
+                    result[jsonkey] = parse_list(val)
+                elif kind == "str":
+                    result[jsonkey] = read_str_arg(val)
+                else:
+                    result[jsonkey] = val
+            except (OSError, ValueError) as e:
+                eprint(str(e))
+                sys.exit(255)
+            i += 2
+        elif a in GLOBAL_IGNORE_VALUE:
+            i += 2
+        elif a in GLOBAL_IGNORE_NOVALUE:
+            i += 1
+        else:
+            usage_error("Unknown options: %s" % a)
+    for r in required:
+        if r not in provided:
+            usage_error("the following arguments are required: %s" % r)
+    return result, provided
+
