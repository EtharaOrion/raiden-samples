+def emit(code, raw):
+    if code == 0:
+        if raw is not None and raw.strip():
+            try:
+                obj = json.loads(raw)
+                print(json.dumps(_isofix(obj), indent=4))
+            except Exception:
+                pass
+        sys.exit(0)
+    else:
+        if raw is not None:
+            eprint(raw)
+        sys.exit(code)
+
+
+def emit_empty(code, raw):
+    if code == 0:
+        sys.exit(0)
+    else:
+        if raw is not None:
+            eprint(raw)
+        sys.exit(code)
