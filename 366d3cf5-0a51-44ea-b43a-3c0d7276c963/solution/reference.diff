+import sys
+import os
+import json
+import base64
+import urllib.request
+import urllib.error
+
+
+def endpoint():
+    return os.environ.get("AWS_ENDPOINT_URL_DYNAMODB") or os.environ["AWS_ENDPOINT_URL"]
+
+
+def call(op, payload):
+    url = endpoint()
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(url, data=data, method="POST")
+    req.add_header("Content-Type", "application/x-amz-json-1.0")
+    req.add_header("X-Amz-Target", "DynamoDB_20120810." + op)
+    req.add_header("Authorization",
+                   "AWS4-HMAC-SHA256 Credential=dummy/20120810/us-east-1/dynamodb/aws4_request, "
+                   "SignedHeaders=content-type;host;x-amz-target, Signature=dummy")
+    req.add_header("Host", "localhost")
+    try:
+        resp = urllib.request.urlopen(req)
+        body = resp.read().decode("utf-8")
+        if body:
+            return json.loads(body)
+        return {}
+    except urllib.error.HTTPError as e:
+        body = e.read().decode("utf-8")
+        try:
+            err = json.loads(body)
+        except Exception:
+            err = {}
+        code = err.get("__type", "UnknownError")
+        if "#" in code:
+            code = code.split("#", 1)[1]
+        msg = err.get("message") or err.get("Message") or ""
+        sys.stderr.write("\nAn error occurred (%s): %s\n" % (code, msg))
+        sys.exit(254)
+
+
+def usage_error(msg):
+    sys.stderr.write("usage error: %s\n" % msg)
+    sys.exit(252)
+
+
+# Flag definitions per subcommand: flag -> (field, kind)
+# kind: "str", "json", "list-json", "attr-defs", "key-schema", "prov", "on-demand", "bool"
+FLAGS = {
+    "delete-table": {
+        "--table-name": ("TableName", "str"),
+    },
+    "delete-item": {
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--key": ("Key", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "put-item": {
+        "--condition-expression": ("ConditionExpression", "str"),
+        "--conditional-operator": ("ConditionalOperator", "str"),
+        "--expected": ("Expected", "json"),
+        "--expression-attribute-names": ("ExpressionAttributeNames", "json"),
+        "--expression-attribute-values": ("ExpressionAttributeValues", "json"),
+        "--item": ("Item", "json"),
+        "--return-consumed-capacity": ("ReturnConsumedCapacity", "str"),
+        "--return-item-collection-metrics": ("ReturnItemCollectionMetrics", "str"),
+        "--return-values": ("ReturnValues", "str"),
+        "--return-values-on-condition-check-failure": ("ReturnValuesOnConditionCheckFailure", "str"),
+        "--table-name": ("TableName", "str"),
+    },
+    "create-table": {
+        "--attribute-definitions": ("AttributeDefinitions", "attr-defs"),
+        "--billing-mode": ("BillingMode", "str"),
+        "--deletion-protection-enabled": ("DeletionProtectionEnabled", "bool"),
+        "--global-secondary-indexes": ("GlobalSecondaryIndexes", "json"),
+        "--global-table-settings-replication-mode": ("GlobalTableSettingsReplicationMode", "str"),
+        "--global-table-source-arn": ("GlobalTableSourceArn", "str"),
+        "--key-schema": ("KeySchema", "key-schema"),
+        "--local-secondary-indexes": ("LocalSecondaryIndexes", "json"),
+        "--on-demand-throughput": ("OnDemandThroughput", "on-demand"),
+        "--provisioned-throughput": ("ProvisionedThroughput", "prov"),
+        "--resource-policy": ("ResourcePolicy", "str"),
+        "--sse-specification": ("SSESpecification", "json"),
+        "--stream-specification": ("StreamSpecification", "json"),
+        "--table-class": ("TableClass", "str"),
+        "--table-name": ("TableName", "str"),
+        "--tags": ("Tags", "json"),
+        "--warm-throughput": ("WarmThroughput", "json"),
+    },
+}
+
+# flags that consume no value (booleans that can appear alone) - but botocore bools take value
+BOOL_FLAGS = set()
+
+
+def parse_shorthand_list(values):
+    # each value is like Key=Val,Key2=Val2 ; returns list of dicts
+    result = []
+    for v in values:
+        d = {}
+        for pair in v.split(","):
+            if "=" not in pair:
+                usage_error("invalid shorthand: %s" % pair)
+            k, val = pair.split("=", 1)
+            d[k] = val
+        result.append(d)
+    return result
+
+
+def build_attr_defs(values):
+    out = []
+    for d in parse_shorthand_list(values):
+        out.append({"AttributeName": d.get("AttributeName"),
+                    "AttributeType": d.get("AttributeType")})
+    return out
+
+
+def build_key_schema(values):
+    out = []
+    for d in parse_shorthand_list(values):
+        out.append({"AttributeName": d.get("AttributeName"),
+                    "KeyType": d.get("KeyType")})
+    return out
+
+
+def build_prov(values):
+    d = parse_shorthand_list(values)[0]
+    out = {}
+    if "ReadCapacityUnits" in d:
+        out["ReadCapacityUnits"] = int(d["ReadCapacityUnits"])
+    if "WriteCapacityUnits" in d:
+        out["WriteCapacityUnits"] = int(d["WriteCapacityUnits"])
+    return out
+
+
+def build_on_demand(values):
+    d = parse_shorthand_list(values)[0]
+    out = {}
+    for k, v in d.items():
+        out[k] = int(v)
+    return out
+
+
+def parse_args(sub, argv):
+    spec = FLAGS[sub]
+    # gather flag -> list of raw values (support multi-value shorthand lists)
+    # We iterate tokens.
+    seen = set()
+    raw = {}
+    i = 0
+    n = len(argv)
+    while i < n:
+        tok = argv[i]
+        if not tok.startswith("--"):
+            usage_error("unexpected argument: %s" % tok)
+        if tok not in spec:
+            usage_error("unknown flag: %s" % tok)
+        field, kind = spec[tok]
+        if tok in seen:
+            usage_error("duplicate flag: %s" % tok)
+        seen.add(tok)
+        i += 1
+        # collect values until next --flag
+        vals = []
+        while i < n and not argv[i].startswith("--"):
+            vals.append(argv[i])
+            i += 1
+        if not vals:
+            usage_error("flag %s requires a value" % tok)
+        raw[tok] = (field, kind, vals)
+    return raw
+
+
+def marshal(raw):
+    payload = {}
+    for tok, (field, kind, vals) in raw.items():
+        if kind == "str":
+            payload[field] = vals[0]
+        elif kind == "bool":
+            payload[field] = vals[0].lower() in ("true", "1", "yes")
+        elif kind == "json":
+            try:
+                payload[field] = json.loads(vals[0])
+            except Exception:
+                usage_error("invalid JSON for %s" % tok)
+        elif kind == "attr-defs":
+            if vals and vals[0].strip().startswith(("{", "[")):
+                try:
+                    payload[field] = json.loads(vals[0])
+                except Exception:
+                    usage_error("invalid JSON for %s" % tok)
+            else:
+                payload[field] = build_attr_defs(vals)
+        elif kind == "key-schema":
+            if vals and vals[0].strip().startswith(("{", "[")):
+                try:
+                    payload[field] = json.loads(vals[0])
+                except Exception:
+                    usage_error("invalid JSON for %s" % tok)
+            else:
+                payload[field] = build_key_schema(vals)
+        elif kind == "prov":
+            if vals and vals[0].strip().startswith("{"):
+                try:
+                    payload[field] = json.loads(vals[0])
+                except Exception:
+                    usage_error("invalid JSON for %s" % tok)
+            else:
+                payload[field] = build_prov(vals)
+        elif kind == "on-demand":
+            if vals and vals[0].strip().startswith("{"):
+                try:
+                    payload[field] = json.loads(vals[0])
+                except Exception:
+                    usage_error("invalid JSON for %s" % tok)
+            else:
+                payload[field] = build_on_demand(vals)
+    return payload
+
+
+def require(payload, field, tok):
+    if field not in payload:
+        usage_error("missing required flag: %s" % tok)
+
+
+def main():
+    if len(sys.argv) < 3:
+        usage_error("not enough arguments")
+    sub = sys.argv[2]
+    argv = sys.argv[3:]
+
+    if sub not in FLAGS:
+        usage_error("unknown command: %s" % sub)
+
+    raw = parse_args(sub, argv)
+    payload = marshal(raw)
+
+    if sub == "delete-table":
+        require(payload, "TableName", "--table-name")
+        result = call("DeleteTable", payload)
+    elif sub == "delete-item":
+        require(payload, "TableName", "--table-name")
+        require(payload, "Key", "--key")
+        result = call("DeleteItem", payload)
+    elif sub == "put-item":
+        require(payload, "TableName", "--table-name")
+        require(payload, "Item", "--item")
+        result = call("PutItem", payload)
+    elif sub == "create-table":
+        require(payload, "TableName", "--table-name")
+        if "AttributeDefinitions" not in payload:
+            payload["AttributeDefinitions"] = [
+                {"AttributeName": "id", "AttributeType": "S"}]
+        if "KeySchema" not in payload:
+            payload["KeySchema"] = [{"AttributeName": "id", "KeyType": "HASH"}]
+        if "BillingMode" not in payload and "ProvisionedThroughput" not in payload:
+            payload["BillingMode"] = "PAY_PER_REQUEST"
+        result = call("CreateTable", payload)
+    else:
+        usage_error("unknown command: %s" % sub)
+
+    if result:
+        sys.stdout.write(json.dumps(result, indent=4, default=str) + "\n")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
